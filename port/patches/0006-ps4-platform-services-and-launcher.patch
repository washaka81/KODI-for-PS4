diff --git a/xbmc/interfaces/python/XBPython.cpp b/xbmc/interfaces/python/XBPython.cpp
index 21af8ccece..24cd0104ca 100644
--- a/xbmc/interfaces/python/XBPython.cpp
+++ b/xbmc/interfaces/python/XBPython.cpp
@@ -45,6 +45,7 @@ XBPython::XBPython()
 #if defined(TARGET_DARWIN) || defined(TARGET_LINUX)
   setenv("PYTHONOPTIMIZE", "1", 1);
 #endif
+
   // Info about interesting python envvars available
   // at http://docs.python.org/using/cmdline.html#environment-variables
 
@@ -62,6 +63,25 @@ XBPython::XBPython()
   }
 #endif
 
+#if defined(__ORBIS__)
+  // CPython is linked statically.  Its getpath() cannot find a host prefix
+  // inside the PS4 sandbox, so point it at the stdlib shipped in the PKG.
+  const auto pythonRootPath =
+      CSpecialProtocol::TranslatePath("special://xbmc/system/python");
+  const auto pythonLibPath = pythonRootPath + "/lib/python3.14";
+  const auto caBundle =
+      CSpecialProtocol::TranslatePath("special://xbmc/system/certs/cacert.pem");
+  setenv("PYTHONHOME", pythonRootPath.c_str(), 1);
+  setenv("PYTHONPATH", pythonLibPath.c_str(), 1);
+  // Python's ssl module uses OpenSSL's default paths, which do not exist in
+  // the PS4 sandbox.  Point it at the same bundle libcurl already uses.
+  setenv("SSL_CERT_FILE", caBundle.c_str(), 1);
+  setenv("REQUESTS_CA_BUNDLE", caBundle.c_str(), 1);
+  setenv("CURL_CA_BUNDLE", caBundle.c_str(), 1);
+  CLog::Log(LOGINFO, "PS4 python: PYTHONHOME={} PYTHONPATH={} CA={}", pythonRootPath,
+            pythonLibPath, caBundle);
+#endif
+
   // *::GlobalInitializeModules() functions call PyImport_ExtendInittab(). PyImport_ExtendInittab() should
   // be called before Py_Initialize() as required by the Python documentation.
   CAddonPythonInvoker::GlobalInitializeModules();
@@ -70,7 +90,84 @@ XBPython::XBPython()
   CHTTPPythonWsgiInvoker::GlobalInitializeModules();
 #endif
 
+#if defined(__ORBIS__)
+  // Keep CPython away from the host locale, stdio and signal handlers.  The
+  // Orbis libc has partial locale/signal support and the default
+  // Py_Initialize() path can fault during pre-configuration.
+  /* Python 3.14 uses mimalloc by default; its arena reservations put extra
+   * pressure on the PS4 flexible-memory budget.  Use the libc allocator so
+   * Python shares Kodi's accounting and does not reserve large arenas. */
+  setenv("PYTHONMALLOC", "malloc", 1);
+
+  PyPreConfig preConfig;
+  PyPreConfig_InitPythonConfig(&preConfig);
+  preConfig.configure_locale = 0;
+  preConfig.utf8_mode = 1;
+  PyStatus status = Py_PreInitialize(&preConfig);
+  if (PyStatus_Exception(status))
+  {
+    char msg[512];
+    snprintf(msg, sizeof(msg), "python-preinit-fail:%s",
+             status.err_msg ? status.err_msg : "unknown");
+    CLog::Log(LOGFATAL, "PS4 python: preinit failed: {}",
+              status.err_msg ? status.err_msg : "unknown");
+    m_bindingModulesLoaded = false;
+    return;
+  }
+
+  PyConfig config;
+  PyConfig_InitPythonConfig(&config);
+  config.parse_argv = 0;
+  config.install_signal_handlers = 0;
+  config.configure_c_stdio = 0;
+  /* Let CPython cache .pyc for add-ons installed in the writable profile.
+   * System add-ons under /app0 are read-only and simply skip the write;
+   * cached bytecode removes parse/compile time from every plugin start. */
+  config.write_bytecode = 1;
+
+  // getpath must not depend on argv[0] or the current directory: the PS4
+  // sandbox can start Kodi with an unusable cwd, and a getcwd() failure
+  // makes Py_InitializeFromConfig fail with "error evaluating path".
+  const std::string appExecutable = "/app0/eboot.bin";
+  const auto setConfigString = [&](const char* name, wchar_t** field,
+                                   const std::string& value) {
+    PyStatus s = PyConfig_SetBytesString(&config, field, value.c_str());
+    if (PyStatus_Exception(s))
+    {
+      char msg[512];
+      snprintf(msg, sizeof(msg), "python-config-fail:%s:%s", name,
+               s.err_msg ? s.err_msg : "unknown");
+      CLog::Log(LOGFATAL, "PS4 python: config {} failed: {}", name,
+                s.err_msg ? s.err_msg : "unknown");
+      return false;
+    }
+    return true;
+  };
+  if (!setConfigString("home", &config.home, pythonRootPath) ||
+      !setConfigString("program_name", &config.program_name, appExecutable) ||
+      !setConfigString("executable", &config.executable, appExecutable) ||
+      !setConfigString("base_executable", &config.base_executable, appExecutable))
+  {
+    PyConfig_Clear(&config);
+    m_bindingModulesLoaded = false;
+    return;
+  }
+
+  status = Py_InitializeFromConfig(&config);
+  PyConfig_Clear(&config);
+  if (PyStatus_Exception(status))
+  {
+    char msg[512];
+    snprintf(msg, sizeof(msg), "python-init-fail:%s",
+             status.err_msg ? status.err_msg : "unknown");
+    CLog::Log(LOGFATAL, "PS4 python: init failed: {}",
+              status.err_msg ? status.err_msg : "unknown");
+    m_bindingModulesLoaded = false;
+    return;
+  }
+#else
   Py_Initialize();
+#endif
 
   // a module adopts types shared with the others only on its first init, so
   // init them together here rather than in whichever sub-interpreter a script
