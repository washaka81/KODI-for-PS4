+  uint64_t storageDataTotalMB{0};
+  int storageDataRc{0};
+  uint64_t storageApp0FreeMB{0};
+  uint64_t storageApp0TotalMB{0};
+  int storageApp0Rc{0};
+  std::string cpuModel;
+  uint64_t cpuFreqMHz{0};
+  float cpuTempC{0.0f};
+  bool cpuTempValid{false};
+  std::string buildVersion;
+  std::string buildDate;
+  std::string model;
+  std::string firmware;
+  int language{0};
+
+  bool localeValid{false};
+  int dateFormat{1};
+  int timeFormat{1};
+  int timeZone{0};
+  int summerTime{0};
+  int tzOffsetMinutes{0};
+  int tzKernelMinutesWest{0};
+  int tzKernelDstMinutes{0};
+  std::string tzString;
+
+  bool videoValid{false};
+  bool videoCapsValid{false};
+  bool videoModeValid{false};
+  bool videoMonitorValid{false};
+  int videoCapsRc{0};
+  int videoModeRc{0};
+  int videoMonitorRc{0};
+  uint64_t videoShimCapabilities{0};
+  bool videoCapsBusValid{false};
+  int videoCapsBusRc{0};
+  uint32_t videoCapsBus{0xFFFFFFFF};
+  int videoModeSysRc{0};
+  int videoMonitorSysRc{0};
+  int videoWidth{1920};
+  int videoHeight{1080};
+  double refreshRate{59.94};
+  float safeArea{1.0f};
+  bool hdr10{false};
+  bool hdrAutomatic{false};
+  uint64_t videoCapabilities{0};
+  std::array<uint8_t, 0x180> hdmiMonitor{};
+  std::array<uint8_t, 0x20> outputMode{};
+
+  bool netValid{false};
+  bool netLink{false};
+  uint32_t netDevice{0};
+  uint32_t netMtu{0};
+  bool netWifi{false};
+  int32_t netDeviceRc{0};
+  int32_t netMtuRc{0};
+  std::string netSsid;
+  int netRssiDbm{0};
+  int netRssiPercentage{0};
+  int netChannel{0};
+  int netGatewayRc{0};
+  int netInternetRc{0};
+  int netDnsRc{0};
+  int netNonblockSocketRc{0};
+  std::string netMirrorIp;
+  std::string netInterface;
+  std::string netIp;
+  std::string netMask;
+  std::string netGateway;
+  std::string netDns1;
+  std::string netDns2;
+  std::string netMac;
+  int32_t netMacRc{0};
+  int32_t netMacFormatRc{0};
+};
+
+/*! \brief Probe CPU, memory, storage, firmware and network.
+ *
+ * Safe to call from CPlatformPs4::InitStageOne() after the network stack
+ * (sceNetInit) has been initialised.  Network probing is best-effort.
+ */
+void ProbeHardwareProfileEarly();
+
+/*! \brief Probe the current VideoOut mode and the HDMI/EDID monitor info.
+ *
+ * Must be called after the glshim display exists (the VideoOut handle is
+ * owned by the shim).  Read-only: it never changes the video mode.
+ */
+void ProbeHardwareProfileVideo();
+
+/*! \brief Log a one-line summary. */
+void LogHardwareProfile();
+
+/*! \brief Apply the console date/time formats to Kodi on first boot.
+ *
+ * Kodi's region setting controls its short/long date and 12/24-hour clock.
+ * The console language pack may not be bundled, so only the region is set.
+ */
+void ApplyConsoleLocaleSettings();
+
+/*! \brief Access the last probed profile (valid after the probes above). */
+const HardwareProfile& GetHardwareProfile();
+
+} // namespace KODI::PLATFORM::PS4
