diff --git a/xbmc/platform/posix/threads/RecursiveMutex.cpp b/xbmc/platform/posix/threads/RecursiveMutex.cpp
index 19a940e518..872346bb8d 100644
--- a/xbmc/platform/posix/threads/RecursiveMutex.cpp
+++ b/xbmc/platform/posix/threads/RecursiveMutex.cpp
@@ -8,23 +8,37 @@
 
 #include "RecursiveMutex.h"
 
+
 namespace XbmcThreads
 {
 
+namespace
+{
+// PS4's pthread_mutexattr_t is a pointer-sized handle, but the OpenOrbis
+// header declares it as a 4-byte struct.  Keep the full 8 bytes and
+// initialize it in place so the handle is not truncated by a by-value copy.
+struct RecursiveMutexAttrStorage
+{
+  alignas(8) unsigned char data[8];
+};
+} // namespace
+
 pthread_mutexattr_t& CRecursiveMutex::getRecursiveAttr()
 {
-  static pthread_mutexattr_t recursiveAttr = []()
+  static RecursiveMutexAttrStorage storage;
+  static const bool initialized = []()
   {
-    pthread_mutexattr_t recursiveAttr;
-    pthread_mutexattr_init(&recursiveAttr);
-    pthread_mutexattr_settype(&recursiveAttr, PTHREAD_MUTEX_RECURSIVE);
-#if !defined(TARGET_ANDROID)
-    pthread_mutexattr_setprotocol(&recursiveAttr, PTHREAD_PRIO_INHERIT);
+    auto* attr = reinterpret_cast<pthread_mutexattr_t*>(storage.data);
+    pthread_mutexattr_init(attr);
+    pthread_mutexattr_settype(attr, PTHREAD_MUTEX_RECURSIVE);
+#if !defined(TARGET_ANDROID) && !defined(TARGET_PS4)
+    pthread_mutexattr_setprotocol(attr, PTHREAD_PRIO_INHERIT);
 #endif
-    return recursiveAttr;
+    return true;
   }();
+  (void)initialized;
 
-  return recursiveAttr;
+  return *reinterpret_cast<pthread_mutexattr_t*>(storage.data);
 }
 
 } // namespace XbmcThreads
