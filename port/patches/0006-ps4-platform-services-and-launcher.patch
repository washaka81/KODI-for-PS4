+std::string GetPS4FirmwareVersion()
+{
+  static std::string version;
+  if (!version.empty())
+    return version;
+
+  OrbisKernelSwVersion sw = {};
+  sw.Size = sizeof(sw);
+  if (sceKernelGetSystemSwVersion(&sw) == 0)
+  {
+    std::string value(sw.VersionString, sizeof(sw.VersionString));
+    value = value.c_str(); // stop at the first NUL
+    const size_t first = value.find_first_not_of(" \t\r\n");
+    const size_t last = value.find_last_not_of(" \t\r\n");
+    if (first != std::string::npos)
+      version = value.substr(first, last - first + 1);
+  }
+
+  return version;
+}
