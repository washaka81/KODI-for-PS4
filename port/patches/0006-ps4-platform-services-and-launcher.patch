+
+/*! \brief Load and initialise the PS4 network stack.
+ *
+ * libcurl and the resolver use the BSD socket layer directly, but that layer
+ * is not usable until the NET sysmodule is loaded and sceNetInit() has run.
+ * Without this, the first socket()/getaddrinfo() call made by the repository
+ * or add-on manager aborts the process (CE-34878).
+ *
+ * The calls are best effort: GoldHEN or another plugin may have initialised
+ * the stack already, in which case the returned "already initialised" error
+ * is harmless and networking keeps working.
+ */
+void InitPS4NetworkStack()
+{
+  const uint32_t netModule = sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NET);
+  (void)netModule;
+
+  const int32_t netInit = sceNetInit();
+  CLog::Log(LOGINFO, "PS4 network: sceNetInit=0x{:08x}", static_cast<uint32_t>(netInit));
+
+  if (netInit == 0)
+  {
+    const int32_t netPool = sceNetPoolCreate("kodiNetPool", 4 * 1024, 0);
+    CLog::Log(LOGINFO, "PS4 network: sceNetPoolCreate=0x{:08x}",
+              static_cast<uint32_t>(netPool));
+  }
+
+  const uint32_t netCtlModule =
+      sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NETCTL);
+  (void)netCtlModule;
+
+  const int32_t netCtlInit = sceNetCtlInit();
+  CLog::Log(LOGINFO, "PS4 network: sceNetCtlInit=0x{:08x}",
+            static_cast<uint32_t>(netCtlInit));
+}
+
+} // namespace
+
+/* The Orbis SDK links musl, whose pthread default stack is only 128 KiB
+ * (default_attr.lo: __default_stacksize = 0x20000).  Kodi/FFmpeg threads are
+ * sized for desktop stacks and a 128 KiB stack overflows while parsing HLS or
+ * decoding video; the guard-page fault cannot run the signal handler.  Wrap
+ * pthread_create so every thread gets at least 2 MiB of stack.  Callers that
+ * explicitly set a larger size keep it; callers using a custom stack pointer
+ * are left untouched (pthread_attr_setstacksize fails and is ignored). */
+extern "C" int __real_pthread_create(pthread_t* thread, const pthread_attr_t* attr,
+                                     void* (*start)(void*), void* arg);
+
+extern "C" int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr,
+                                     void* (*start)(void*), void* arg)
+{
+  constexpr size_t kMinStackSize = 2 * 1024 * 1024;
+
+  pthread_attr_t tuned;
+  bool destroy = false;
+  if (attr)
+    tuned = *attr;
+  else
+  {
+    if (pthread_attr_init(&tuned) != 0)
+      return __real_pthread_create(thread, attr, start, arg);
+    destroy = true;
+  }
+
+  size_t stackSize = 0;
+  if (pthread_attr_getstacksize(&tuned, &stackSize) != 0 || stackSize < kMinStackSize)
+    (void)pthread_attr_setstacksize(&tuned, kMinStackSize);
+
+  const int result = __real_pthread_create(thread, &tuned, start, arg);
+  if (destroy)
+    pthread_attr_destroy(&tuned);
+  return result;
+}
+
+void PreparePS4Environment()
+{
+  // The PS4 does not set HOME, the Kodi profile is kept next to the
+  // application data.
+  if (!getenv("HOME"))
+    setenv("HOME", "/data/kodi-ps4", 1);
+
+  // The resources of the application (skins, system files) are shipped in
+  // the package and mounted read only.  Kodi looks for them before the
+  // platform is initialised, so the variable has to be set from main().
+  if (!getenv("KODI_HOME"))
+    setenv("KODI_HOME", "/app0/media/kodi", 1);
+
+  // curl keeps one multi handle per remote host; raise the soft limit so
+  // repository updates do not run out of descriptors.
+  struct rlimit fdLimit = {};
+  if (getrlimit(RLIMIT_NOFILE, &fdLimit) == 0 && fdLimit.rlim_cur < fdLimit.rlim_max)
+  {
+    fdLimit.rlim_cur = fdLimit.rlim_max;
+    setrlimit(RLIMIT_NOFILE, &fdLimit);
+  }
+}
+
+CPlatform* CPlatform::CreateInstance()
+{
+  return new CPlatformPs4();
+}
+
+bool CPlatformPs4::InitStageOne()
+{
+
+  PreparePS4Environment();
+
+  // Initialise the MIME table early, while memory is still available.
+  CMime::GetMimeType("jpg");
+
+  InitPS4NetworkStack();
+
+  KODI::PLATFORM::PS4::ProbeHardwareProfileEarly();
+
+  if (!CPlatformPosix::InitStageOne())
+  {
+    return false;
+  }
+
+  setenv("OS", "Linux", true); // for python scripts that check the OS
+
+#if defined(HAS_GLES)
+  KODI::WINDOWING::PS4::CWinSystemPs4GLES::Register();
+#endif
+
+  CLinuxPowerSyscall::Register();
+
+  std::string_view sink = CServiceBroker::GetAppParams()->GetAudioBackend();
+
+  if (sink == "ps4" || sink.empty())
+  {
+    // PS4 PCM audio goes through CAESinkPS4 (sceAudioOut) / CPadPS4 input;
+    // intentionally no ALSA, PulseAudio, OSS, or sndio registration here.
+    kodi::ps4::CAESinkPS4::Register();
+  }
+  else if (sink == "alsa")
+  {
+    OPTIONALS::ALSARegister();
+  }
+  else if (sink == "pulseaudio")
+  {
+    OPTIONALS::PulseAudioRegister(true);
+  }
+  else if (sink == "oss")
+  {
+    OPTIONALS::OSSRegister();
+  }
+  else if (sink == "sndio")
+  {
+    OPTIONALS::SndioRegister();
+  }
+  else if (sink == "alsa+pulseaudio")
+  {
+    OPTIONALS::ALSARegister();
+    OPTIONALS::PulseAudioRegister(true);
+  }
+  else
+  {
+    if (!OPTIONALS::PulseAudioRegister(false))
+    {
+      if (!OPTIONALS::ALSARegister())
+      {
+        if (!OPTIONALS::SndioRegister())
+        {
+          OPTIONALS::OSSRegister();
+        }
+      }
+    }
+  }
+
+  m_lirc.reset(OPTIONALS::LircRegister());
+
+  return true;
+}
