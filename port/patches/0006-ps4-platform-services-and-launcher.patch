+std::string HexDump(const uint8_t* data, size_t size)
+{
+  static const char* digits = "0123456789abcdef";
+  std::string out;
+  out.reserve(size * 2);
+  for (size_t i = 0; i < size; ++i)
+  {
+    out.push_back(digits[data[i] >> 4]);
+    out.push_back(digits[data[i] & 0x0f]);
+  }
+  return out;
+}
+
+int ConnectTest(const char* ip, int port, int timeoutMs)
+{
+  if (!ip || !ip[0])
+    return -EINVAL;
+
+  const int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0)
+    return -errno;
+
+  const int flags = fcntl(fd, F_GETFL, 0);
+  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(static_cast<uint16_t>(port));
+  if (inet_pton(AF_INET, ip, &addr.sin_addr) != 1)
+  {
+    close(fd);
+    return -EINVAL;
+  }
+
+  int rc = connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr));
+  if (rc < 0 && errno == EINPROGRESS)
+  {
+    pollfd pfd{fd, POLLOUT, 0};
+    rc = poll(&pfd, 1, timeoutMs);
+    if (rc > 0)
+    {
+      int err = 0;
+      socklen_t len = sizeof(err);
+      getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len);
+      rc = err ? -err : 0;
+    }
+    else
+    {
+      rc = rc == 0 ? -ETIMEDOUT : -errno;
+    }
+  }
+  else if (rc < 0)
+  {
+    rc = -errno;
+  }
+
+  close(fd);
+  return rc;
+}
+
+std::string ProfileDir()
+{
+  const char* home = getenv("HOME");
+  const std::string dir = home && home[0] ? home : "/data/kodi-ps4";
+  return dir + "/.kodi/userdata";
+}
+
+void ProbeConsoleTimezone()
+{
+  int32_t tz = 0;
+  int32_t dst = 0;
+  const int32_t tzRc =
+      sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_TIME_ZONE, &tz);
+  const int32_t dstRc =
+      sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_SUMMERTIME, &dst);
+  if (tzRc == 0)
+    g_profile.timeZone = tz;
+  if (dstRc == 0)
+    g_profile.summerTime = dst;
+
+  // The kernel reports the standard offset and the current DST correction
+  // separately; it is used as a fallback for the service parameters.
+  KernelTimezone kernel = {};
+  using GettimezoneFn = int32_t (*)(void*);
+  const auto gettimezone = reinterpret_cast<GettimezoneFn>(&sceKernelGettimezone);
+  const int32_t kernelRc = gettimezone(&kernel);
+  g_profile.tzKernelMinutesWest = kernel.minutesWest;
+  g_profile.tzKernelDstMinutes = kernel.dstMinutes;
+
+  bool haveOffset = false;
+  int offsetMinutes = 0;
+  const bool serviceOffsetValid =
+      tzRc == 0 && tz >= -14 * 60 && tz <= 14 * 60 && dstRc == 0 && (dst == 0 || dst == 1);
+  if (serviceOffsetValid)
+  {
+    // PARAM_ID_TIME_ZONE is the standard offset in minutes east of UTC and
+    // PARAM_ID_SUMMERTIME is the DST offset in hours.
+    offsetMinutes = tz + dst * 60;
+    haveOffset = true;
+  }
+  else if (kernelRc == 0 && kernel.minutesWest >= -14 * 60 &&
+           kernel.minutesWest <= 14 * 60 &&
+           (kernel.dstMinutes == 0 || kernel.dstMinutes == 60) &&
+           (kernel.minutesWest != 0 || kernel.dstMinutes != 0))
+  {
+    offsetMinutes = -kernel.minutesWest + kernel.dstMinutes;
+    haveOffset = true;
+  }
+
+  if (!haveOffset)
+    return;
+
+  g_profile.tzOffsetMinutes = offsetMinutes;
+  const int hours = offsetMinutes / 60;
+  int minutes = offsetMinutes % 60;
+  if (minutes < 0)
+    minutes = -minutes;
+
+  // POSIX TZ offsets are positive west of UTC, hence the inverted sign.
+  char buffer[32];
+  if (minutes == 0)
+    snprintf(buffer, sizeof(buffer), "UTC%+d", -hours);
+  else
+    snprintf(buffer, sizeof(buffer), "UTC%+d:%02d", -hours, minutes);
+
+  g_profile.tzString = buffer;
+  setenv("TZ", buffer, 1);
+  tzset();
+}
+
+void LogConsoleTime()
+{
+  const time_t now = time(nullptr);
+  struct tm localTime = {};
+  struct tm utcTime = {};
+  localtime_r(&now, &localTime);
+  gmtime_r(&now, &utcTime);
+
+  char localText[32] = {};
+  char utcText[32] = {};
+  strftime(localText, sizeof(localText), "%Y-%m-%d %H:%M:%S", &localTime);
+  strftime(utcText, sizeof(utcText), "%Y-%m-%d %H:%M:%S", &utcTime);
+
+  CLog::Log(LOGINFO,
+            "PS4 time: tz={} dst={} kernel={}minW/{}minD offset={}min TZ={} local={} utc={}",
+            g_profile.timeZone, g_profile.summerTime, g_profile.tzKernelMinutesWest,
+            g_profile.tzKernelDstMinutes, g_profile.tzOffsetMinutes, g_profile.tzString,
+            localText, utcText);
+}
+
+void ProbeNetwork()
+{
+  OrbisNetCtlInfo info{};
+  if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_LINK, &info) == 0)
+  {
+    g_profile.netLink = info.link != 0;
+    g_profile.netValid = true;
+  }
+
+  /* Orbis exposes the interface type, MTU and (on WLAN) SSID/RSSI through
+   * NetCtl.  Collect them on every start and log only the generic values.
+   * Device 0 is Ethernet; a non-zero value is treated as WLAN.  The socket
+   * tuning itself stays generic. */
+  OrbisNetCtlInfo deviceInfo{};
+  g_profile.netDeviceRc = sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_DEVICE, &deviceInfo);
+  if (g_profile.netDeviceRc == 0)
+  {
+    g_profile.netDevice = deviceInfo.device;
+    g_profile.netWifi = deviceInfo.device != 0;
+  }
+
+  OrbisNetCtlInfo mtuInfo{};
+  g_profile.netMtuRc = sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_MTU, &mtuInfo);
+  if (g_profile.netMtuRc == 0)
+    g_profile.netMtu = mtuInfo.mtu;
+
+  if (g_profile.netWifi)
+  {
+    OrbisNetCtlInfo wifiInfo{};
+    if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_SSID, &wifiInfo) == 0)
+    {
+      /* The union is fixed-size; stop at the first NUL so stale bytes after
+       * the SSID do not leak into the log/JSON.  Keep only printable ASCII
+       * and escape JSON-sensitive characters. */
+      char ssid[33] = {};
+      size_t length = 0;
+      while (length < sizeof(wifiInfo.ssid) && wifiInfo.ssid[length] != '\0')
+        ++length;
+      if (length >= sizeof(ssid))
+        length = sizeof(ssid) - 1;
+      memcpy(ssid, wifiInfo.ssid, length);
+      ssid[length] = '\0';
+      for (size_t i = 0; i < length; ++i)
+      {
+        const unsigned char c = static_cast<unsigned char>(ssid[i]);
+        if (c < 0x20 || c > 0x7e || ssid[i] == '"' || ssid[i] == '\\')
+          ssid[i] = '?';
+      }
+      g_profile.netSsid = ssid;
+    }
+    if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_RSSI_DBM, &wifiInfo) == 0)
+      g_profile.netRssiDbm = static_cast<int8_t>(wifiInfo.rssi_dbm);
+    if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_RSSI_PERCENTAGE, &wifiInfo) == 0)
+      g_profile.netRssiPercentage = wifiInfo.rssi_percentage;
+    if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_CHANNEL, &wifiInfo) == 0)
+      g_profile.netChannel = wifiInfo.channel;
+  }
+
+  g_profile.netInterface = g_profile.netWifi ? "wlan0" : "eth0";
+
+  if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_IP_ADDRESS, &info) == 0)
+    g_profile.netIp = info.ip_address;
+  if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_NETMASK, &info) == 0)
+    g_profile.netMask = info.netmask;
+  if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_DEFAULT_ROUTE, &info) == 0)
+    g_profile.netGateway = info.default_route;
+  if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_PRIMARY_DNS, &info) == 0)
+    g_profile.netDns1 = info.primary_dns;
+  if (sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_SECONDARY_DNS, &info) == 0)
+    g_profile.netDns2 = info.secondary_dns;
+
+  g_profile.netValid = true;
+
+  g_profile.netGatewayRc = ConnectTest(g_profile.netGateway.c_str(), 80, 1000);
+
+  errno = 0;
+#if defined(SOCK_NONBLOCK)
+  const int flagSocket = socket(AF_INET, SOCK_STREAM | SOCK_NONBLOCK, 0);
+  g_profile.netNonblockSocketRc = flagSocket >= 0 ? 0 : -errno;
+  if (flagSocket >= 0)
+    close(flagSocket);
+#endif
+
+  addrinfo hints = {};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* resolved = nullptr;
+  g_profile.netDnsRc = getaddrinfo("mirrors.kodi.tv", "443", &hints, &resolved);
+  if (g_profile.netDnsRc == 0 && resolved)
+  {
+    char ip[INET_ADDRSTRLEN] = {};
+    const auto* address = reinterpret_cast<const sockaddr_in*>(resolved->ai_addr);
+    if (inet_ntop(AF_INET, &address->sin_addr, ip, sizeof(ip)))
+      g_profile.netMirrorIp = ip;
+    g_profile.netInternetRc = ConnectTest(ip, 443, 2000);
+    freeaddrinfo(resolved);
+  }
+  else
+  {
+    g_profile.netInternetRc = -EAI_FAIL;
+  }
+
+  // NetCtl already provides link/IP; use its ETHER_ADDR entry first because
+  // sceNetGetMacAddress can fail before the NET sysmodule is fully ready.
+  unsigned char macBytes[6] = {};
+  bool haveMac = false;
+
+  OrbisNetCtlInfo macInfo{};
+  g_profile.netMacRc = sceNetCtlGetInfo(ORBIS_NET_CTL_INFO_ETHER_ADDR, &macInfo);
+  if (g_profile.netMacRc == 0)
+  {
+    memcpy(macBytes, macInfo.ether_addr, sizeof(macBytes));
+    haveMac = true;
+  }
+  else
+  {
+    OrbisNetEtherAddr ether = {};
+    g_profile.netMacRc = sceNetGetMacAddress(&ether, sizeof(ether));
+    if (g_profile.netMacRc == 0)
+    {
+      memcpy(macBytes, ether.data, sizeof(macBytes));
+      haveMac = true;
+    }
+  }
+
+  if (haveMac)
+  {
+    char mac[18] = {};
+    g_profile.netMacFormatRc = sceNetEtherNtostr(macBytes, mac, sizeof(mac));
+    if (g_profile.netMacFormatRc == 0)
+      g_profile.netMac = mac;
+  }
+}
+
+} // namespace
+
+namespace KODI::PLATFORM::PS4
+{
+
+void ProbeHardwareProfileEarly()
+{
+  g_profile = {};
+
+  // _SC_NPROCESSORS_ONLN is not reliable on Orbis; PS4 base and Pro both
+  // have eight Jaguar cores.
+  const long cores = sysconf(_SC_NPROCESSORS_ONLN);
+  g_profile.cpuCores = (cores > 0 && cores <= 64) ? static_cast<int>(cores) : 8;
+
+  const long pages = sysconf(_SC_PHYS_PAGES);
+  const long pageSize = sysconf(_SC_PAGESIZE);
+  if (pages > 0 && pageSize > 0)
+    g_profile.memoryTotalMB =
+        static_cast<uint64_t>(pages) * static_cast<uint64_t>(pageSize) / (1024 * 1024);
+
+  // sysconf(_SC_PHYS_PAGES) returns 0 on this firmware.  Fall back to the
+  // direct-memory budget that libkernel exposes to the application.
+  if (g_profile.memoryTotalMB == 0)
+    g_profile.memoryTotalMB = sceKernelGetDirectMemorySize() / (1024 * 1024);
+
+  const long availPages = sysconf(_SC_AVPHYS_PAGES);
+  if (availPages > 0 && pageSize > 0)
+    g_profile.memoryFreeMB =
+        static_cast<uint64_t>(availPages) * static_cast<uint64_t>(pageSize) / (1024 * 1024);
+
+  g_profile.memoryDirectTotalMB = sceKernelGetDirectMemorySize() / (1024 * 1024);
+  g_profile.memoryFlexibleFreeMB =
+      KODI::MEMORY::GetAvailableFlexibleMemorySize() / (1024 * 1024);
+  g_profile.memoryDirectFreeMB = KODI::MEMORY::GetAvailableDirectMemorySize() / (1024 * 1024);
+  g_profile.memoryRssKB = KODI::MEMORY::GetCurrentRssBytes() / 1024;
+  g_profile.memoryRssSource = g_profile.memoryRssKB > 0 ? "statm" : "none";
+  if (g_profile.memoryFreeMB == 0)
+    g_profile.memoryFreeMB = g_profile.memoryFlexibleFreeMB;
+
+  const auto probeStorage = [](const char* path, uint64_t& freeMB, uint64_t& totalMB, int& rc) {
+    struct statvfs vfs = {};
+    if (statvfs(path, &vfs) == 0)
+    {
+      totalMB = static_cast<uint64_t>(vfs.f_blocks) * vfs.f_frsize / (1024 * 1024);
+      freeMB = static_cast<uint64_t>(vfs.f_bavail) * vfs.f_frsize / (1024 * 1024);
+      rc = 0;
+    }
+    else
+    {
+      rc = -errno;
+    }
+  };
+  probeStorage("/user/data", g_profile.storageUserDataFreeMB,
+               g_profile.storageUserDataTotalMB, g_profile.storageUserDataRc);
+  probeStorage("/data", g_profile.storageDataFreeMB, g_profile.storageDataTotalMB,
+               g_profile.storageDataRc);
+  probeStorage("/app0", g_profile.storageApp0FreeMB, g_profile.storageApp0TotalMB,
+               g_profile.storageApp0Rc);
+  g_profile.storageFreeMB = std::max(g_profile.storageUserDataFreeMB,
+                                     std::max(g_profile.storageDataFreeMB,
+                                              g_profile.storageApp0FreeMB));
+
+  // Orbis no expone sysctlbyname("hw.model"); la CPU de PS4/Pro es Jaguar.
+  g_profile.cpuModel = "AMD Jaguar";
+
+  const int32_t cpuHz = sceKernelGetCpuFrequency();
+  if (cpuHz > 0)
+    g_profile.cpuFreqMHz = cpuHz > 1000000 ? cpuHz / 1000000 : cpuHz;
+
+  uint64_t cpuTemp = 0;
+  if (sceKernelGetCpuTemperature(&cpuTemp) == 0 && cpuTemp > 0)
+  {
+    g_profile.cpuTempC = cpuTemp > 200 ? static_cast<float>(cpuTemp) / 1000.0f
+                                       : static_cast<float>(cpuTemp);
+    g_profile.cpuTempValid = true;
+  }
+
+  g_profile.buildVersion = CCompileInfo::GetVersionCode();
+  g_profile.buildDate = CCompileInfo::GetBuildDate();
+
+  OrbisKernelSwVersion version = {};
+  if (sceKernelGetSystemSwVersion(&version) == 0)
+  {
+    g_profile.firmware.assign(version.VersionString,
+                              strnlen(version.VersionString, sizeof(version.VersionString)));
+  }
+
+  g_profile.neo = sceKernelIsNeoMode() != 0;
+  g_profile.model = g_profile.neo ? "pro" : "base/slim";
+  g_profile.cpuMode = sceKernelGetCpumode();
+
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_SYSTEM_SERVICE);
+  int32_t language = 0;
+  if (sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_LANG, &language) == 0)
+    g_profile.language = language;
+
+  int32_t value = 0;
+  if (sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_DATE_FORMAT, &value) == 0)
+  {
+    g_profile.dateFormat = value;
+    g_profile.localeValid = true;
+  }
+  if (sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_TIME_FORMAT, &value) == 0)
+  {
+    g_profile.timeFormat = value;
+    g_profile.localeValid = true;
+  }
+  ProbeConsoleTimezone();
+
+  ProbeNetwork();
+  g_profile.valid = true;
+
+  CLog::Log(LOGINFO,
+            "PS4 profile: model={} fw={} neo={} cpu={} mode={} mem={}MB free={}MB "
+            "storage={}MB lang={}",
+            g_profile.model, g_profile.firmware, g_profile.neo, g_profile.cpuCores,
+            g_profile.cpuMode, g_profile.memoryTotalMB, g_profile.memoryFreeMB,
+            g_profile.storageFreeMB, g_profile.language);
+  CLog::Log(LOGINFO,
+            "PS4 profile: cpu_model='{}' freq={}MHz temp={:.1f}C valid={} build={} ({})",
+            g_profile.cpuModel, g_profile.cpuFreqMHz, g_profile.cpuTempC,
+            g_profile.cpuTempValid, g_profile.buildVersion, g_profile.buildDate);
+  CLog::Log(LOGINFO,
+            "PS4 profile: mem direct={}MB direct_free={}MB flexible_free={}MB rss={}KB ({}) "
+            "storage user_free={}MB(rc={}) data_free={}MB(rc={}) app0_free={}MB(rc={})",
+            g_profile.memoryDirectTotalMB, g_profile.memoryDirectFreeMB,
+            g_profile.memoryFlexibleFreeMB, g_profile.memoryRssKB,
+            g_profile.memoryRssSource, g_profile.storageUserDataFreeMB,
+            g_profile.storageUserDataRc, g_profile.storageDataFreeMB, g_profile.storageDataRc,
+            g_profile.storageApp0FreeMB, g_profile.storageApp0Rc);
+  CLog::Log(LOGINFO,
+            "PS4 profile: net link={} wifi={} mtu={} (rc={}) rssi={}dBm/{}% ch={}",
+            g_profile.netLink, g_profile.netWifi, g_profile.netMtu, g_profile.netMtuRc,
+            g_profile.netRssiDbm, g_profile.netRssiPercentage, g_profile.netChannel);
+}
+
+void ProbeHardwareProfileVideo()
+{
+  const int handle = glShimGetVideoOutHandle();
+  if (handle <= 0)
+  {
+    CLog::Log(LOGWARNING, "PS4 profile: no VideoOut handle, video probe skipped");
+    return;
+  }
+
+  OrbisVideoOutResolutionStatus resolution = {};
+  if (sceVideoOutGetResolutionStatus(handle, &resolution) == 0)
+  {
+    g_profile.videoWidth = static_cast<int>(resolution.width);
+    g_profile.videoHeight = static_cast<int>(resolution.height);
+    // The PS4 VideoOut resolution status reports a refresh code, not Hz.
+    // Map the known codes and keep 59.94 as the safe renderer default.
+    switch (resolution.refreshRate)
+    {
+      case 0:
+        g_profile.refreshRate = 59.94;
+        break;
+      case 1:
+        g_profile.refreshRate = 50.0;
+        break;
+      case 2:
+        g_profile.refreshRate = 30.0;
+        break;
+      case 3:
+        g_profile.refreshRate = 59.94;
+        break;
+      case 4:
+        g_profile.refreshRate = 24.0;
+        break;
+      default:
+        g_profile.refreshRate = resolution.refreshRate > 1000
+                                    ? static_cast<double>(resolution.refreshRate) / 1000.0
+                                    : 59.94;
+        break;
+    }
+    g_profile.videoValid = true;
+  }
+
+  VideoOutCapability capability = {};
+  const int32_t capRc = sceVideoOutGetDeviceCapabilityInfo_(handle, &capability);
+  uint64_t capabilities = (capRc == 0) ? capability.capability : 0;
+
+  // The shim owns the live VideoOut handle and its own capability query is
+  // known to succeed on this firmware where the direct call can fail.
+  const uint64_t shimCapabilities = glShimGetVideoOutCapability();
+  if (capabilities == 0)
+    capabilities = shimCapabilities;
+
+  int32_t sysRc = 0;
+  if (capabilities == 0)
+  {
+    // The SysGetMonitorInfo_ entry point returns the same capability bitmask
+    // without a device handle.
+    const int32_t rc = sceVideoOutSysGetMonitorInfo_(0, &capabilities, sizeof(capabilities));
+    sysRc = rc;
+    if (rc != 0)
+      capabilities = 0;
+  }
+
+  // La consulta por handle falla en este firmware (0x80290001).  La variante
+  // "Sys...ByBusSpecifier" acepta el bus (0/1) en vez del handle.
+  uint64_t busCapability = 0;
+  int32_t busRc = -1;
+  uint32_t busUsed = 0;
+  for (uint32_t bus : {0u, 1u})
+  {
+    uint64_t value = 0;
+    const int32_t rc =
+        sceVideoOutSysGetDeviceCapabilityInfoByBusSpecifier_(bus, &value, sizeof(value));
+    if (rc == 0)
+    {
+      busRc = rc;
+      busCapability = value;
+      busUsed = bus;
+      break;
+    }
+    if (busRc == -1)
+      busRc = rc;
+  }
+  g_profile.videoCapsBusRc = busRc;
+  if (busRc == 0)
+  {
+    capabilities = busCapability;
+    g_profile.videoCapsBusValid = true;
+    g_profile.videoCapsBus = busUsed;
+  }
+
+  g_profile.videoCapabilities = capabilities;
+  g_profile.videoCapsRc = capRc;
+  g_profile.videoShimCapabilities = shimCapabilities;
+  g_profile.videoCapsValid = (busRc == 0) || (capabilities != 0);
+  g_profile.hdr10 = (capabilities & 0x80) != 0;
+  // The PS4 can output HDR10, but this renderer only writes SDR RGBA8 and
+  // does not submit HDR metadata, so Kodi never switches the output to HDR.
+  g_profile.hdrAutomatic = false;
+
+  CLog::Log(LOGINFO, "PS4 profile: caps rc={:#x} shim={:#x} sys_rc={:#x} bus_rc={:#x} bus={}",
+            capRc, shimCapabilities, sysRc, busRc, busUsed);
+
+  const int32_t modeRc =
+      sceVideoOutGetCurrentOutputMode_(handle, g_profile.outputMode.data());
+  const int32_t monitorRc = sceVideoOutGetHdmiMonitorInfoNoMask_(
+      handle, g_profile.hdmiMonitor.data(), g_profile.hdmiMonitor.size());
+  g_profile.videoModeRc = modeRc;
+  g_profile.videoMonitorRc = monitorRc;
+  g_profile.videoModeValid = (modeRc == 0);
+  g_profile.videoMonitorValid = (monitorRc == 0);
+
+  int32_t modeSysRc = -1;
+  for (uint32_t bus : {0u, 1u})
+  {
+    if (sceVideoOutSysGetCurrentOutputMode_(bus, g_profile.outputMode.data()) == 0)
+    {
+      modeSysRc = 0;
+      g_profile.videoModeValid = true;
+      break;
+    }
+  }
+  g_profile.videoModeSysRc = modeSysRc;
+
+  int32_t monitorSysRc = -1;
+  for (uint32_t bus : {0u, 1u})
+  {
+    if (sceVideoOutSysGetMonitorInfo_(bus, g_profile.hdmiMonitor.data(),
+                                     g_profile.hdmiMonitor.size()) == 0)
+    {
+      monitorSysRc = 0;
+      g_profile.videoMonitorValid = true;
+      break;
+    }
+  }
+  g_profile.videoMonitorSysRc = monitorSysRc;
+
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_SYSTEM_SERVICE);
+  float safeArea = 1.0f;
+  if (sceSystemServiceGetDisplaySafeAreaInfo(&safeArea) == 0 && safeArea > 0.0f)
+    g_profile.safeArea = safeArea;
+
+  CLog::Log(LOGINFO,
+            "PS4 profile: video {}x{}@{:.2f} hdr10={} hdr_automatic={} safe={:.3f} caps={:#x} "
+            "mode_rc={} monitor_rc={}",
+            g_profile.videoWidth, g_profile.videoHeight, g_profile.refreshRate, g_profile.hdr10,
+            g_profile.hdrAutomatic, g_profile.safeArea, g_profile.videoCapabilities, modeRc,
+            monitorRc);
+
+  if (g_profile.hdr10)
+    CLog::Log(LOGINFO,
+              "PS4 profile: HDR10 is supported by the console/TV; automatic HDR output is not "
+              "implemented yet (renderer stays SDR)");
+
+  CLog::Log(LOGDEBUG, "PS4 profile: output mode {}", HexDump(g_profile.outputMode.data(),
+                                                              g_profile.outputMode.size()));
+  CLog::Log(LOGDEBUG, "PS4 profile: hdmi monitor {}",
+            HexDump(g_profile.hdmiMonitor.data(), g_profile.hdmiMonitor.size()));
+
+}
+
+void LogHardwareProfile()
+{
+  if (!g_profile.valid)
+    return;
+
+  CLog::Log(LOGINFO,
+            "PS4 profile: summary model={} fw={} cpu={} mem={}MB video={}x{}@{:.2f} "
+            "hdr10={} hdr_automatic={} safe={:.3f} net={}",
+            g_profile.model, g_profile.firmware, g_profile.cpuCores, g_profile.memoryTotalMB,
+            g_profile.videoWidth, g_profile.videoHeight, g_profile.refreshRate, g_profile.hdr10,
+            g_profile.hdrAutomatic, g_profile.safeArea, g_profile.netLink);
+
+  CLog::Log(LOGINFO, "PS4 profile: locale language={} date_format={} time_format={}",
+            g_profile.language, g_profile.dateFormat, g_profile.timeFormat);
+  CLog::Log(LOGINFO,
+            "PS4 profile: net link={} wifi={} mtu={} (rc={}) rssi={}dBm/{}% ch={} "
+            "gw_rc={} internet_rc={}",
+            g_profile.netLink, g_profile.netWifi, g_profile.netMtu, g_profile.netMtuRc,
+            g_profile.netRssiDbm, g_profile.netRssiPercentage, g_profile.netChannel,
+            g_profile.netGatewayRc, g_profile.netInternetRc);
+
+  LogConsoleTime();
+}
+
+void ApplyConsoleLocaleSettings()
+{
+  if (!g_profile.valid || !g_profile.localeValid)
+    return;
+
+  const auto settingsComponent = CServiceBroker::GetSettingsComponent();
+  if (!settingsComponent)
+    return;
+  const auto settings = settingsComponent->GetSettings();
+  if (!settings)
+    return;
+
+  const std::string marker = ProfileDir() + "/.ps4-console-locale";
+  if (access(marker.c_str(), F_OK) == 0)
+    return;
+
+  std::string region;
+  if (g_profile.dateFormat == 0)
+    region = "Canada"; // YYYY-MM-DD
+  else if (g_profile.dateFormat == 2)
+    region = (g_profile.timeFormat == 1) ? "USA (24h)" : "USA (12h)";
+  else
+    region = (g_profile.timeFormat == 1) ? "UK (24h)" : "UK (12h)";
+
+  // Only replace Kodi's default; a region the user already chose is kept.
+  const std::string current = settings->GetString(CSettings::SETTING_LOCALE_COUNTRY);
+  if (current == "USA (12h)" && current != region)
+    settings->SetString(CSettings::SETTING_LOCALE_COUNTRY, region);
+
+  CLog::Log(LOGINFO, "PS4 locale: console date_format={} time_format={} -> region={}",
+            g_profile.dateFormat, g_profile.timeFormat, region);
+
+  const int fd = open(marker.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd >= 0)
+  {
+    char text[32];
+    const int length = snprintf(text, sizeof(text), "%d %d\n", g_profile.dateFormat,
+                                g_profile.timeFormat);
+    if (length > 0)
+      (void)write(fd, text, length);
+    close(fd);
+  }
+}
+
+const HardwareProfile& GetHardwareProfile()
+{
+  return g_profile;
+}
+
+} // namespace KODI::PLATFORM::PS4
