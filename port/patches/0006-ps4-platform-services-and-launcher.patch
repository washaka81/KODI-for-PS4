 {
+#if defined(__ORBIS__)
+  return GetPS4DiskUsage();
+#else
   std::vector<std::string> result;
   char line[1024];
 
@@ -117,6 +155,7 @@ std::vector<std::string> CPosixMountProvider::GetDiskUsage()
   }
 
   return result;
+#endif
 }
 
