+#include <orbis/SystemService.h>
+#include <orbis/_types/sys_service.h>
+#endif
+
+namespace KODI::PLATFORM::PS4
+{
+
+bool LaunchApp(const std::string& titleId)
+{
+#if defined(__ORBIS__)
+  if (titleId.size() != 9)
+  {
+    CLog::Log(LOGERROR, "PS4 launch: invalid title id '{}'", titleId);
+    return false;
+  }
+
+  for (const char c : titleId)
+  {
+    if (!std::isalnum(static_cast<unsigned char>(c)))
+    {
+      CLog::Log(LOGERROR, "PS4 launch: invalid character in title id '{}'", titleId);
+      return false;
+    }
+  }
+
+  LncAppParam param = {};
+  param.size = sizeof(param);
+  param.user_id = 0;
+  param.app_opt = 0;
+  param.crash_report = 0;
+  param.LaunchAppCheck_flag = LaunchApp_None;
+
+  const char* argv[] = {nullptr};
+  const int32_t rc = sceLncUtilLaunchApp(titleId.c_str(), argv, &param);
+  CLog::Log(LOGINFO, "PS4 launch: title={} rc=0x{:08x}", titleId,
+            static_cast<uint32_t>(rc));
+  return rc == 0;
+#else
+  (void)titleId;
+  return false;
+#endif
+}
+
+} // namespace KODI::PLATFORM::PS4
