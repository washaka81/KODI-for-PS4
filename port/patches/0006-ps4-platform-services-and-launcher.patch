+/*! \brief Hardware/TV information collected from the PS4 on first boot.
+ *
+ * The profile is deliberately a plain data snapshot: every field is read
+ * from a PS4 API or from statvfs/sysconf, and the raw HDMI monitor and
+ * output-mode blobs are kept so newer firmware fields can be decoded later
+ * without recompiling the probe.
+ */
+struct HardwareProfile
+{
+  bool valid{false};
+  bool neo{false};
+  int cpuMode{0};
+  int cpuCores{0};
+  uint64_t memoryTotalMB{0};
+  uint64_t memoryFreeMB{0};
+  uint64_t memoryFlexibleFreeMB{0};
