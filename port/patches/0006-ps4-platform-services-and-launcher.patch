+#endif
+#include <sys/types.h>
+
+namespace KODI
+{
+namespace MEMORY
+{
+
+void* AlignedMalloc(size_t s, size_t alignTo)
+{
+  void* p = nullptr;
+  if (posix_memalign(&p, alignTo, s) != 0)
+    return nullptr;
+
+  return p;
+}
+
+void AlignedFree(void* p)
+{
+  free(p);
+}
+
+uint64_t GetAvailableFlexibleMemorySize()
+{
+#if defined(__ORBIS__)
+  uint64_t available = 0;
+  using AvailableFlexibleFn = int32_t (*)(uint64_t*);
+  const auto availableFlexible =
+      reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize);
+  return availableFlexible(&available) == 0 ? available : 0;
+#else
+  return 0;
+#endif
+}
+
+uint64_t GetAvailableDirectMemorySize()
+{
+#if defined(__ORBIS__)
+  const uint64_t directMemory = sceKernelGetDirectMemorySize();
+  uint64_t directPhys = 0;
+  uint64_t directAvailable = 0;
+  using AvailableDirectFn = int32_t (*)(int64_t, int64_t, uint64_t, uint64_t*, uint64_t*);
+  const auto availableDirect =
+      reinterpret_cast<AvailableDirectFn>(&sceKernelAvailableDirectMemorySize);
+  const int32_t rc = availableDirect(0, static_cast<int64_t>(directMemory), 16 * 1024,
+                                     &directPhys, &directAvailable);
+  return rc == 0 ? directAvailable : 0;
+#else
+  return 0;
+#endif
+}
+
+uint64_t GetCurrentRssBytes()
+{
+#if defined(__ORBIS__)
+  FILE* f = fopen("/proc/self/statm", "r");
+  if (!f)
+    return 0;
+
+  unsigned long size = 0;
+  unsigned long resident = 0;
+  const int fields = fscanf(f, "%lu %lu", &size, &resident);
+  fclose(f);
+  if (fields != 2)
+    return 0;
+
+  long pageSize = sysconf(_SC_PAGESIZE);
+  if (pageSize <= 0)
+    pageSize = 4096;
+  return static_cast<uint64_t>(resident) * static_cast<uint64_t>(pageSize);
+#else
+  return 0;
+#endif
+}
+
+void GetMemoryStatus(MemoryStatus* buffer)
+{
+  if (!buffer)
+    return;
+
+#if defined(__ORBIS__)
+  const uint64_t directMemory = sceKernelGetDirectMemorySize();
+  const uint64_t totalPhys = directMemory > 0 ? directMemory : 8ULL * 1024ULL * 1024ULL * 1024ULL;
+
+  uint64_t flexibleAvailable = 0;
+  using AvailableFlexibleFn = int32_t (*)(uint64_t*);
+  const auto availableFlexible =
+      reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize);
+  const int32_t flexRc = availableFlexible(&flexibleAvailable);
+
+  uint64_t directAvailable = 0;
+  uint64_t directPhys = 0;
+  using AvailableDirectFn = int32_t (*)(int64_t, int64_t, uint64_t, uint64_t*, uint64_t*);
+  const auto availableDirect =
+      reinterpret_cast<AvailableDirectFn>(&sceKernelAvailableDirectMemorySize);
+  const int32_t directRc = availableDirect(0, static_cast<int64_t>(directMemory), 16 * 1024,
+                                           &directPhys, &directAvailable);
+
+  buffer->totalPhys = totalPhys;
+  uint64_t available = (flexRc == 0) ? flexibleAvailable : 0;
+  if (available == 0 && directRc == 0)
+    available = directAvailable;
+  buffer->availPhys = std::min(available, totalPhys);
+
+  static bool logged = false;
+  if (!logged)
+  {
+    logged = true;
+    CLog::Log(LOGINFO,
+              "PS4 memory: total={} MB flexible_avail={} MB (rc={}) direct_avail={} MB (rc={})",
+              totalPhys / (1024 * 1024), flexibleAvailable / (1024 * 1024), flexRc,
+              directAvailable / (1024 * 1024), directRc);
+  }
+#else
+  /* sysctl hw.physmem */
+  size_t len = 0;
+
+  /* physmem */
+  size_t physmem = 0;
+  len = sizeof(physmem);
+  if (sysctlbyname("hw.physmem", &physmem, &len, NULL, 0) == 0)
+  {
+    buffer->totalPhys = physmem;
+  }
+
+  /* pagesize */
+  size_t pagesize = 0;
+  len = sizeof(pagesize);
+  if (sysctlbyname("hw.pagesize", &pagesize, &len, NULL, 0) != 0)
+    pagesize = 4096;
+
+  /* mem_inactive */
+  size_t mem_inactive = 0;
+  len = sizeof(mem_inactive);
+  if (sysctlbyname("vm.stats.vm.v_inactive_count", &mem_inactive, &len, NULL, 0) == 0)
+    mem_inactive *= pagesize;
+
+  /* mem_cache */
+  size_t mem_cache = 0;
+  len = sizeof(mem_cache);
+  if (sysctlbyname("vm.stats.vm.v_cache_count", &mem_cache, &len, NULL, 0) == 0)
+    mem_cache *= pagesize;
+
+  /* mem_free */
+  size_t mem_free = 0;
+  len = sizeof(mem_free);
+  if (sysctlbyname("vm.stats.vm.v_free_count", &mem_free, &len, NULL, 0) == 0)
+    mem_free *= pagesize;
+
+  /* mem_avail = mem_inactive + mem_cache + mem_free */
+  buffer->availPhys = mem_inactive + mem_cache + mem_free;
+#endif
+}
+
+}
+}
