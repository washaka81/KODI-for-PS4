diff --git a/xbmc/platform/posix/PosixMountProvider.cpp b/xbmc/platform/posix/PosixMountProvider.cpp
index 6f1c3a23d3..1e016be363 100644
--- a/xbmc/platform/posix/PosixMountProvider.cpp
+++ b/xbmc/platform/posix/PosixMountProvider.cpp
@@ -15,6 +15,41 @@
 
 #include <cstdlib>
 
+#if defined(__ORBIS__)
+#include <cinttypes>
+#include <cstdio>
+#include <sys/statvfs.h>
+
+namespace
+{
+std::vector<std::string> GetPS4DiskUsage()
+{
+  // The Orbis sandbox only exposes /user to the application.  Do not probe
+  // /data or / here: statvfs on those paths can fault on some firmwares
+  // (CE-34878 when opening System Info).  If /user is not available, report
+  // no storage instead of risking a crash.
+  struct statvfs vfs = {};
+  const int rc = statvfs("/user", &vfs);
+  CLog::Log(LOGINFO,
+            "PS4 storage: /user statvfs rc={} bsize={} frsize={} blocks={} bfree={} bavail={}",
+            rc, vfs.f_bsize, vfs.f_frsize, vfs.f_blocks, vfs.f_bfree, vfs.f_bavail);
+  if (rc != 0)
+    return {};
+
+  const uint64_t unit = vfs.f_frsize ? vfs.f_frsize : vfs.f_bsize;
+  const uint64_t total = static_cast<uint64_t>(vfs.f_blocks) * unit;
+  const uint64_t avail = static_cast<uint64_t>(vfs.f_bavail) * unit;
+  if (unit == 0 || total < 100ULL * 1024ULL * 1024ULL)
+    return {};
+
+  char line[160];
+  snprintf(line, sizeof(line), "/user  %.1f GB total  %.1f GB free",
+           total / (1024.0 * 1024.0 * 1024.0), avail / (1024.0 * 1024.0 * 1024.0));
+  return {line};
+}
+} // namespace
+#endif
+
