diff --git a/system/shaders/GLES/2.0/gles_pack.frag b/system/shaders/GLES/2.0/gles_pack.frag
new file mode 100644
index 0000000000..45f776ced9
--- /dev/null
+++ b/system/shaders/GLES/2.0/gles_pack.frag
@@ -0,0 +1,16 @@
+#version 100
+
+precision mediump float;
+
+uniform sampler2D img;
+uniform vec4 m_packmask;
+varying vec2 cord;
+
+void main()
+{
+  vec4 t = texture2D(img, cord);
+  /* mask selects the channels; V goes to B so we do not depend on the
+   * (non per-channel) GNM render-target mask. */
+  gl_FragColor = vec4(t.r * m_packmask.r, t.g * m_packmask.g,
+                      t.a * m_packmask.b, 0.0);
+}
