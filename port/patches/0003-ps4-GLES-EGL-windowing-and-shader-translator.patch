 using namespace Shaders;
 using namespace Shaders::GLES;
 
+namespace
+{
+/* One-sampler pack shader: adds its contribution to the packed FBO with
+ * additive blending, so the GNM render-target mask (which is not a
+ * per-channel write mask) is not needed. */
+class CPackShader : public DefaultFilterShader
+{
+public:
+  CPackShader() { PixelShader()->LoadSource("gles_pack.frag"); }
+
+  void OnCompiledAndLinked() override
+  {
+    DefaultFilterShader::OnCompiledAndLinked();
+    m_hMask = glGetUniformLocation(ProgramHandle(), "m_packmask");
+  }
+
+  bool OnEnabled() override
+  {
+    DefaultFilterShader::OnEnabled();
+    glUniform4f(m_hMask, m_mask[0], m_mask[1], m_mask[2], 0.0f);
+    return true;
+  }
+
+  void SetMask(float r, float g, float b)
+  {
+    m_mask[0] = r;
+    m_mask[1] = g;
+    m_mask[2] = b;
+  }
+
+private:
+  GLint m_hMask{-1};
+  float m_mask[3]{1.0f, 0.0f, 0.0f};
+};
+} // namespace
