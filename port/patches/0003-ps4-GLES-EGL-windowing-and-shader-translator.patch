+        CLog::Log(LOGERROR, "PS4GL: variant {} failed to compile", variant);
+        continue;
+      }
+      if (CreateAndLink())
+      {
+        CLog::Log(LOGERROR, "PS4GL: shader variant {} linked", variant);
+        VerifyGLState();
+        m_validated = false;
+        m_ok = true;
+        OnCompiledAndLinked();
+        VerifyGLState();
+        return true;
+      }
+      log[0] = '\0';
+      if (m_shaderProgram)
+        glGetProgramInfoLog(m_shaderProgram, LOG_SIZE, NULL, log);
+      CLog::Log(LOGERROR, "PS4GL: variant {} link failed: {}", variant, log);
+    }
+    PS4_SetShaderVariant(0);
+#endif
     goto error;
   }
   VerifyGLState();
diff --git a/xbmc/platform/ps4/PS4ShaderBin.cpp b/xbmc/platform/ps4/PS4ShaderBin.cpp
new file mode 100644
index 0000000000..556e34adda
--- /dev/null
+++ b/xbmc/platform/ps4/PS4ShaderBin.cpp
@@ -0,0 +1,148 @@
+/*
+ *  Copyright (C) 2026 OpenOrbis/Kodi PS4 port
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "platform/ps4/PS4ShaderBin.h"
+
+#if defined(__ORBIS__)
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include <GLES2/gl2.h>
+
+#include "filesystem/File.h"
+#include "utils/log.h"
+
+namespace {
+
+unsigned int HashBuf(const char* buf, unsigned int len)
+{
+  unsigned int h = 5381;
+  for (unsigned int i = 0; i < len; i++)
+    h = ((h << 5) + h) + static_cast<unsigned char>(buf[i]);
+  return h;
+}
+
+int g_variant = -1;
+
+int ShaderVariant()
+{
+  if (g_variant >= 0)
+    return g_variant;
+
+  g_variant = 0;
+  FILE* f = fopen("/data/kodi-ps4/shader-variant.txt", "r");
+  if (f)
+  {
+    int v = 0;
+    if (fscanf(f, "%d", &v) == 1 && v >= 0 && v <= 9)
+      g_variant = v;
+    fclose(f);
+  }
+
+  return g_variant;
+}
+
+std::string BlobPath(unsigned int hash, const char* src, unsigned int srcLen,
+                     unsigned int shaderType)
+{
+  // The YV12 video shaders get stable names.  The hash path can silently
+  // pick an older blob when Kodi's final source assembly changes (the old
+  // blob then samples m_cordU/m_cordV and produces green/white chroma).
+  if (shaderType == GL_FRAGMENT_SHADER && src && srcLen)
+  {
+    const std::string source(src, srcLen);
+    // Exact match: the YV12_HI shader also contains "#define XBMC_YV12"
+    // as a prefix.  Loading the 8-bit blob for a 10-bit frame would make
+    // the renderer sample R8 textures through the R16 path.
+    if (source.find("#define XBMC_YV12\n") != std::string::npos ||
+        source.find("#define XBMC_YV12\r\n") != std::string::npos)
+    {
+      const char* name = source.find("m_field") != std::string::npos ? "yv12_bob.bin"
+                                                                    : "yv12_basic.bin";
+      return "special://xbmc/system/shaders/bin/" + std::string(name);
+    }
+    if (source.find("#define XBMC_NV12\n") != std::string::npos ||
+        source.find("#define XBMC_NV12\r\n") != std::string::npos)
+    {
+      const char* name = source.find("m_field") != std::string::npos ? "nv12_bob.bin"
+                                                                    : "nv12_basic.bin";
+      return "special://xbmc/system/shaders/bin/" + std::string(name);
+    }
+    if (source.find("#define XBMC_PS4_PACKED\n") != std::string::npos ||
+        source.find("#define XBMC_PS4_PACKED\r\n") != std::string::npos)
+    {
+      const char* name = source.find("m_field") != std::string::npos ? "packed_bob.bin"
+                                                                    : "packed_basic.bin";
+      return "special://xbmc/system/shaders/bin/" + std::string(name);
+    }
+  }
+
+  char name[16];
+  snprintf(name, sizeof(name), "%08x.bin", hash);
+  const int variant = ShaderVariant();
+  if (variant == 0)
+    return "special://xbmc/system/shaders/bin/" + std::string(name);
+  return "special://xbmc/system/shaders/bin/v" + std::to_string(variant) + "/" +
+         std::string(name);
+}
+
+} // unnamed namespace
+
+extern "C" void PS4_SetShaderVariant(int variant)
+{
+  if (variant < 0 || variant > 9)
+    variant = 0;
+  g_variant = variant;
+}
+
+bool PS4_LoadShaderBinary(unsigned int shader, const char* src, unsigned int srcLen,
+                          unsigned int shaderType, unsigned int* outHash)
+{
+  const unsigned int hash = HashBuf(src, srcLen);
+
+  XFILE::CFile file;
+  const std::string path = BlobPath(hash, src, srcLen, shaderType);
+  if (!file.Open(path))
+  {
+    CLog::Log(LOGERROR, "PS4 shaderbin: missing {:08x} ({})", hash, path);
+    if (outHash)
+      *outHash = hash;
+    return false;
+  }
+
+  // PS4's fstat() can report a wrong file size, so read until EOF.
+  std::string raw;
+  {
+    char chunk[4096];
+    int n;
+    while ((n = file.Read(chunk, sizeof(chunk))) > 0)
+      raw.append(chunk, static_cast<size_t>(n));
+  }
+  file.Close();
+  const unsigned int rawSize = static_cast<unsigned int>(raw.size());
+  if (rawSize <= sizeof(unsigned int))
+  {
+    if (outHash)
+      *outHash = hash;
+    return false;
+  }
+
+  unsigned int format = 0;
+  std::memcpy(&format, raw.data(), sizeof(format));
+  const int blobSize = static_cast<int>(rawSize - sizeof(format));
+
+  while (glGetError() != GL_NO_ERROR)
+  {
+  }
+  glShaderBinary(1, &shader, 0, raw.data() + sizeof(format), blobSize);
+  return true;
+}
+
+#endif // __ORBIS__
