-    LoadPlane(buf.fields[FIELD_FULL][1], GL_LUMINANCE, im->width >> im->cshift_x,
-              im->height >> im->cshift_y, im->stride[1], im->bpp, im->plane[1]);
-
-    LoadPlane(buf.fields[FIELD_FULL][2], GL_ALPHA, im->width >> im->cshift_x,
-              im->height >> im->cshift_y, im->stride[2], im->bpp, im->plane[2]);
+    if (im->plane[1] && im->plane[2] && cw && ch && m_uvInterleave.size() >= need)
+    {
+      // PS4 NV12: interleave U/V into one GL_LUMINANCE_ALPHA texture.
+      // The shader reads U from .g and V from .a with two samplers.
+      for (unsigned y = 0; y < ch; ++y)
+      {
+        const unsigned char* u = im->plane[1] + (size_t)y * im->stride[1];
+        const unsigned char* v = im->plane[2] + (size_t)y * im->stride[2];
+        unsigned char* dst = m_uvInterleave.data() + (size_t)y * cw * 2;
+        for (unsigned x = 0; x < cw; ++x)
