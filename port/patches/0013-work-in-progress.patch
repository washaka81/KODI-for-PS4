+namespace
+{
+
+constexpr const char* kCrashLog = "/data/kodi-ps4/crash.log";
+
+struct CrashBacktrace
+{
+  void* frames[64];
+  int count{0};
+};
+
+_Unwind_Reason_Code CrashBacktraceCallback(_Unwind_Context* context, void* arg)
+{
+  auto* state = static_cast<CrashBacktrace*>(arg);
+  const uintptr_t ip = _Unwind_GetIP(context);
+  if (ip != 0 && state->count < static_cast<int>(std::size(state->frames)))
+    state->frames[state->count++] = reinterpret_cast<void*>(ip);
+  return state->count >= static_cast<int>(std::size(state->frames)) ? _URC_END_OF_STACK
+                                                                   : _URC_NO_REASON;
+}
+
+void PS4CrashWrite(const char* tag, int sig = 0, const void* addr = nullptr)
+{
+  const int fd = open(kCrashLog, O_WRONLY | O_CREAT | O_APPEND, 0644);
+  if (fd < 0)
+    return;
+
+  char line[256];
+  const int n = snprintf(line, sizeof(line), "\n=== %s signal=%d addr=%p thread=%llu ===\n", tag, sig,
+                         addr, static_cast<unsigned long long>(
+                                   reinterpret_cast<uintptr_t>(pthread_self())));
+  if (n > 0)
+    (void)write(fd, line, static_cast<size_t>(n));
+
+  CrashBacktrace state;
+  _Unwind_Backtrace(CrashBacktraceCallback, &state);
+  for (int i = 0; i < state.count; ++i)
+  {
+    const int len = snprintf(line, sizeof(line), "  bt[%02d]=%p\n", i, state.frames[i]);
+    if (len > 0)
+      (void)write(fd, line, static_cast<size_t>(len));
+  }
+  close(fd);
+}
+
+void PS4CrashHandler(int sig, siginfo_t* info, void* /*context*/)
+{
+  PS4CrashWrite("crash", sig, info ? info->si_addr : nullptr);
+  _exit(128 + sig);
+}
+
+void PS4NewHandler()
+{
+  PS4CrashWrite("new_handler");
+  abort();
+}
+
+void PS4TerminateHandler()
+{
+  PS4CrashWrite("terminate");
+  abort();
+}
+
+} // namespace
+
+void InstallPS4CrashHandler()
+{
+  /* Diagnostic switch: create /data/kodi-ps4/crash-handler over FTP (or set
+   * PS4_CRASH_HANDLER=1) before launch.  Release runs stay trace-free. */
+  if (!getenv("PS4_CRASH_HANDLER") && access("/data/kodi-ps4/crash-handler", F_OK) != 0)
+    return;
+
+  static char altstack[64 * 1024];
+  stack_t ss = {};
+  ss.ss_sp = altstack;
+  ss.ss_size = sizeof(altstack);
+  ss.ss_flags = 0;
+  (void)sigaltstack(&ss, nullptr);
+
+  struct sigaction sa = {};
+  sa.__sa_handler.__sa_sigaction = PS4CrashHandler;
+  sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+  sigemptyset(&sa.sa_mask);
+  for (const int sig : {SIGSEGV, SIGBUS, SIGABRT, SIGILL, SIGFPE})
+    (void)sigaction(sig, &sa, nullptr);
+
+  std::set_new_handler(PS4NewHandler);
+  std::set_terminate(PS4TerminateHandler);
+}
