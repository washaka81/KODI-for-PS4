+
+#include "VideoSyncPs4.h"
+
+#include "ServiceBroker.h"
+#include "cores/VideoPlayer/VideoReferenceClock.h"
+#include "threads/Thread.h"
+#include "utils/TimeUtils.h"
+#include "utils/log.h"
+#include "windowing/GraphicContext.h"
+#include "windowing/WinSystem.h"
+
+#include <chrono>
+#include <thread>
+
+// Provided by libglshim: number of flips actually scanned out by VideoOut.
+extern "C" uint64_t glShimGetFlipCount(void);
+
+CVideoSyncPs4::CVideoSyncPs4(CVideoReferenceClock* clock) : CVideoSync(clock) {}
+
+bool CVideoSyncPs4::Setup()
+{
+  m_abort = false;
+  m_lastFlip = glShimGetFlipCount();
+  CLog::Log(LOGDEBUG, "CVideoSyncPs4::{}: setting up (flips={})", __FUNCTION__, m_lastFlip);
+  return true;
+}
+
+void CVideoSyncPs4::Run(CEvent& stopEvent)
+{
+  // The vblank clock is timing sensitive; keep the polling thread above
+  // normal priority like the other Kodi VideoSync implementations.
+  CThread::GetCurrentThread()->SetPriority(ThreadPriority::ABOVE_NORMAL);
+
+  while (!stopEvent.Signaled() && !m_abort)
+  {
+    // VideoOut does not expose a portable vblank event queue to the shim
+    // yet; polling the hardware flip counter is enough to drive Kodi's
+    // reference clock and avoids sharing the render flip queue.
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+
+    const uint64_t flips = glShimGetFlipCount();
+    if (flips == 0)
+      continue;
+
+    if (m_lastFlip == 0)
+    {
+      m_lastFlip = flips;
+      continue;
+    }
+
+    if (flips == m_lastFlip)
+      continue;
+
+    const uint64_t delta = flips - m_lastFlip;
+    m_lastFlip = flips;
+    m_refClock->UpdateClock(static_cast<int>(delta), CurrentHostCounter());
+  }
+}
+
+void CVideoSyncPs4::Cleanup()
+{
+  CLog::Log(LOGDEBUG, "CVideoSyncPs4::{}: cleaning up", __FUNCTION__);
+}
+
+float CVideoSyncPs4::GetFps()
+{
+  m_fps = CServiceBroker::GetWinSystem()->GetGfxContext().GetFPS();
+  if (m_fps <= 0.0f)
+    m_fps = 60.0f;
+  CLog::Log(LOGDEBUG, "CVideoSyncPs4::{}: fps:{}", __FUNCTION__, m_fps);
+  return m_fps;
+}
+
+void CVideoSyncPs4::RefreshChanged()
+{
+  if (m_fps != CServiceBroker::GetWinSystem()->GetGfxContext().GetFPS())
+    m_abort = true;
+}
