+
+namespace kodi::ps4 {
+
+class CPadPS4 {
+ public:
+  bool Initialize();
+  void Poll();
+  void Shutdown();
+
+ private:
+  void Emit(uint32_t button, bool pressed, bool& previous);
+  void EmitDirection(bool pressed,
+                     bool& previous,
+                     uint64_t& next_repeat,
+                     uint32_t button,
+                     uint64_t now);
+  void ReleaseAll(uint64_t now);
+
+  PS4Input input_;
+
+  bool up_{false};
+  bool down_{false};
+  bool left_{false};
+  bool right_{false};
+  bool confirm_{false};
+  bool back_{false};
+  bool play_pause_{false};
+  bool context_menu_{false};
+  bool page_up_{false};
+  bool page_down_{false};
+
+  uint64_t next_up_{0};
+  uint64_t next_down_{0};
+  uint64_t next_left_{0};
+  uint64_t next_right_{0};
+};
+
+}  // namespace kodi::ps4
diff --git a/xbmc/platform/ps4/CxaThreadAtexit.cpp b/xbmc/platform/ps4/CxaThreadAtexit.cpp
new file mode 100644
index 0000000000..1485098b5b
--- /dev/null
+++ b/xbmc/platform/ps4/CxaThreadAtexit.cpp
@@ -0,0 +1,65 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// The PS4 SDK ships libc++ 11, whose __cxa_thread_atexit refers to
+// __cxa_thread_atexit_impl, but the implementation is not part of the
+// sysroot.  Register the thread_local destructors on a pthread key so they
+// run when the owning thread exits.
+
+#include <pthread.h>
+
+#include <vector>
+
+namespace
+{
+struct ThreadDestructor
+{
+  void (*dtor)(void*);
+  void* obj;
+};
+
+void RunThreadDestructors(void* data)
+{
+  auto* destructors = static_cast<std::vector<ThreadDestructor>*>(data);
+  for (auto it = destructors->rbegin(); it != destructors->rend(); ++it)
+    it->dtor(it->obj);
+  delete destructors;
+}
+
+pthread_key_t DestructorKey()
+{
+  static const pthread_key_t key = [] {
+    pthread_key_t created;
+    if (pthread_key_create(&created, RunThreadDestructors) != 0)
+      return static_cast<pthread_key_t>(-1);
+    return created;
+  }();
+  return key;
+}
+} // namespace
+
+extern "C" int __cxa_thread_atexit_impl(void (*dtor)(void*), void* obj, void* dso_handle)
+{
+  const pthread_key_t key = DestructorKey();
+  if (key == static_cast<pthread_key_t>(-1))
+    return -1;
+
+  auto* destructors = static_cast<std::vector<ThreadDestructor>*>(pthread_getspecific(key));
+  if (destructors == nullptr)
+  {
+    destructors = new std::vector<ThreadDestructor>();
+    if (pthread_setspecific(key, destructors) != 0)
+    {
+      delete destructors;
+      return -1;
+    }
+  }
+
+  destructors->push_back({dtor, obj});
+  return 0;
+}
