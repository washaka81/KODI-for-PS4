diff --git a/xbmc/platform/ps4/PS4DatabaseLocks.cpp b/xbmc/platform/ps4/PS4DatabaseLocks.cpp
new file mode 100644
index 0000000000..737ded0228
--- /dev/null
+++ b/xbmc/platform/ps4/PS4DatabaseLocks.cpp
@@ -0,0 +1,128 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "PS4DatabaseLocks.h"
+
+#include "filesystem/SpecialProtocol.h"
+#include "utils/StartupTrace.h"
+#include "utils/log.h"
+
+#include <cerrno>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <dirent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace
+{
+
+constexpr const char* LOCK_SUFFIX = ".lock";
+
+bool EndsWithLock(const std::string& name)
+{
+  const std::string suffix{LOCK_SUFFIX};
+  return name.size() > suffix.size() &&
+         name.compare(name.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+/*! \brief Remove the .lock entries of one Database directory.
+ *
+ * A lock is only removed when the matching database file exists, so an
+ * unrelated .lock file in userdata is never touched.
+ */
+void CleanDatabaseFolder(const std::string& folder)
+{
+  DIR* dir = opendir(folder.c_str());
+  if (!dir)
+    return;
+
+  std::vector<std::string> locks;
+  while (dirent* entry = readdir(dir))
+  {
+    const std::string name{entry->d_name};
+    if (name == "." || name == ".." || !EndsWithLock(name))
+      continue;
+
+    const std::string dbName = name.substr(0, name.size() - std::strlen(LOCK_SUFFIX));
+    const std::string dbPath = folder + "/" + dbName;
+    // PS4's lstat() returns EPERM and stat() may lie about the size, but
+    // access() is reliable for an existence check.
+    if (access(dbPath.c_str(), F_OK) != 0)
+      continue;
+
+    locks.push_back(folder + "/" + name);
+  }
+  closedir(dir);
+
+  for (const std::string& path : locks)
+  {
+    // The dotfile VFS creates an empty directory; fall back to unlink for a
+    // regular file.  Avoid lstat(), which returns EPERM on PS4.
+    int rc = rmdir(path.c_str());
+    if (rc != 0)
+      rc = unlink(path.c_str());
+
+    if (rc == 0)
+    {
+      CLog::Log(LOGINFO, "PS4: removed stale database lock {}", path);
+      WriteStartupTrace(("db-lock-removed:" + path).c_str());
+    }
+    else
+    {
+      CLog::Log(LOGERROR, "PS4: could not remove database lock {}: {} ({})", path,
+                std::strerror(errno), errno);
+    }
+  }
+}
+
+void CleanProfileDatabases(const std::string& userDataFolder)
+{
+  CleanDatabaseFolder(userDataFolder + "/Database");
+
+  const std::string profilesFolder = userDataFolder + "/profiles";
+  DIR* profiles = opendir(profilesFolder.c_str());
+  if (!profiles)
+    return;
+
+  std::vector<std::string> profileNames;
+  while (dirent* entry = readdir(profiles))
+  {
+    const std::string name{entry->d_name};
+    if (name == "." || name == "..")
+      continue;
+
+    const std::string path = profilesFolder + "/" + name;
+    struct stat st = {};
+    if (stat(path.c_str(), &st) == 0 && S_ISDIR(st.st_mode))
+      profileNames.push_back(name);
+  }
+  closedir(profiles);
+
+  for (const std::string& name : profileNames)
+    CleanDatabaseFolder(profilesFolder + "/" + name + "/Database");
+}
+
+} // namespace
+
+namespace KODI::PLATFORM::PS4
+{
+
+void RemoveStaleDatabaseLocks(const std::string& userDataFolder)
+{
+  if (userDataFolder.empty())
+    return;
+
+  WriteStartupTrace("db-locks-cleanup-begin");
+  CleanProfileDatabases(CSpecialProtocol::TranslatePath(userDataFolder));
+  WriteStartupTrace("db-locks-cleanup-done");
+}
+
+} // namespace KODI::PLATFORM::PS4
diff --git a/xbmc/platform/ps4/PS4DatabaseLocks.h b/xbmc/platform/ps4/PS4DatabaseLocks.h
new file mode 100644
index 0000000000..43ef145968
--- /dev/null
+++ b/xbmc/platform/ps4/PS4DatabaseLocks.h
@@ -0,0 +1,31 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <string>
+
+namespace KODI::PLATFORM::PS4
+{
+
+/*! \brief Remove stale SQLite dotfile locks from the database folders.
+ *
+ * The PS4 has no POSIX advisory locks, so Kodi uses SQLite's unix-dotfile
+ * VFS.  That VFS represents a lock as a <database>.db.lock directory.  If
+ * Kodi is killed without a clean shutdown, the directories survive and the
+ * next start blocks forever in the SQLite busy handler.
+ *
+ * PS4 runs a single Kodi instance, so any lock found before the first
+ * database is opened belongs to a dead process and can be removed safely.
+ * Only entries that have a matching .db file next to them are touched.
+ *
+ * \param userDataFolder current profile userdata folder (contains Database/)
+ */
+void RemoveStaleDatabaseLocks(const std::string& userDataFolder);
+
+} // namespace KODI::PLATFORM::PS4
diff --git a/xbmc/platform/ps4/PS4Input.cpp b/xbmc/platform/ps4/PS4Input.cpp
new file mode 100644
index 0000000000..08b1aa3c68
--- /dev/null
+++ b/xbmc/platform/ps4/PS4Input.cpp
@@ -0,0 +1,172 @@
+#include "PS4Input.h"
+
+#include "utils/StartupTrace.h"
+#include "utils/TimeUtils.h"
+#include "utils/log.h"
+
+#if defined(__ORBIS__) || defined(PS4)
+extern "C" {
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+#include <orbis/libkernel.h>
+}
+#endif
+
+namespace kodi::ps4 {
+namespace {
+
+// steady_clock tracks CPU time on Orbis, not wall time; use the same
+// CLOCK_MONOTONIC_RAW source as the rest of the port.
+uint64_t NowMs() {
+  return static_cast<uint64_t>(CurrentHostCounter() / 1000000);
+}
+
+uint64_t NowUs() {
+  return static_cast<uint64_t>(CurrentHostCounter() / 1000);
+}
+
+}  // namespace
+
+bool PS4Input::Initialize() {
+  if (initialized_)
+    return true;
+
+#if defined(__ORBIS__) || defined(PS4)
+  // The pad library is a system module.  Load it explicitly for the same
+  // reason as libSceVideoOut: the lazy resolution of the first import can
+  // block in the Kodi process.  Failure here is not fatal (the module may
+  // already be resident).
+  int loadrc = sceKernelLoadStartModule("libScePad.sprx", 0, nullptr, 0, nullptr, nullptr);
+  CLog::Log(LOGDEBUG, "PS4Input: load libScePad rc=0x{:08x}", loadrc);
+
+  int initrc = scePadInit();
+  CLog::Log(LOGINFO, "PS4Input: scePadInit rc=0x{:08x}", initrc);
+
+  // libSceUserService is not resident either; load it before the first
+  // import, otherwise the call can terminate the process.
+  WriteStartupTrace("ps4input-usersvc-load-begin");
+  int userloadrc =
+      sceKernelLoadStartModule("libSceUserService.sprx", 0, nullptr, 0, nullptr, nullptr);
+  WriteStartupTrace("ps4input-usersvc-load-done");
+  CLog::Log(LOGDEBUG, "PS4Input: load libSceUserService rc=0x{:08x}", userloadrc);
+
+  // scePadOpen() needs the user that launched the application, not the
+  // literal user 0 (that fails with 0x809b0081 when no pad is attached to
+  // user 0).  Resolve it once, as the OpenOrbis input sample does.
+  OrbisUserServiceInitializeParams userparams{};
+  userparams.priority = ORBIS_KERNEL_PRIO_FIFO_LOWEST;
+  WriteStartupTrace("ps4input-usersvc-init-begin");
+  int userrc = sceUserServiceInitialize(&userparams);
+  WriteStartupTrace("ps4input-usersvc-init-done");
+  int32_t user = -1;
+  WriteStartupTrace("ps4input-usersvc-get-begin");
+  int getrc = sceUserServiceGetInitialUser(&user);
+  WriteStartupTrace("ps4input-usersvc-get-done");
+  if (getrc < 0 || user < 0) {
+    WriteStartupTrace("ps4input-usersvc-fg-begin");
+    int fgrc = sceUserServiceGetForegroundUser(&user);
+    WriteStartupTrace("ps4input-usersvc-fg-done");
+    if (fgrc >= 0)
+      getrc = fgrc;
+  }
+  if (getrc >= 0 && user >= 0)
+    user_id_ = user;
+  else
+    user_id_ = 0;
+  CLog::Log(LOGINFO, "PS4Input: user service rc=0x{:08x} initial rc=0x{:08x} user={}",
+            userrc, getrc, user_id_);
+  WriteStartupTrace("ps4input-usersvc-done");
+
+  TryOpen();
+#endif
+
+  initialized_ = true;
+  return true;
+}
+
+void PS4Input::TryOpen() {
+#if defined(__ORBIS__) || defined(PS4)
+  if (handle_ >= 0)
+    return;
+
+  const uint64_t now = NowMs();
+  if (now < next_open_ms_)
+    return;
+  next_open_ms_ = now + 1000;
+
+  handle_ = scePadOpen(user_id_, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+  if (handle_ >= 0)
+    CLog::Log(LOGINFO, "PS4Input: pad opened handle={}", handle_);
+  else
+    CLog::Log(LOGDEBUG, "PS4Input: scePadOpen failed rc=0x{:08x}",
+              static_cast<uint32_t>(handle_));
+#endif
+}
+
+void PS4Input::Close() {
+#if defined(__ORBIS__) || defined(PS4)
+  if (handle_ >= 0) {
+    scePadClose(handle_);
+    CLog::Log(LOGINFO, "PS4Input: pad closed handle={}", handle_);
+  }
+#endif
+  handle_ = -1;
+  state_ = PS4InputState{};
+}
+
+void PS4Input::Poll() {
+  last_read_us_ = 0;
+  if (!initialized_)
+    return;
+
+#if defined(__ORBIS__) || defined(PS4)
+  if (handle_ < 0) {
+    TryOpen();
+    if (handle_ < 0)
+      return;
+  }
+
+  OrbisPadData data{};
+  const uint64_t read_start_us = NowUs();
+  const int rc = scePadReadState(handle_, &data);
+  last_read_us_ = NowUs() - read_start_us;
+  if (rc < 0) {
+    CLog::Log(LOGINFO, "PS4Input: pad disconnected rc=0x{:08x}",
+              static_cast<uint32_t>(rc));
+    Close();
+    return;
+  }
+
+  PS4InputState state{};
+  state.connected = data.connected != 0;
+  if (!state.connected) {
+    state_ = PS4InputState{};
+    return;
+  }
+
+  const uint32_t buttons = data.buttons;
+  state.up = (buttons & ORBIS_PAD_BUTTON_UP) != 0;
+  state.down = (buttons & ORBIS_PAD_BUTTON_DOWN) != 0;
+  state.left = (buttons & ORBIS_PAD_BUTTON_LEFT) != 0;
+  state.right = (buttons & ORBIS_PAD_BUTTON_RIGHT) != 0;
+  state.confirm = (buttons & ORBIS_PAD_BUTTON_CROSS) != 0;
+  state.back = (buttons & ORBIS_PAD_BUTTON_CIRCLE) != 0;
+  state.play_pause = (buttons & ORBIS_PAD_BUTTON_OPTIONS) != 0;
+  state.context_menu = (buttons & ORBIS_PAD_BUTTON_SQUARE) != 0;
+  state.page_up = (buttons & (ORBIS_PAD_BUTTON_L1 | ORBIS_PAD_BUTTON_L2)) != 0;
+  state.page_down = (buttons & (ORBIS_PAD_BUTTON_R1 | ORBIS_PAD_BUTTON_R2)) != 0;
+
+  // PS4 sticks are 0..255 with (128,128) at rest.  Normalise to [-1, 1];
+  // Y is inverted because Kodi's screen coordinates grow downwards.
+  state.stick_x = (static_cast<float>(data.leftStick.x) - 128.0f) / 127.0f;
+  state.stick_y = (128.0f - static_cast<float>(data.leftStick.y)) / 127.0f;
+  state_ = state;
+#endif
+}
+
+void PS4Input::Shutdown() {
+  Close();
+  initialized_ = false;
+}
+
+}  // namespace kodi::ps4
diff --git a/xbmc/platform/ps4/PS4Input.h b/xbmc/platform/ps4/PS4Input.h
new file mode 100644
index 0000000000..466e7f6505
--- /dev/null
+++ b/xbmc/platform/ps4/PS4Input.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdint>
+
+namespace kodi::ps4 {
+
+struct PS4InputState {
+  bool connected = false;
+  bool up = false;
+  bool down = false;
+  bool left = false;
+  bool right = false;
+  bool confirm = false;
+  bool back = false;
+  bool play_pause = false;
+  bool context_menu = false;
+  bool page_up = false;
+  bool page_down = false;
+  float stick_x = 0.0f;
+  float stick_y = 0.0f;
+};
+
+class PS4Input {
+ public:
+  bool Initialize();
+  void Poll();
+  PS4InputState State() const { return state_; }
+  /* Time spent inside scePadReadState() during the last Poll(), in
+   * microseconds.  CPadPS4 uses it to separate pad I/O from key injection
+   * when a frame stalls. */
+  uint64_t LastReadUs() const { return last_read_us_; }
+  void Shutdown();
+
+ private:
+  void TryOpen();
+  void Close();
+
+  PS4InputState state_{};
+  int32_t handle_ = -1;
+  int32_t user_id_ = -1;
+  uint64_t next_open_ms_ = 0;
+  uint64_t last_read_us_ = 0;
+  bool initialized_ = false;
+};
+
+}  // namespace kodi::ps4
diff --git a/xbmc/platform/ps4/PS4RendererGLES2.cpp b/xbmc/platform/ps4/PS4RendererGLES2.cpp
new file mode 100644
index 0000000000..573386b8e0
--- /dev/null
+++ b/xbmc/platform/ps4/PS4RendererGLES2.cpp
@@ -0,0 +1,171 @@
+#include <cstdio>
+#include "PS4RendererGLES2.h"
+
+#include <cstring>
+#if defined(__ORBIS__) || defined(PS4)
+extern "C" {
+#include <orbis/libkernel.h>
+}
+#endif
+
+#if defined(__ORBIS__) || defined(PS4)
+extern "C" {
+#include <orbis/Pigletv2VSH.h>
+}
+#include <EGL/egl.h>
+#include <GLES2/gl2.h>
+#endif
+
+namespace kodi::ps4 {
+
+bool PS4RendererGLES2::Initialize(uint32_t width, uint32_t height) {
+  width_ = width;
+  height_ = height;
+
+#if defined(__ORBIS__) || defined(PS4)
+  const char *sandbox = sceKernelGetFsSandboxRandomWord();
+  char pigletname[256] = {0};
+  char precompiledname[256] = {0};
+  if (sandbox) {
+    snprintf(pigletname, sizeof(pigletname), "/%s/common/lib/libScePigletv2VSH.sprx", sandbox);
+    snprintf(precompiledname, sizeof(precompiledname), "/%s/common/lib/libScePrecompiledShaders.sprx", sandbox);
+  }
+
+  FILE *lfm = fopen("/data/kodi-ps4/init.log","a");
+  if (lfm) { fprintf(lfm, "sandbox=%s\n", sandbox ? sandbox : "(null)\n"); fprintf(lfm, "piglet_sprx=%s\n", pigletname); fflush(lfm); fclose(lfm); }
+
+  int mstart = 0;
+  uint32_t piglet_mod = 0;
+  uint32_t precomp_mod = 0;
+  if (sandbox) {
+    piglet_mod = sceKernelLoadStartModule(pigletname, 0, nullptr, 0, nullptr, &mstart);
+    if ((int)piglet_mod < 0) {
+      FILE *lf = fopen("/data/kodi-ps4/init.log","a");
+      if (lf){fprintf(lf, "piglet_module_load_failed=0x%x\n", piglet_mod);fflush(lf);fclose(lf);}
+      return false;
+    }
+    precomp_mod = sceKernelLoadStartModule(precompiledname, 0, nullptr, 0, nullptr, &mstart);
+    if ((int)precomp_mod < 0) {
+      FILE *lf = fopen("/data/kodi-ps4/init.log","a");
+      if (lf){fprintf(lf, "precomp_module_load_failed=0x%x\n", precomp_mod);fflush(lf);fclose(lf);}
+      return false;
+    }
+    FILE *lf2 = fopen("/data/kodi-ps4/init.log","a");
+    if (lf2){fprintf(lf2, "modules_ok piglet=0x%x precomp=0x%x\n", piglet_mod, precomp_mod);fflush(lf2);fclose(lf2);}
+  }
+
+  OrbisPglConfig config{};
+  OrbisPglWindow window{0, static_cast<khronos_uint32_t>(width_), static_cast<khronos_uint32_t>(height_), 0};
+
+
+  std::memset(&config, 0, sizeof(config));
+  config.size = sizeof(config);
+  config.flags = ORBIS_PGL_FLAGS_USE_COMPOSITE_EXT | ORBIS_PGL_FLAGS_USE_FLEXIBLE_MEMORY | 0x60;
+  config.processOrder = 1;
+  config.systemSharedMemorySize = 250 * 1024 * 1024;
+  config.videoSharedMemorySize = 512 * 1024 * 1024;
+  config.maxMappedFlexibleMemory = 170 * 1024 * 1024;
+  config.drawCommandBufferSize = 1 * 1024 * 1024;
+  config.lcueResourceBufferSize = 1 * 1024 * 1024;
+  config.dbgPosCmd_0x40 = width_;
+  config.dbgPosCmd_0x44 = height_;
+  config.dbgPosCmd_0x48 = 0;
+  config.dbgPosCmd_0x4C = 0;
+  config.unk_0x5C = 2;
+
+  if (!scePigletSetConfigurationVSH(&config)) {
+    FILE *lf = fopen("/data/kodi-ps4/init.log","a");
+    if (lf){fputs("piglet_config_fail\n",lf);fflush(lf);fclose(lf);}
+    return false;
+  }
+
+  const EGLint attribs[] = {
+      EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+      EGL_DEPTH_SIZE, 0, EGL_STENCIL_SIZE, 0, EGL_SAMPLE_BUFFERS, 0,
+      EGL_SAMPLES, 0, EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+      EGL_SURFACE_TYPE, EGL_WINDOW_BIT, EGL_NONE};
+
+  const EGLint ctxAttribs[] = {EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE};
+
+  const EGLint surfaceAttribs[] = {EGL_RENDER_BUFFER, EGL_BACK_BUFFER, EGL_NONE};
+
+  EGLDisplay found = EGL_NO_DISPLAY;
+  EGLint found_id = -1;
+  for (EGLint disp_id = 0; disp_id <= 7; ++disp_id) {
+    EGLDisplay tryd = eglGetDisplay((EGLNativeDisplayType)disp_id);
+    EGLint prev_err = eglGetError();
+    if (tryd != EGL_NO_DISPLAY) { found = tryd; found_id = disp_id; break; }
+    char tmp[96];
+    snprintf(tmp,sizeof(tmp)," EGL_GETDISPLAY_%d=0x%p ERR=0x%x\n",(int)disp_id,(void*)tryd,(unsigned)prev_err);
+    FILE*lf=fopen("/data/kodi-ps4/init.log","a");
+    if (lf){fputs(tmp,lf);fflush(lf);fclose(lf);}
+  }
+  EGLDisplay d = found;
+  if (d == EGL_NO_DISPLAY) { FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("egl_nodisplay_all\n",lf);fflush(lf);fclose(lf);} return false; }
+  {
+    FILE *lf=fopen("/data/kodi-ps4/init.log","a");
+    if (lf){char tmp[64]; snprintf(tmp,sizeof(tmp),"egl_display_ok id=%d ptr=0x%p\n",found_id,(void*)d); fputs(tmp,lf);fflush(lf);fclose(lf);}
+  }
+
+  EGLint major = 0, minor = 0;
+  if (!eglInitialize(d, &major, &minor)) { FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("egl_init_fail\n",lf);fflush(lf);fclose(lf);} return false; }
+  if (!eglBindAPI(EGL_OPENGL_ES_API)) return false;
+  eglSwapInterval(d, 0);
+
+  EGLConfig econfig = nullptr;
+  EGLint numConfigs = 0;
+  if (!eglChooseConfig(d, attribs, &econfig, 1, &numConfigs) || numConfigs < 1) return false;
+
+  EGLSurface surf = eglCreateWindowSurface(d, econfig, &window, surfaceAttribs);
+  if (surf == EGL_NO_SURFACE) { FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("egl_surface_fail\n",lf);fflush(lf);fclose(lf);} return false; }
+
+  EGLContext ctx = eglCreateContext(d, econfig, EGL_NO_CONTEXT, ctxAttribs);
+  if (ctx == EGL_NO_CONTEXT) { FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("egl_context_fail\n",lf);fflush(lf);fclose(lf);} return false; }
+
+  if (!eglMakeCurrent(d, surf, surf, ctx)) { FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("egl_makecurrent_fail\n",lf);fflush(lf);fclose(lf);} return false; }
+
+  display_ = (void*)d;
+  surface_ = (void*)surf;
+  context_ = (void*)ctx;
+
+  FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("renderer_init_ok\n",lf);fflush(lf);fclose(lf);}
+  initialized_ = true;
+  return true;
+#else
+  FILE*lf=fopen("/data/kodi-ps4/init.log","a"); if(lf){fputs("renderer_init_ok\n",lf);fflush(lf);fclose(lf);}
+  initialized_ = true;
+  return true;
+#endif
+}
+
+void PS4RendererGLES2::RenderFrame() {
+  if (!initialized_) return;
+#if defined(__ORBIS__) || defined(PS4)
+  EGLDisplay d = (EGLDisplay)display_;
+  EGLSurface s = (EGLSurface)surface_;
+  if (d == nullptr || s == nullptr) return;
+  glClearColor(1.0f, 0.0f, 0.0f, 1.0f);
+  glClear(GL_COLOR_BUFFER_BIT);
+  glFlush();
+  glFinish();
+  eglSwapBuffers(d, s);
+#endif
+}
+
+void PS4RendererGLES2::Shutdown() {
+#if defined(__ORBIS__) || defined(PS4)
+  EGLDisplay d = (EGLDisplay)display_;
+  if (d != nullptr) {
+    eglMakeCurrent(d, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (surface_) eglDestroySurface(d, (EGLSurface)surface_);
+    if (context_) eglDestroyContext(d, (EGLContext)context_);
+    eglTerminate(d);
+  }
+  display_ = nullptr;
+  surface_ = nullptr;
+  context_ = nullptr;
+#endif
+  initialized_ = false;
+}
+
+}  // namespace kodi::ps4
