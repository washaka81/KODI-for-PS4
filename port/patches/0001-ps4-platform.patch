+{
+namespace WINDOWING
+{
+namespace PS4
+{
+
+void CWinSystemPs4GLES::Register()
+{
+  CWindowSystemFactory::RegisterWindowSystem(CreateWinSystem, "ps4");
+}
+
+std::unique_ptr<CWinSystemBase> CWinSystemPs4GLES::CreateWinSystem()
+{
+  return std::make_unique<CWinSystemPs4GLES>();
+}
+
+#if defined(__ORBIS__)
+bool CWinSystemPs4GLES::InitDisplay()
+{
+  WriteStartupTrace("winsystem-initdisplay-begin");
+  m_eglDisplay = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+  WriteStartupTrace("winsystem-eglgetdisplay-done");
+  if (m_eglDisplay == EGL_NO_DISPLAY)
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglGetDisplay failed ({:#x})", eglGetError());
+    return false;
+  }
+
+  EGLint major = 0;
+  EGLint minor = 0;
+  if (!eglInitialize(m_eglDisplay, &major, &minor))
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglInitialize failed ({:#x})", eglGetError());
+    WriteStartupTrace("winsystem-eglinit-fail");
+    return false;
+  }
+  WriteStartupTrace("winsystem-eglinit-ok");
+  CLog::Log(LOGINFO, "CWinSystemPs4GLES: EGL {}.{} initialized", major, minor);
+
+  if (!eglBindAPI(EGL_OPENGL_ES_API))
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglBindAPI failed ({:#x})", eglGetError());
+    WriteStartupTrace("winsystem-eglbind-fail");
+    return false;
+  }
+  WriteStartupTrace("winsystem-eglbind-ok");
+  eglSwapInterval(m_eglDisplay, 0);
+  return true;
+}
+
+bool CWinSystemPs4GLES::CreateSurfaceAndContext()
+{
+  // The glshim EGL surface ignores the native window: it always owns the
+  // full 1920x1080 VideoOut buffer.  Keep an explicit no-MSAA config so the
+  // attributes match what Kodi expects.
+  const EGLint attribs[] = {EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8,
+                            EGL_ALPHA_SIZE, 8, EGL_DEPTH_SIZE, 0, EGL_STENCIL_SIZE, 0,
+                            EGL_SAMPLE_BUFFERS, 0, EGL_SAMPLES, 0,
+                            EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT, EGL_SURFACE_TYPE,
+                            EGL_WINDOW_BIT, EGL_NONE};
+  EGLint numConfigs = 0;
+  if (!eglChooseConfig(m_eglDisplay, attribs, &m_eglConfig, 1, &numConfigs) || numConfigs < 1)
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglChooseConfig failed ({:#x})", eglGetError());
+    WriteStartupTrace("winsystem-eglconfig-fail");
+    return false;
+  }
+  WriteStartupTrace("winsystem-eglconfig-ok");
+
+  {
+    EGLint id = 0, r = 0, g = 0, b = 0, a = 0, d = 0, st = 0, sb = 0, samples = 0;
+    EGLint rt = 0, surfaceType = 0;
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_CONFIG_ID, &id);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_RED_SIZE, &r);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_GREEN_SIZE, &g);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_BLUE_SIZE, &b);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_ALPHA_SIZE, &a);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_DEPTH_SIZE, &d);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_STENCIL_SIZE, &st);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_SAMPLE_BUFFERS, &sb);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_SAMPLES, &samples);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_RENDERABLE_TYPE, &rt);
+    eglGetConfigAttrib(m_eglDisplay, m_eglConfig, EGL_SURFACE_TYPE, &surfaceType);
+    char tag[160];
+    snprintf(tag, sizeof(tag),
+             "winsystem-eglcfg-id-%d-rgba-%d%d%d%d-d%d-s%d-ms%d-%d-rt-%x-st-%x", id, r, g, b,
+             a, d, st, sb, samples, rt, surfaceType);
+    WriteStartupTrace(tag);
+  }
+
+  const EGLint surfaceAttribs[] = {EGL_RENDER_BUFFER, EGL_BACK_BUFFER, EGL_NONE};
+  m_eglSurface = eglCreateWindowSurface(m_eglDisplay, m_eglConfig, (EGLNativeWindowType)0, surfaceAttribs);
+  if (m_eglSurface == EGL_NO_SURFACE)
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglCreateWindowSurface failed ({:#x})", eglGetError());
+    WriteStartupTrace("winsystem-eglsurface-fail");
+    return false;
+  }
+  WriteStartupTrace("winsystem-eglsurface-ok");
+
+  const EGLint contextAttribs[] = {EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE};
+  m_eglContext = eglCreateContext(m_eglDisplay, m_eglConfig, EGL_NO_CONTEXT, contextAttribs);
+  if (m_eglContext == EGL_NO_CONTEXT)
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglCreateContext failed ({:#x})", eglGetError());
+    WriteStartupTrace("winsystem-eglcontext-fail");
+    return false;
+  }
+  WriteStartupTrace("winsystem-eglcontext-ok");
+
+  if (!eglMakeCurrent(m_eglDisplay, m_eglSurface, m_eglSurface, m_eglContext))
+  {
+    CLog::Log(LOGERROR, "CWinSystemPs4GLES: eglMakeCurrent failed ({:#x})", eglGetError());
+    WriteStartupTrace("winsystem-eglmakecurrent-fail");
+    return false;
+  }
+  WriteStartupTrace("winsystem-eglmakecurrent-ok");
+
+  HideSystemSplashBeforeFirstFrame();
+  return true;
+}
+
+#endif // __ORBIS__
+
+bool CWinSystemPs4GLES::InitWindowSystem()
+{
+  if (!CWinSystemBase::InitWindowSystem())
+    return false;
+
+#if defined(__ORBIS__)
+  if (!InitDisplay())
+    return false;
+
+  const uint64_t videoOutCaps = glShimGetVideoOutCapability();
+  m_hdr10Supported = (videoOutCaps & 0x80) != 0;
+  CLog::Log(LOGINFO, "CWinSystemPs4GLES: HDR10 {} (VideoOut caps=0x{:x})",
+            m_hdr10Supported ? "supported" : "not supported", videoOutCaps);
+#endif
+  return true;
+}
+
+bool CWinSystemPs4GLES::IsHDRDisplay()
+{
+  return m_hdr10Supported;
+}
+
+CHDRCapabilities CWinSystemPs4GLES::GetDisplayHDRCapabilities() const
+{
+  CHDRCapabilities caps;
+  if (m_hdr10Supported)
+    caps.SetHDR10();
+  return caps;
+}
+
+void CWinSystemPs4GLES::UpdateResolutions()
+{
+  CWinSystemBase::UpdateResolutions();
+
+  RESOLUTION_INFO res{};
+  res.iWidth = 1920;
+  res.iHeight = 1080;
+  res.iScreenWidth = 1920;
+  res.iScreenHeight = 1080;
+  res.fRefreshRate = 59.94f;
+  res.dwFlags = 0;
+  res.bFullScreen = true;
+  res.strMode = "Full 1080p@60";
+
+  CServiceBroker::GetWinSystem()->GetGfxContext().ResetOverscan(res);
+  CDisplaySettings::GetInstance().AddResolutionInfo(res);
+  CDisplaySettings::GetInstance().GetResolutionInfo(RES_DESKTOP) = res;
+}
+
+bool CWinSystemPs4GLES::DestroyWindowSystem()
+{
+#if defined(__ORBIS__)
+  if (m_eglDisplay != EGL_NO_DISPLAY)
+  {
+    eglMakeCurrent(m_eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (m_eglSurface != EGL_NO_SURFACE)
+      eglDestroySurface(m_eglDisplay, m_eglSurface);
+    if (m_eglContext != EGL_NO_CONTEXT)
+      eglDestroyContext(m_eglDisplay, m_eglContext);
+    eglTerminate(m_eglDisplay);
+  }
+  m_eglSurface = EGL_NO_SURFACE;
+  m_eglContext = EGL_NO_CONTEXT;
+  m_eglDisplay = EGL_NO_DISPLAY;
+#endif
+  return CWinSystemBase::DestroyWindowSystem();
+}
+
+bool CWinSystemPs4GLES::CreateNewWindow(const std::string& name, bool fullScreen,
+                                        RESOLUTION_INFO& res)
+{
+  (void)name;
+
+  m_width = res.iWidth ? res.iWidth : 1920;
+  m_height = res.iHeight ? res.iHeight : 1080;
+
+#if defined(__ORBIS__)
+  if (!CreateSurfaceAndContext())
+    return false;
+  WriteStartupTrace("winsystem-window-ok");
+
+  res.iScreenWidth = res.iWidth;
+  res.iScreenHeight = res.iHeight;
+  res.bFullScreen = true;
+  res.fRefreshRate = res.fRefreshRate > 0.0f ? res.fRefreshRate : 59.94f;
+
+#endif
+
+  m_bWindowCreated = true;
+  return true;
+}
+
+bool CWinSystemPs4GLES::DestroyWindow()
+{
+  m_bWindowCreated = false;
+  return true;
+}
+
+bool CWinSystemPs4GLES::ResizeWindow(int newWidth, int newHeight, int newLeft, int newTop)
+{
+  (void)newLeft;
+  (void)newTop;
+  m_width = newWidth;
+  m_height = newHeight;
+  return true;
+}
+
+bool CWinSystemPs4GLES::SetFullScreen(bool fullScreen, RESOLUTION_INFO& res,
+                                      bool blankOtherDisplays)
+{
+  (void)fullScreen;
+  (void)blankOtherDisplays;
+  if (res.iWidth)
+  {
+    m_width = res.iWidth;
+    m_height = res.iHeight;
+  }
+  return true;
+}
+
+void CWinSystemPs4GLES::NotifyAppFocusChange(bool bGaining)
+{
+  (void)bGaining;
+}
+
+void CWinSystemPs4GLES::NotifyAppActiveChange(bool bActivated)
+{
+  (void)bActivated;
+}
+
+void CWinSystemPs4GLES::ShowOSMouse(bool show)
+{
+  (void)show;
+}
+
+void CWinSystemPs4GLES::FinishModeChange(RESOLUTION res)
+{
+  (void)res;
+}
+
+void CWinSystemPs4GLES::SetDirtyRegions(const CDirtyRegionList& dirtyRegionsList)
+{
+  (void)dirtyRegionsList;
+}
+
+void CWinSystemPs4GLES::Register(IDispResource* resource)
+{
+  (void)resource;
+}
+
+void CWinSystemPs4GLES::Unregister(IDispResource* resource)
+{
+  (void)resource;
+}
+
+std::unique_ptr<CVideoSync> CWinSystemPs4GLES::GetVideoSync(CVideoReferenceClock* clock)
+{
+  return std::make_unique<CVideoSyncPs4>(clock);
+}
+
+void CWinSystemPs4GLES::SetVSyncImpl(bool enable)
+{
+  (void)enable;
+#if defined(__ORBIS__)
+  // The VideoOut flip is synchronous; keep the interval at 0.
+  if (m_eglDisplay != EGL_NO_DISPLAY)
+    eglSwapInterval(m_eglDisplay, 0);
+#endif
+}
+
+void CWinSystemPs4GLES::PresentRenderImpl(bool rendered)
+{
+  (void)rendered;
+#if defined(__ORBIS__)
+  WriteFrameTrace("app-present-begin");
+  if (m_eglDisplay != EGL_NO_DISPLAY && m_eglSurface != EGL_NO_SURFACE)
+  {
+    EGLint sw = 0, sh = 0;
+    const EGLSurface cur = eglGetCurrentSurface(EGL_DRAW);
+    const EGLContext ctx = eglGetCurrentContext();
+    eglQuerySurface(m_eglDisplay, m_eglSurface, EGL_WIDTH, &sw);
+    eglQuerySurface(m_eglDisplay, m_eglSurface, EGL_HEIGHT, &sh);
+    char tag[128];
+    snprintf(tag, sizeof(tag), "app-present-surface-match-%d-ctx-%d-size-%dx%d",
+             cur == m_eglSurface ? 1 : 0, ctx == m_eglContext ? 1 : 0, sw, sh);
+    WriteFrameTrace(tag);
+    const EGLBoolean ok = eglSwapBuffers(m_eglDisplay, m_eglSurface);
+    char rtag[80];
+    snprintf(rtag, sizeof(rtag), "app-present-result-%d-err-%04x", ok ? 1 : 0,
+             eglGetError());
+    WriteFrameTrace(rtag);
+  }
+  WriteFrameTrace("app-present-swapped");
+#endif
+}
