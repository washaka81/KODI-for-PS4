diff --git a/xbmc/platform/ps4/CPadPS4.cpp b/xbmc/platform/ps4/CPadPS4.cpp
new file mode 100644
index 0000000000..538cb10e88
--- /dev/null
+++ b/xbmc/platform/ps4/CPadPS4.cpp
@@ -0,0 +1,147 @@
+#include "CPadPS4.h"
+
+#include "ServiceBroker.h"
+#include "input/InputManager.h"
+#include "input/keyboard/Key.h"
+#include "input/keymaps/keyboard/KeyIDs.h"
+#include "utils/TimeUtils.h"
+#include "utils/log.h"
+
+#include <cmath>
+
+namespace kodi::ps4 {
+namespace {
+
+constexpr uint64_t INITIAL_REPEAT_MS = 400;
+constexpr uint64_t REPEAT_MS = 120;
+constexpr float STICK_DEADZONE = 0.6f;
+/* Only report pad work that can explain a dropped frame. */
+constexpr uint64_t SLOW_PAD_US = 50000;
+
+// steady_clock tracks CPU time on Orbis, not wall time; use the same
+// CLOCK_MONOTONIC_RAW source as the rest of the port.
+uint64_t NowMs() {
+  return static_cast<uint64_t>(CurrentHostCounter() / 1000000);
+}
+
+uint64_t NowUs() {
+  return static_cast<uint64_t>(CurrentHostCounter() / 1000);
+}
+
+void InjectKey(uint32_t button, bool pressed) {
+  const CKey key(button);
+  CInputManager& input = CServiceBroker::GetInputManager();
+  const uint64_t start_us = NowUs();
+  // Queue the edge for CInputManager::Process(); doing OnKey() here would
+  // execute the action (and any synchronous window transition) inside the
+  // pad poll and charge it to the "pad" frame phase.
+  input.QueueKey(key, pressed);
+  const uint64_t elapsed_us = NowUs() - start_us;
+  if (elapsed_us >= SLOW_PAD_US)
+    CLog::Log(LOGINFO, "PS4 pad: queue key=0x{:x} pressed={} {:.2f} ms", button, pressed,
+              elapsed_us / 1000.0);
+}
+
+}  // namespace
+
+bool CPadPS4::Initialize() {
+  const bool ok = input_.Initialize();
+  CLog::Log(LOGINFO, "PS4Input: controller subsystem {}", ok ? "ready" : "unavailable");
+  return ok;
+}
+
+void CPadPS4::Emit(uint32_t button, bool pressed, bool& previous) {
+  if (pressed == previous)
+    return;
+  previous = pressed;
+  InjectKey(button, pressed);
+}
+
+void CPadPS4::EmitDirection(bool pressed,
+                            bool& previous,
+                            uint64_t& next_repeat,
+                            uint32_t button,
+                            uint64_t now) {
+  if (pressed) {
+    if (!previous) {
+      previous = true;
+      next_repeat = now + INITIAL_REPEAT_MS;
+      InjectKey(button, true);
+    } else if (now >= next_repeat) {
+      next_repeat = now + REPEAT_MS;
+      InjectKey(button, true);
+    }
+  } else if (previous) {
+    previous = false;
+    InjectKey(button, false);
+  }
+}
+
+void CPadPS4::ReleaseAll(uint64_t now) {
+  EmitDirection(false, up_, next_up_, KEY_BUTTON_DPAD_UP, now);
+  EmitDirection(false, down_, next_down_, KEY_BUTTON_DPAD_DOWN, now);
+  EmitDirection(false, left_, next_left_, KEY_BUTTON_DPAD_LEFT, now);
+  EmitDirection(false, right_, next_right_, KEY_BUTTON_DPAD_RIGHT, now);
+  Emit(KEY_BUTTON_A, false, confirm_);
+  Emit(KEY_BUTTON_B, false, back_);
+  Emit(KEY_BUTTON_START, false, play_pause_);
+  Emit(KEY_BUTTON_WHITE, false, context_menu_);
+  Emit(KEY_BUTTON_LEFT_ANALOG_TRIGGER, false, page_up_);
+  Emit(KEY_BUTTON_RIGHT_ANALOG_TRIGGER, false, page_down_);
+}
+
+void CPadPS4::Poll() {
+  const uint64_t poll_start_us = NowUs();
+  input_.Poll();
+  const PS4InputState state = input_.State();
+  const uint64_t read_us = input_.LastReadUs();
+  const uint64_t now = NowMs();
+
+  if (!state.connected) {
+    const uint64_t inject_start_us = NowUs();
+    ReleaseAll(now);
+    const uint64_t total_us = NowUs() - poll_start_us;
+    if (total_us >= SLOW_PAD_US)
+      CLog::Log(LOGINFO, "PS4 pad: read {:.2f} inject {:.2f} total {:.2f} ms (disconnected)",
+                read_us / 1000.0, (NowUs() - inject_start_us) / 1000.0,
+                total_us / 1000.0);
+    return;
+  }
+
+  // If the d-pad is used, ignore the stick so a resting stick cannot fight
+  // an explicit direction.  Otherwise use the dominant stick axis with a
+  // deadzone.
+  const bool dpad = state.up || state.down || state.left || state.right;
+  const float ax = std::fabs(state.stick_x);
+  const float ay = std::fabs(state.stick_y);
+  const bool stick_up = !dpad && ay > STICK_DEADZONE && ay >= ax && state.stick_y > 0.0f;
+  const bool stick_down = !dpad && ay > STICK_DEADZONE && ay >= ax && state.stick_y < 0.0f;
+  const bool stick_left = !dpad && ax > STICK_DEADZONE && ax > ay && state.stick_x < 0.0f;
+  const bool stick_right = !dpad && ax > STICK_DEADZONE && ax > ay && state.stick_x > 0.0f;
+
+  const uint64_t inject_start_us = NowUs();
+  EmitDirection(state.up || stick_up, up_, next_up_, KEY_BUTTON_DPAD_UP, now);
+  EmitDirection(state.down || stick_down, down_, next_down_, KEY_BUTTON_DPAD_DOWN, now);
+  EmitDirection(state.left || stick_left, left_, next_left_, KEY_BUTTON_DPAD_LEFT, now);
+  EmitDirection(state.right || stick_right, right_, next_right_, KEY_BUTTON_DPAD_RIGHT, now);
+
+  Emit(KEY_BUTTON_A, state.confirm, confirm_);
+  Emit(KEY_BUTTON_B, state.back, back_);
+  Emit(KEY_BUTTON_START, state.play_pause, play_pause_);
+  Emit(KEY_BUTTON_WHITE, state.context_menu, context_menu_);
+  Emit(KEY_BUTTON_LEFT_ANALOG_TRIGGER, state.page_up, page_up_);
+  Emit(KEY_BUTTON_RIGHT_ANALOG_TRIGGER, state.page_down, page_down_);
+
+  const uint64_t inject_us = NowUs() - inject_start_us;
+  const uint64_t total_us = NowUs() - poll_start_us;
+  if (total_us >= SLOW_PAD_US)
+    CLog::Log(LOGINFO, "PS4 pad: read {:.2f} inject {:.2f} total {:.2f} ms", read_us / 1000.0,
+              inject_us / 1000.0, total_us / 1000.0);
+}
+
+void CPadPS4::Shutdown() {
+  ReleaseAll(NowMs());
+  input_.Shutdown();
+}
+
+}  // namespace kodi::ps4
