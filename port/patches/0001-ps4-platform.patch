diff --git a/xbmc/platform/ps4/CAESinkPS4.cpp b/xbmc/platform/ps4/CAESinkPS4.cpp
new file mode 100644
index 0000000000..ca0169d15f
--- /dev/null
+++ b/xbmc/platform/ps4/CAESinkPS4.cpp
@@ -0,0 +1,155 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "CAESinkPS4.h"
+
+#include "cores/AudioEngine/AESinkFactory.h"
+#include "cores/AudioEngine/Utils/AEUtil.h"
+#include "utils/TimeUtils.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <chrono>
+#include <thread>
+
+using namespace std::chrono_literals;
+
+namespace
+{
+constexpr auto DEFAULT_PERIOD_TIME = 50ms;
+} // namespace
+
+namespace kodi::ps4
+{
+
+void CAESinkPS4::Register()
+{
+  AE::AESinkRegEntry entry;
+  entry.sinkName = "PS4";
+  entry.createFunc = CAESinkPS4::Create;
+  entry.enumerateFunc = CAESinkPS4::EnumerateDevicesEx;
+  entry.cleanupFunc = CAESinkPS4::Cleanup;
+  AE::CAESinkFactory::RegisterSink(entry);
+}
+
+std::unique_ptr<IAESink> CAESinkPS4::Create(std::string& device, AEAudioFormat& desiredFormat)
+{
+  auto sink = std::make_unique<CAESinkPS4>();
+  if (sink->Initialize(desiredFormat, device))
+    return sink;
+
+  return {};
+}
+
+void CAESinkPS4::EnumerateDevicesEx(AEDeviceInfoList& list, bool force)
+{
+  (void)force;
+
+  CAEDeviceInfo info;
+  info.m_deviceName = "ps4";
+  info.m_displayName = "PS4";
+  info.m_deviceType = AE_DEVTYPE_PCM;
+  info.m_channels = AE_CH_LAYOUT_2_0;
+  info.m_sampleRates = {48000};
+  info.m_dataFormats = {AE_FMT_S16NE, AE_FMT_FLOAT};
+  list.push_back(info);
+}
+
+void CAESinkPS4::Cleanup() {}
+
+bool CAESinkPS4::Initialize(AEAudioFormat& format, std::string& device)
+{
+  (void)device;
+  m_format = format;
+
+  if (m_format.m_sampleRate == 0)
+  {
+    CLog::LogF(LOGERROR, "PS4 audio: invalid sample rate");
+    return false;
+  }
+
+  if (m_format.m_dataFormat == AE_FMT_RAW)
+    m_format.m_dataFormat = AE_FMT_S16NE;
+
+  if (m_format.m_frameSize == 0)
+  {
+    m_format.m_frameSize =
+        m_format.m_channelLayout.Count() * (CAEUtil::DataFormatToBits(m_format.m_dataFormat) >> 3);
+    if (m_format.m_frameSize == 0)
+    {
+      CLog::LogF(LOGERROR, "PS4 audio: invalid frame size");
+      return false;
+    }
+  }
+
+  if (m_format.m_frames == 0)
+  {
+    m_format.m_frames = static_cast<unsigned int>(
+        m_format.m_sampleRate * std::chrono::duration<double>(DEFAULT_PERIOD_TIME).count());
+  }
+
+  format = m_format;
+  m_bufferLevel = 0s;
+  m_lastUpdateUs = CurrentHostCounter() / 1000;
+
+  m_sink.Initialize(m_format.m_sampleRate, m_format.m_channelLayout.Count());
+  CLog::LogF(LOGINFO, "PS4 audio: sink opened at {} Hz, {} channels", m_format.m_sampleRate,
+             m_format.m_channelLayout.Count());
+  return true;
+}
+
+void CAESinkPS4::Deinitialize()
+{
+  m_sink.Shutdown();
+}
+
+void CAESinkPS4::UpdateBufferLevel()
+{
+  const int64_t nowUs = CurrentHostCounter() / 1000;
+  m_bufferLevel -=
+      std::chrono::duration<double>(static_cast<double>(nowUs - m_lastUpdateUs) / 1000000.0);
+  m_bufferLevel = std::max(m_bufferLevel, std::chrono::duration<double>::zero());
+  m_lastUpdateUs = nowUs;
+}
+
+unsigned int CAESinkPS4::AddPackets(uint8_t** data, unsigned int frames, unsigned int offset)
+{
+  UpdateBufferLevel();
+
+  const std::chrono::duration<double> duration(static_cast<double>(frames) /
+                                               m_format.m_sampleRate);
+  if (m_bufferLevel + duration > m_cacheTotal)
+  {
+    std::this_thread::sleep_for(m_bufferLevel + duration - m_cacheTotal);
+    UpdateBufferLevel();
+  }
+  m_bufferLevel += duration;
+
+  if (data && data[0] && frames > 0)
+  {
+    const size_t bytes = static_cast<size_t>(frames) * m_format.m_frameSize;
+    m_sink.Submit(data[0] + static_cast<size_t>(offset) * m_format.m_frameSize, bytes);
+  }
+
+  return frames;
+}
+
+void CAESinkPS4::GetDelay(AEDelayStatus& status)
+{
+  UpdateBufferLevel();
+  status.SetDelay((m_bufferLevel + m_latency).count());
+}
+
+void CAESinkPS4::Drain()
+{
+  UpdateBufferLevel();
+  std::this_thread::sleep_for(m_bufferLevel);
+  UpdateBufferLevel();
+}
+
+} // namespace kodi::ps4
