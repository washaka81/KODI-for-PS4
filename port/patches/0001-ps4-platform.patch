+static bool HideSystemSplash(const char* where)
+{
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_SYSTEM_SERVICE);
+  const int rc = sceSystemServiceHideSplashScreen();
+  char tag[80];
+  snprintf(tag, sizeof(tag), "winsystem-splash-hide-%s-%d", where, rc);
+  WriteStartupTrace(tag);
+  return rc >= 0;
+}
+
+// Hide the system splash before Kodi draws its first frame.  The old
+// green first-frame probe (120 clears/swaps) was only needed while
+// validating the Piglet/EGL surface; with the GNM shim it just delayed the
+// real splash and painted the screen green, so it is gone.
+static void HideSystemSplashBeforeFirstFrame()
+{
+  HideSystemSplash("first-frame");
+  WriteStartupTrace("ps4-first-frame-splash-hidden");
+}
+#endif
+
