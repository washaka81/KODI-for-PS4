diff --git a/xbmc/platform/ps4/PS4ShaderBin.cpp b/xbmc/platform/ps4/PS4ShaderBin.cpp
new file mode 100644
index 0000000000..c3515a142c
--- /dev/null
+++ b/xbmc/platform/ps4/PS4ShaderBin.cpp
@@ -0,0 +1,137 @@
+/*
+ *  Copyright (C) 2026 OpenOrbis/Kodi PS4 port
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "platform/ps4/PS4ShaderBin.h"
+
+#if defined(__ORBIS__)
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include <GLES2/gl2.h>
+
+#include "filesystem/File.h"
+#include "utils/StartupTrace.h"
+#include "utils/log.h"
+
+namespace {
+
+unsigned int HashBuf(const char* buf, unsigned int len)
+{
+  unsigned int h = 5381;
+  for (unsigned int i = 0; i < len; i++)
+    h = ((h << 5) + h) + static_cast<unsigned char>(buf[i]);
+  return h;
+}
+
+int g_variant = -1;
+
+void LogVariant(int variant)
+{
+  char tag[48];
+  snprintf(tag, sizeof(tag), "ps4-shaderbin-variant-%d", variant);
+  WriteStartupTrace(tag);
+}
+
+int ShaderVariant()
+{
+  if (g_variant >= 0)
+    return g_variant;
+
+  g_variant = 0;
+  FILE* f = fopen("/data/kodi-ps4/shader-variant.txt", "r");
+  if (f)
+  {
+    int v = 0;
+    if (fscanf(f, "%d", &v) == 1 && v >= 0 && v <= 9)
+      g_variant = v;
+    fclose(f);
+  }
+
+  LogVariant(g_variant);
+  return g_variant;
+}
+
+std::string BlobPath(unsigned int hash)
+{
+  char name[16];
+  snprintf(name, sizeof(name), "%08x.bin", hash);
+  const int variant = ShaderVariant();
+  if (variant == 0)
+    return "special://xbmc/system/shaders/bin/" + std::string(name);
+  return "special://xbmc/system/shaders/bin/v" + std::to_string(variant) + "/" +
+         std::string(name);
+}
+
+} // unnamed namespace
+
+extern "C" void PS4_SetShaderVariant(int variant)
+{
+  if (variant < 0 || variant > 9)
+    variant = 0;
+  g_variant = variant;
+  LogVariant(g_variant);
+}
+
+bool PS4_LoadShaderBinary(unsigned int shader, const char* src, unsigned int srcLen,
+                          unsigned int /*shaderType*/, unsigned int* outHash)
+{
+  const unsigned int hash = HashBuf(src, srcLen);
+
+  XFILE::CFile file;
+  const std::string path = BlobPath(hash);
+  if (!file.Open(path))
+  {
+    char tag[48];
+    snprintf(tag, sizeof(tag), "ps4-shaderbin-missing-%08x", hash);
+    WriteStartupTrace(tag);
+    if (outHash)
+      *outHash = hash;
+    return false;
+  }
+  WriteStartupTrace("ps4-shaderbin-open");
+
+  // PS4's fstat() lies about file sizes (same bug worked around in the
+  // SQLite VFS), so GetLength() is not trustworthy: read until EOF.
+  std::string raw;
+  {
+    char chunk[4096];
+    int n;
+    while ((n = file.Read(chunk, sizeof(chunk))) > 0)
+      raw.append(chunk, static_cast<size_t>(n));
+  }
+  file.Close();
+  const unsigned int rawSize = static_cast<unsigned int>(raw.size());
+  if (rawSize <= sizeof(unsigned int))
+  {
+    if (outHash)
+      *outHash = hash;
+    return false;
+  }
+
+  unsigned int format = 0;
+  std::memcpy(&format, raw.data(), sizeof(format));
+  const int blobSize = static_cast<int>(rawSize - sizeof(format));
+
+  char tag[64];
+  snprintf(tag, sizeof(tag), "ps4-shaderbin-size-%d-fmt-%04x", blobSize, format);
+  WriteStartupTrace(tag);
+
+  WriteStartupTrace("ps4-shaderbin-pre-gl");
+  while (glGetError() != GL_NO_ERROR)
+  {
+  }
+  glShaderBinary(1, &shader, 0, raw.data() + sizeof(format), blobSize);
+  snprintf(tag, sizeof(tag), "ps4-shaderbin-post-%04x", glGetError());
+  WriteStartupTrace(tag);
+  WriteStartupTrace("ps4-shaderbin-glcalled");
+  return true;
+}
+
+#endif // __ORBIS__
diff --git a/xbmc/platform/ps4/PS4ShaderBin.h b/xbmc/platform/ps4/PS4ShaderBin.h
new file mode 100644
index 0000000000..c53efcf062
--- /dev/null
+++ b/xbmc/platform/ps4/PS4ShaderBin.h
@@ -0,0 +1,45 @@
+/*
+ *  Copyright (C) 2026 OpenOrbis/Kodi PS4 port
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+
+#if defined(__ORBIS__)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Piglet has no runtime GLSL compiler, so GLSL shaders must ship as
+ * precompiled Piglet Shader Binary blobs (glShaderBinary). Blobs are keyed
+ * by a djb2 hash of the final shader source (prefix included), exactly like
+ * the ioQuake3-PS4 scheme; the blob layout is
+ *   [GLenum format][Piglet container]
+ * with the container embedding the original GLSL source and the compiled
+ * PSB section.
+ *
+ * LoadShaderBinary hashes `src`, looks for
+ * special://xbmc/system/shaders/bin/<hash>.bin and hands the blob to
+ * glShaderBinary. Returns true if a blob was found and passed to GL; the
+ * caller still checks GL_COMPILE_STATUS the normal way. When it returns
+ * false, *outHash holds the missing hash so the log can name it.
+ */
+bool PS4_LoadShaderBinary(unsigned int shader, const char* src, unsigned int srcLen,
+                          unsigned int shaderType, unsigned int* outHash);
+
+/* A/B experiment hook: 0 = bin/, 1..9 = bin/v<N>/.  The override wins over
+ * /data/kodi-ps4/shader-variant.txt for the rest of the process. */
+void PS4_SetShaderVariant(int variant);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // __ORBIS__
diff --git a/xbmc/platform/ps4/PlatformFreebsd.cpp b/xbmc/platform/ps4/PlatformFreebsd.cpp
new file mode 100644
index 0000000000..7bcdd13e50
--- /dev/null
+++ b/xbmc/platform/ps4/PlatformFreebsd.cpp
@@ -0,0 +1,349 @@
+/*
+ *  Copyright (C) 2016-2018 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "PlatformPs4.h"
+
+#include "ServiceBroker.h"
+#include "application/AppParams.h"
+#include "utils/StringUtils.h"
+
+#include "platform/ps4/OptionalsReg.h"
+#include "utils/StartupTrace.h"
+#include "windowing/ps4/WinSystemPs4GLES.h"
+#include "platform/ps4/CAESinkPS4.h"
+#include "platform/ps4/CPadPS4.h"
+#include "platform/linux/powermanagement/LinuxPowerSyscall.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <csignal>
+#include <cstdint>
+#include <cstring>
+#include <exception>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace
+{
+// Counts how many times the canary ran.  The canary is copied into several
+// places of the init array when the binary is patched, so the number tells
+// which constructor was running when the process died.
+int g_ctorCount = 0;
+
+// Descriptor of the trace file, kept open so the signal handler can write
+// to it without touching the stdio buffers.
+int g_traceFd = -1;
+
+// Writes a marker so a crash during the start up can be located.  The
+// constructor runs before any other one, so it tells if the failure happens
+// before main.
+void WriteCanary(const char* stage)
+{
+  size_t length = strlen(stage);
+  if (g_traceFd >= 0)
+  {
+    ssize_t written = write(g_traceFd, stage, length);
+    (void)written;
+    written = write(g_traceFd, "\n", 1);
+    (void)written;
+    return;
+  }
+
+  FILE* f = fopen("/data/kodi-ps4/core-canary.log", "a");
+  if (f)
+  {
+    fprintf(f, "%s\n", stage);
+    fclose(f);
+  }
+}
+
+void WriteCrashLine(const char* buffer, int length)
+{
+  if (length <= 0)
+    return;
+
+  int fd = g_traceFd;
+  if (fd < 0)
+    fd = open("/data/kodi-ps4/core-canary.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
+  if (fd >= 0)
+  {
+    ssize_t written = write(fd, buffer, length);
+    (void)written;
+    if (fd != g_traceFd)
+      close(fd);
+  }
+}
+
+void CrashHandlerSimple(int sig);
+
+bool IsSignalFrameValid(int sig, const siginfo_t* info, const void* context)
+{
+  if (!info || !context)
+    return false;
+
+  const uintptr_t frame = reinterpret_cast<uintptr_t>(__builtin_frame_address(0));
+  const uintptr_t infoAddress = reinterpret_cast<uintptr_t>(info);
+  const uintptr_t contextAddress = reinterpret_cast<uintptr_t>(context);
+  if (infoAddress < frame - 0x10000 || infoAddress > frame + 0x10000)
+    return false;
+  if (contextAddress < frame - 0x10000 || contextAddress > frame + 0x10000)
+    return false;
+  if ((infoAddress & 7) != 0 || (contextAddress & 7) != 0)
+    return false;
+
+  return info->si_signo == sig;
+}
+
+// Records the signal and the address that caused it, so the crash can be
+// mapped back to a function with addr2line.
+void CrashHandler(int sig, siginfo_t* info, void* context)
+{
+  if (!IsSignalFrameValid(sig, info, context))
+  {
+    char buffer[64];
+    int length = snprintf(buffer, sizeof(buffer), "crash-noctx signal=%d\n", sig);
+    WriteCrashLine(buffer, length);
+    CrashHandlerSimple(sig);
+    return;
+  }
+
+  const auto* uc = static_cast<const ucontext_t*>(context);
+  const unsigned long* mc = reinterpret_cast<const unsigned long*>(&uc->uc_mcontext);
+
+  char buffer[1024];
+  // The kernel uses the FreeBSD mcontext layout even though the SDK declares
+  // the Linux one: the RIP is the slot 23 and the RSP the slot 26.
+  int length = snprintf(buffer, sizeof(buffer),
+                        "crash signal=%d code=%d addr=%p fbrip=%lx fbrsp=%lx "
+                        "muslrip=%lx muslrsp=%lx mc=",
+                        sig, info->si_code, info->si_addr, mc[23], mc[26], mc[16],
+                        mc[15]);
+  for (int i = 0; i < 32 && length > 0 &&
+                  length < static_cast<int>(sizeof(buffer)) - 20;
+       ++i)
+    length += snprintf(buffer + length, sizeof(buffer) - length, "%lx,", mc[i]);
+  if (length > 0 && length < static_cast<int>(sizeof(buffer)) - 1)
+    buffer[length++] = '\n';
+  WriteCrashLine(buffer, length);
+
+  char stackBuffer[2048];
+  int stackLength = snprintf(stackBuffer, sizeof(stackBuffer), "stack=");
+  const auto* sp = reinterpret_cast<const unsigned long*>(mc[26]);
+  for (int i = 0; i < 192 && stackLength > 0 &&
+                  stackLength < static_cast<int>(sizeof(stackBuffer)) - 20;
+       ++i)
+  {
+    stackLength += snprintf(stackBuffer + stackLength, sizeof(stackBuffer) - stackLength, "%lx,",
+                            sp[i]);
+  }
+  if (stackLength > 0 && stackLength < static_cast<int>(sizeof(stackBuffer)) - 1)
+    stackBuffer[stackLength++] = '\n';
+  WriteCrashLine(stackBuffer, stackLength);
+
+  signal(sig, SIG_DFL);
+  raise(sig);
+}
+
+// The PS4 only dispatches the plain signal() handlers, which do not receive
+// the context. The kernel still leaves the signal frame (with the saved
+// registers) right above the handler frame, so it is dumped to find the PC.
+void CrashHandlerSimple(int sig)
+{
+  char buffer[32];
+  int length = snprintf(buffer, sizeof(buffer), "crash signal=%d stack=", sig);
+  if (length > 0 && g_traceFd >= 0)
+    write(g_traceFd, buffer, length);
+
+  const auto* sp = static_cast<const unsigned long*>(__builtin_frame_address(0));
+  for (int i = 0; i < 512 && g_traceFd >= 0; ++i)
+  {
+    int len = snprintf(buffer, sizeof(buffer), "%lx,", sp[i]);
+    if (len > 0)
+      write(g_traceFd, buffer, len);
+  }
+  if (g_traceFd >= 0)
+    write(g_traceFd, "\n", 1);
+
+  signal(sig, SIG_DFL);
+  raise(sig);
+}
+
+void InstallCrashHandler()
+{
+  struct sigaction action = {};
+  // The SDK declares the union members with a leading underscore.
+  action.__sa_handler.__sa_sigaction = CrashHandler;
+  // SA_SIGINFO has the FreeBSD value in the PS4 kernel (4 is not honoured).
+  action.sa_flags = 0x40;
+  sigemptyset(&action.sa_mask);
+
+  char buffer[48];
+  for (int sig : {SIGSEGV, SIGILL, SIGBUS, SIGFPE, SIGABRT})
+  {
+    signal(sig, CrashHandlerSimple);
+    int result = sigaction(sig, &action, nullptr);
+    int length = snprintf(buffer, sizeof(buffer), "sigaction-%d=%d", sig, result);
+    WriteCrashLine(buffer, length);
+  }
+}
+
+// Records the exception that aborted the process.  The message of the
+// exception is what tells why the start up failed, and the process dies
+// without any output on the PS4.
+void TerminateHandler()
+{
+  try
+  {
+    std::rethrow_exception(std::current_exception());
+  }
+  catch (const std::exception& e)
+  {
+    WriteCanary(e.what());
+  }
+  catch (...)
+  {
+    WriteCanary("terminate: unknown exception");
+  }
+
+  std::abort();
+}
+
+__attribute__((constructor(101))) void CanaryConstructors()
+{
+  g_traceFd = open("/data/kodi-ps4/core-canary.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
+  if (g_traceFd >= 0)
+  {
+    const off_t size = lseek(g_traceFd, 0, SEEK_END);
+    if (size > 8 * 1024 * 1024)
+      (void)ftruncate(g_traceFd, 0);
+  }
+  std::set_terminate(TerminateHandler);
+
+  char buffer[96];
+  snprintf(buffer, sizeof(buffer), "self=%p data=%p", &CanaryConstructors, &g_traceFd);
+  WriteCanary(buffer);
+
+  snprintf(buffer, sizeof(buffer), "ctor-%d", ++g_ctorCount);
+  WriteCanary(buffer);
+
+  InstallCrashHandler();
+  WriteCanary("ctor-handler");
+}
+} // namespace
+
+void InstallPS4CrashHandler()
+{
+  InstallCrashHandler();
+  std::set_terminate(TerminateHandler);
+}
+
+void WriteStartupTrace(const char* stage)
+{
+  WriteCanary(stage);
+}
+
+void WriteFrameTrace(const char* stage)
+{
+  static const bool enabled = getenv("PS4_FRAME_TRACE") != nullptr;
+  if (enabled)
+    WriteCanary(stage);
+}
+
+void PreparePS4Environment()
+{
+  // The PS4 does not set HOME, the Kodi profile is kept next to the
+  // application data.
+  if (!getenv("HOME"))
+    setenv("HOME", "/data/kodi-ps4", 1);
+
+  // The resources of the application (skins, system files) are shipped in
+  // the package and mounted read only.  Kodi looks for them before the
+  // platform is initialised, so the variable has to be set from main().
+  if (!getenv("KODI_HOME"))
+    setenv("KODI_HOME", "/app0/media/kodi", 1);
+}
+
+CPlatform* CPlatform::CreateInstance()
+{
+  return new CPlatformPs4();
+}
+
+bool CPlatformPs4::InitStageOne()
+{
+  WriteCanary("main");
+
+  PreparePS4Environment();
+  WriteStartupTrace("platform-env");
+
+  if (!CPlatformPosix::InitStageOne())
+  {
+    WriteStartupTrace("platform-posix-fail");
+    return false;
+  }
+  WriteStartupTrace("platform-posix-done");
+
+  setenv("OS", "Linux", true); // for python scripts that check the OS
+
+#if defined(HAS_GLES)
+  KODI::WINDOWING::PS4::CWinSystemPs4GLES::Register();
+#endif
+  WriteStartupTrace("platform-window-done");
+
+  CLinuxPowerSyscall::Register();
+  WriteStartupTrace("platform-power-done");
+
+  std::string_view sink = CServiceBroker::GetAppParams()->GetAudioBackend();
+  WriteStartupTrace("platform-audio-begin");
+
+  if (sink == "ps4" || sink.empty())
+  {
+    // PS4 PCM audio goes through CAESinkPS4 (sceAudioOut) / CPadPS4 input;
+    // intentionally no ALSA, PulseAudio, OSS, or sndio registration here.
+    kodi::ps4::CAESinkPS4::Register();
+  }
+  else if (sink == "alsa")
+  {
+    OPTIONALS::ALSARegister();
+  }
+  else if (sink == "pulseaudio")
+  {
+    OPTIONALS::PulseAudioRegister(true);
+  }
+  else if (sink == "oss")
+  {
+    OPTIONALS::OSSRegister();
+  }
+  else if (sink == "sndio")
+  {
+    OPTIONALS::SndioRegister();
+  }
+  else if (sink == "alsa+pulseaudio")
+  {
+    OPTIONALS::ALSARegister();
+    OPTIONALS::PulseAudioRegister(true);
+  }
+  else
+  {
+    if (!OPTIONALS::PulseAudioRegister(false))
+    {
+      if (!OPTIONALS::ALSARegister())
+      {
+        if (!OPTIONALS::SndioRegister())
+        {
+          OPTIONALS::OSSRegister();
+        }
+      }
+    }
+  }
+  WriteStartupTrace("platform-audio-done");
+
+  m_lirc.reset(OPTIONALS::LircRegister());
+  WriteStartupTrace("platform-lirc-done");
+
+  return true;
+}
