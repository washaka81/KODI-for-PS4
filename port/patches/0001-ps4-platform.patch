+}
+
+bool CNetworkInterfaceFreebsd::IsEnabled() const
+{
+#if defined(__ORBIS__)
+  return m_ps4Address != 0;
+#else
+  return CNetworkInterfacePosix::IsEnabled();
+#endif
+}
+
+bool CNetworkInterfaceFreebsd::IsConnected() const
+{
+#if defined(__ORBIS__)
+  return m_ps4Address != 0;
+#else
+  return CNetworkInterfacePosix::IsConnected();
+#endif
+}
+
+std::string CNetworkInterfaceFreebsd::GetCurrentIPAddress() const
+{
+#if defined(__ORBIS__)
+  if (m_ps4Address != 0)
+  {
+    struct in_addr address = {};
+    address.s_addr = m_ps4Address;
+    return inet_ntoa(address);
+  }
+#endif
+  return CNetworkInterfacePosix::GetCurrentIPAddress();
+}
+
+std::string CNetworkInterfaceFreebsd::GetCurrentNetmask() const
+{
+#if defined(__ORBIS__)
+  if (m_ps4Netmask != 0)
