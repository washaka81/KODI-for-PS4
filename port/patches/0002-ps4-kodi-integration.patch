+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Startup trace.  On PS4 the application can die without any message (no
+// signal and no coredump), so a mark is appended to
+// /data/kodi-ps4/core-canary.log to know where it stopped.
+//
+// On other platforms these helpers do nothing, so the shared code stays
+// untouched.
+#if defined(TARGET_PS4)
+
+// Append a mark to the startup log.
+void WriteStartupTrace(const char* stage);
+
+// Per-frame debug mark.  Disabled unless PS4_FRAME_TRACE=1 is exported, so
+// core-canary.log does not grow without bound.
+void WriteFrameTrace(const char* stage);
+
+// Install the signal handler that records the fault before the process
+// dies.  Called from main() rather than a constructor: installing a handler
+// during global initialization can kill the process.
+void InstallPS4CrashHandler();
+
+// Prepare the PS4 environment (HOME, KODI_HOME).  Called at the start of
+// main(), before Kodi resolves the profile directories.
+void PreparePS4Environment();
+
+#else
+
+inline void WriteStartupTrace(const char*) {}
+inline void WriteFrameTrace(const char*) {}
+inline void InstallPS4CrashHandler() {}
+inline void PreparePS4Environment() {}
+
+#endif
