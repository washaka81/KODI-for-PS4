+static void PS4WStringProbe(const char* tag)
+{
+  auto dump = [](const std::wstring& s, char* out, size_t n) {
+    size_t pos = 0;
+    for (wchar_t c : s)
+    {
+      int r = std::snprintf(out + pos, n - pos, "%08x ", static_cast<unsigned>(c));
+      if (r < 0 || static_cast<size_t>(r) >= n - pos)
+        break;
+      pos += static_cast<size_t>(r);
+    }
+    if (pos < n)
+      out[pos] = 0;
+  };
+  char srcHex[256];
+  char copyHex[256];
+  char assignHex[256];
+  char reservedHex[256];
+  std::wstring src = L"abcde";
+  std::wstring copy(src);
+  std::wstring assigned;
+  assigned.assign(src);
+  std::wstring reserved;
+  reserved.reserve(64);
+  reserved = src;
+  dump(src, srcHex, sizeof(srcHex));
+  dump(copy, copyHex, sizeof(copyHex));
+  dump(assigned, assignHex, sizeof(assignHex));
+  dump(reserved, reservedHex, sizeof(reservedHex));
+  CLog::Log(LOGINFO, "PS4 wstring probe {} src={} copy={} assign={} reserved={}", tag, srcHex,
+            copyHex, assignHex, reservedHex);
+}
