+#if defined(__ORBIS__)
+extern "C" uint64_t glShimPresentCount(void);
+extern "C" uint64_t glShimGetProcessTimeUs(void);
+
+// Measures the two halves of a window transition separately: the close loop
+// inside CloseWindowSync() and the open animation driven by the normal frame
+// loop.  `iterations` is the GUI loop rate; `presents` counts glShimPresent
+// calls and `host`/`proc` provide two independent wall-clock references.
+struct PS4TransitionProfiler
+{
+  bool closeActive = false;
+  int closeWindow = 0;
+  int64_t closeStartHost = 0;
+  uint64_t closeStartProcUs = 0;
+  uint64_t closeStartPresents = 0;
+  unsigned closeFrames = 0;
+
+  bool openActive = false;
+  int openWindow = 0;
+  int64_t openStartHost = 0;
+  uint64_t openStartProcUs = 0;
+  uint64_t openStartPresents = 0;
+  unsigned openFrames = 0;
+
+  void BeginClose(int windowId)
+  {
+    closeActive = true;
+    closeWindow = windowId;
+    closeStartHost = CurrentHostCounter();
+    closeStartProcUs = glShimGetProcessTimeUs();
+    closeStartPresents = glShimPresentCount();
+    closeFrames = 0;
+  }
+
+  void CloseFrame()
+  {
+    if (closeActive)
+      ++closeFrames;
+  }
+
+  void EndClose()
+  {
+    if (!closeActive)
+      return;
+    closeActive = false;
+    Log("close", closeWindow, closeStartHost, closeStartProcUs, closeStartPresents, closeFrames);
+  }
+
+  void BeginOpen(int windowId)
+  {
+    openActive = true;
+    openWindow = windowId;
+    openStartHost = CurrentHostCounter();
+    openStartProcUs = glShimGetProcessTimeUs();
+    openStartPresents = glShimPresentCount();
+    openFrames = 0;
+  }
+
+  void OpenFrame()
+  {
+    if (openActive)
+      ++openFrames;
+  }
+
+  void EndOpen()
+  {
+    if (!openActive)
+      return;
+    openActive = false;
+    Log("open", openWindow, openStartHost, openStartProcUs, openStartPresents, openFrames);
+  }
+
+  static void Log(const char* phase,
+                  int windowId,
+                  int64_t startHost,
+                  uint64_t startProcUs,
+                  uint64_t startPresents,
+                  unsigned iterations)
+  {
+    const double ms =
+        static_cast<double>(CurrentHostCounter() - startHost) / 1000000.0;
+    const double hostMs = ms;
+    const double procMs =
+        static_cast<double>(glShimGetProcessTimeUs() - startProcUs) / 1000.0;
+    const uint64_t presents = glShimPresentCount() - startPresents;
+    const double fps = ms > 0.0 ? presents * 1000.0 / ms : 0.0;
+    CLog::Log(LOGINFO,
+              "PS4 transition {}: window={} presents={} iterations={} {:.2f} ms "
+              "(host {:.2f} proc {:.2f} ms) ({:.1f} fps)",
+              phase, windowId, presents, iterations, ms, hostMs, procMs, fps);
+  }
+};
+
+PS4TransitionProfiler g_ps4Transition;
+#endif
