From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kodi-ps4 dev <dev@kodi-ps4.local>
Date: Sat, 14 Nov 2026 20:43:28 -0300
Subject: [PATCH 12/12] ps4: recover from stale SQLite dotfile locks

A hard close leaves the unix-dotfile <db>.lock directories behind; the next start blocks forever in the busy handler and the splash never ends. Remove stale locks before CDatabaseManager opens the first database, and stop retrying after 10 s so a remaining lock fails visibly instead of hanging. Only locks with a matching .db file are removed.
---
 xbmc/ServiceManager.cpp                |  10 ++
 xbmc/dbwrappers/sqlitedataset.cpp      |  11 ++-
 xbmc/platform/ps4/CMakeLists.txt       |   2 +
 xbmc/platform/ps4/PS4DatabaseLocks.cpp | 124 +++++++++++++++++++++++++
 xbmc/platform/ps4/PS4DatabaseLocks.h   |  31 +++++++
 5 files changed, 177 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/platform/ps4/PS4DatabaseLocks.cpp
 create mode 100644 xbmc/platform/ps4/PS4DatabaseLocks.h

diff --git a/xbmc/ServiceManager.cpp b/xbmc/ServiceManager.cpp
index 929a8f2e3b..d4871a77ca 100644
--- a/xbmc/ServiceManager.cpp
+++ b/xbmc/ServiceManager.cpp
@@ -43,6 +43,9 @@
 #if !defined(TARGET_WINDOWS) && defined(HAS_OPTICAL_DRIVE)
 #include "storage/DetectDVDType.h"
 #endif
+#if defined(__ORBIS__)
+#include "platform/ps4/PS4DatabaseLocks.h"
+#endif
 #include "pictures/SlideShowDelegator.h"
 #include "storage/MediaManager.h"
 #include "utils/FileExtensionProvider.h"
@@ -128,6 +131,13 @@ bool CServiceManager::InitStageOne()
 
 bool CServiceManager::InitStageTwo(const std::string& profilesUserDataFolder)
 {
+#if defined(__ORBIS__)
+  // A hard close leaves SQLite's unix-dotfile lock directories behind.  On
+  // PS4 there is only one Kodi instance, so anything present now is stale.
+  // Clean it before CDatabaseManager opens the first database.
+  KODI::PLATFORM::PS4::RemoveStaleDatabaseLocks(profilesUserDataFolder);
+#endif
+
 #ifdef HAS_PYTHON
   // checked here rather than at construction so the failure reaches kodi.log
   if (!m_XBPython->BindingModulesLoaded())
diff --git a/xbmc/dbwrappers/sqlitedataset.cpp b/xbmc/dbwrappers/sqlitedataset.cpp
index 8340d73ce0..b2670910cd 100644
--- a/xbmc/dbwrappers/sqlitedataset.cpp
+++ b/xbmc/dbwrappers/sqlitedataset.cpp
@@ -206,8 +206,17 @@ int callback(void* res_ptr, int ncol, char** result, char** cols)
   return 0;
 }
 
-int busy_callback(void*, int /*busyCount*/)
+int busy_callback(void*, int busyCount)
 {
+  // A stale unix-dotfile lock must not keep Kodi on the splash screen forever.
+  static constexpr int MAX_RETRIES = 100; // 100 * 100 ms
+  if (busyCount >= MAX_RETRIES)
+  {
+    CLog::Log(LOGERROR, "SqliteDatabase: database still locked after {} retries, giving up",
+              busyCount);
+    return 0;
+  }
+
   KODI::TIME::Sleep(100ms);
   return 1;
 }
