+  std::string flags;
+  const auto addFlag = [&flags](bool condition, const char* name)
+  {
+    if (!condition)
+      return;
+    if (!flags.empty())
+      flags += ",";
+    flags += name;
+  };
+
+  addFlag(dnsMs > 200.0, "DNS_SLOW");
+  addFlag(connectMs > 1000.0, "CONNECT_SLOW");
+  addFlag(tlsMs > 2000.0, "TLS_SLOW");
+  addFlag(ttfbMs > 1000.0, "TTFB_SLOW");
+  addFlag(totalMs > 3000.0, "TOTAL_SLOW");
+  addFlag(preValid && pre.tcpi_total_retrans > 0, "RETRANS_PRE");
+  addFlag(preValid && pre.tcpi_snd_mss > 0 && pre.tcpi_snd_mss < 1300, "SMALL_MSS");
+  addFlag(preValid && pre.tcpi_pmtu > 0 && pre.tcpi_pmtu < 1500, "PMTU_LOW");
