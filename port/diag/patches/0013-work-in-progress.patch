+  char tag[256];
+  const int length = snprintf(
+      tag, sizeof(tag),
+      "alloc-fail size=%zu flex=%lluKB direct=%lluKB rss=%lluKB rsp=0x%llx rbp=0x%llx "
+      "caller=0x%llx",
+      size, static_cast<unsigned long long>(flex / 1024),
+      static_cast<unsigned long long>(direct / 1024),
+      static_cast<unsigned long long>(rss / 1024),
+      static_cast<unsigned long long>(rsp), static_cast<unsigned long long>(rbp),
+      static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(caller)));
+  if (length > 0)
+    PS4CrashWrite(tag, 0, caller);
+  PS4MemCanaryLog("alloc-fail");
+  /* With mem-map enabled this records live bytes/allocations at the failure,
+   * which distinguishes a full heap from a corrupted/fragmented one. */
+  PS4MemMapSnapshot("alloc-fail");
+}
+
+void InstallPS4CrashHandler()
+{
+  /* Diagnostic switch: create /data/kodi-ps4/crash-handler over FTP (or set
+   * PS4_CRASH_HANDLER=1) before launch.  Release runs stay trace-free. */
+  if (!getenv("PS4_CRASH_HANDLER") && access("/data/kodi-ps4/crash-handler", F_OK) != 0)
+    return;
+
+  /* Keep the log descriptor open before any signal can arrive. */
+  if (g_crashFd < 0)
+    g_crashFd = open(kCrashLog, O_WRONLY | O_CREAT | O_APPEND, 0644);
+
+  static char altstack[64 * 1024] __attribute__((aligned(64)));
+  stack_t ss = {};
+  ss.ss_sp = altstack;
+  ss.ss_size = sizeof(altstack);
+  ss.ss_flags = 0;
+  (void)sigaltstack(&ss, nullptr);
+
+  struct sigaction sa = {};
+  sa.__sa_handler.__sa_sigaction = PS4CrashHandler;
+  sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+  sigemptyset(&sa.sa_mask);
+  for (const int sig : {SIGSEGV, SIGBUS, SIGABRT, SIGILL, SIGFPE, 10, 12})
+    (void)sigaction(sig, &sa, nullptr);
+
+  std::set_new_handler(PS4NewHandler);
+  std::set_terminate(PS4TerminateHandler);
+}
+
+#if defined(PS4_STACK_CANARY)
+extern "C" void __real___stack_chk_fail(void);
+
+/* Diagnostic hook for the shim built with -fstack-protector-all: record the
+ * hit before libc aborts.  write/open are async-signal-safe, so a corrupted
+ * stack does not turn this into a second fault. */
+extern "C" void __wrap___stack_chk_fail(void)
+{
+  static const char line[] = "PS4STACK canary-fail __stack_chk_fail\n";
+  const int fd = open("/data/kodi-ps4/crash.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
+  if (fd >= 0)
+  {
+    (void)write(fd, line, sizeof(line) - 1);
+    close(fd);
+  }
+  __real___stack_chk_fail();
+}
+#endif
