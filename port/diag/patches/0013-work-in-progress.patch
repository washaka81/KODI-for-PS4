+X509_STORE* PS4SharedCaStore();
+
+/* The PS4 port can be built against OpenSSL or mbedTLS.  CURLOPT_SSL_CTX_FUNCTION
+ * and the shared X509_STORE are OpenSSL-only; with the mbedTLS backend curl
+ * rejects the option and the CA handling has to go through CAINFO/CAINFO_BLOB.
+ * Detect the backend once so both builds share the same source. */
+bool PS4CurlUsesOpenSsl()
+{
+  static const bool openSsl = []()
+  {
+    const curl_version_info_data* info = curl_version_info(CURLVERSION_NOW);
+    return info && info->ssl_version && std::strncmp(info->ssl_version, "OpenSSL", 7) == 0;
+  }();
+  return openSsl;
+}
+
+CURLcode PS4TlsCtxCallback(CURL* easy, void* sslctx, void* /*parm*/)
+{
+  auto* ctx = static_cast<SSL_CTX*>(sslctx);
+  if (X509_STORE* store = PS4SharedCaStore())
+  {
+    X509_STORE_up_ref(store);
+    SSL_CTX_set_cert_store(ctx, store);
+  }
+
+  /* This callback runs after TCP connect and before SSL_connect(): the
+   * earliest point at which a connected socket can carry the console's
+   * network policy.  libSceHttp applies it at the same point. */
+  curl_socket_t active = CURL_SOCKET_BAD;
+  if (g_curlInterface.easy_getinfo(easy, CURLINFO_ACTIVESOCKET, &active) == CURLE_OK &&
+      active != CURL_SOCKET_BAD)
+    PS4NetApplyPolicy(active, true);
+
+  if (!PS4TlsTraceEnabled())
+    return CURLE_OK;
+  CLog::Log(LOGINFO, "PS4TLS phase=ctx t={} ctx={}", PS4TlsNowUs(),
+            static_cast<const void*>(ctx));
+
+  curl_socket_t sock = CURL_SOCKET_BAD;
+  if (g_curlInterface.easy_getinfo(easy, CURLINFO_ACTIVESOCKET, &sock) == CURLE_OK &&
+      sock != CURL_SOCKET_BAD)
+  {
+    g_tlsSocket = sock;
+    int mss = -1;
+    socklen_t mssLen = sizeof(mss);
+    (void)getsockopt(sock, IPPROTO_TCP, TCP_MAXSEG, &mss, &mssLen);
+    struct tcp_info ti{};
+    socklen_t len = sizeof(ti);
+    if (getsockopt(sock, IPPROTO_TCP, TCP_INFO, &ti, &len) == 0)
+      CLog::Log(LOGINFO,
+                "PS4TLS tcp t={} mss={} snd_mss={} rcv_mss={} pmtu={} rtt={} rttvar={} "
+                "retrans={} segs_out={} bytes_retrans={}",
+                PS4TlsNowUs(), mss, ti.tcpi_snd_mss, ti.tcpi_rcv_mss, ti.tcpi_pmtu,
+                ti.tcpi_rtt, ti.tcpi_rttvar, ti.tcpi_total_retrans, ti.tcpi_segs_out,
+                ti.tcpi_bytes_retrans);
+  }
+
+  SSL_CTX_set_msg_callback(ctx, PS4TlsMsgCallback);
+  SSL_CTX_set_msg_callback_arg(ctx, nullptr);
+  SSL_CTX_set_info_callback(ctx, PS4TlsInfoCallback);
+  return CURLE_OK;
+}
