+   * console is in diagnostic mode; do not require the operator to recreate
+   * the canary file after every package install. */
+  if (getenv("PS4_THREAD_CANARY") == nullptr &&
+      access("/data/kodi-ps4/thread-canary", F_OK) != 0 &&
+      access("/data/kodi-ps4/thread.log", F_OK) != 0)
