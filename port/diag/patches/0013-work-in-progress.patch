+constexpr uint64_t kPs4NetCanaryMagic = 0x5053344E43414E31ULL; /* PS4NCAN1 */
+
+struct PS4NetCanaryState
+{
+  uint64_t magic{kPs4NetCanaryMagic};
+  CURL_HANDLE* easy{nullptr};
+  curl_socket_t fd{CURL_SOCKET_BAD};
+  bool tcpValid{false};
+  int mss{-1};
+  struct tcp_info tcp{};
+};
+
+int PS4NetPrereqCallback(void* clientp,
+                         char* connPrimaryIp,
+                         char* connLocalIp,
+                         int connPrimaryPort,
+                         int connLocalPort)
+{
+  (void)connLocalIp;
+  (void)connLocalPort;
+
+  auto* canary = static_cast<PS4NetCanaryState*>(clientp);
+  if (!canary || canary->magic != kPs4NetCanaryMagic)
+    return 0;
+
+  /* The prereq callback runs right after the handshake, before the HTTP
+   * request.  Prefer the fd remembered by PS4OpenSocket: CURLINFO_ACTIVESOCKET
+   * is not reliable on this libcurl/Orbis combination and used to hide the
+   * whole TCP_INFO sample. */
+  curl_socket_t sock = canary->fd;
+  CURLcode sockRc = CURLE_OK;
+  if (canary->easy)
+  {
+    curl_socket_t active = CURL_SOCKET_BAD;
+    sockRc = g_curlInterface.easy_getinfo(canary->easy, CURLINFO_ACTIVESOCKET, &active);
+    if (active != CURL_SOCKET_BAD)
+      sock = active;
+  }
+
+  /* Re-apply on the connected socket: libSceHttp applies the policy at this
+   * point too (its connection state must be >= 4). */
+  if (sock != CURL_SOCKET_BAD)
+  {
+    PS4NetApplyPolicy(sock, true);
+    if (PS4NetCanaryEnabled())
+    {
+      /* 256 bytes of slack: the documented layout is 160 bytes, but the
+       * call is an out-parameter and must never write past the buffer. */
+      alignas(8) unsigned char infoBuffer[256]{};
+      auto* info = reinterpret_cast<PS4NetSockInfo*>(infoBuffer);
+      const int infoRc = PS4NetGetSockInfo(sock, info, 1, 0);
+      CLog::Log(LOGINFO,
+                "PS4NET sockinfo fd={} rc={} policy={} priority={} state={} tx_drops={} "
+                "rx_drops={} tx_wait={} rcvbuf={} sndbuf={} tx_bps={} rx_bps={}",
+                static_cast<long long>(sock), infoRc, static_cast<int>(info->policy),
+                static_cast<int>(info->priority), info->state, info->txDrops, info->rxDrops,
+                info->txWait, info->recvBufferSize, info->sendBufferSize, info->txBps,
+                info->rxBps);
+    }
+  }
+
+  int mss = -1;
+  if (sock != CURL_SOCKET_BAD)
+  {
+    socklen_t mssLen = sizeof(mss);
+    if (getsockopt(sock, IPPROTO_TCP, TCP_MAXSEG, &mss, &mssLen) != 0)
+      mss = -1;
+  }
+  canary->mss = mss;
+
+  struct tcp_info ti{};
+  bool tiValid = false;
+  int tiRc = -1;
+  int tiErrno = 0;
+  socklen_t tiLenOut = 0;
+  if (sock != CURL_SOCKET_BAD)
+  {
+    socklen_t tiLen = sizeof(ti);
+    tiRc = getsockopt(sock, IPPROTO_TCP, TCP_INFO, &ti, &tiLen);
+    tiErrno = errno;
+    tiLenOut = tiLen;
+    if (tiRc == 0)
+    {
+      canary->tcp = ti;
+      canary->tcpValid = true;
+      tiValid = true;
+    }
+  }
+
+  char tiHex[3 * 32 + 1] = {0};
+  for (int i = 0; i < 32; ++i)
+    snprintf(tiHex + i * 3, 4, "%02x ", reinterpret_cast<const unsigned char*>(&ti)[i]);
+
+  long connects = -1;
+  if (canary->easy)
+    g_curlInterface.easy_getinfo(canary->easy, CURLINFO_NUM_CONNECTS, &connects);
+
+  CLog::Log(LOGINFO,
+            "PS4NET canary phase=pre easy={} fd={} sock_rc={} ip={} port={} mss={} "
+            "snd_mss={} rcv_mss={} pmtu={} rtt={} rttvar={} retrans={} cwnd={} wnd={} "
+            "segs_out={} bytes_retrans={} conns={}",
+            fmt::ptr(canary->easy), static_cast<long long>(sock), static_cast<int>(sockRc),
+            connPrimaryIp ? connPrimaryIp : "?", connPrimaryPort, mss,
+            tiValid ? ti.tcpi_snd_mss : 0,
+            tiValid ? ti.tcpi_rcv_mss : 0,
+            tiValid ? ti.tcpi_pmtu : 0,
+            tiValid ? ti.tcpi_rtt : 0,
+            tiValid ? ti.tcpi_rttvar : 0,
+            tiValid ? ti.tcpi_total_retrans : 0,
+            tiValid ? ti.tcpi_snd_cwnd : 0,
+            tiValid ? ti.tcpi_snd_wnd : 0,
+            tiValid ? ti.tcpi_segs_out : 0,
+            tiValid ? ti.tcpi_bytes_retrans : 0, connects);
+  CLog::Log(LOGINFO, "PS4NET canary phase=tcpinfo rc={} errno={} len={} hex={}", tiRc,
+            tiErrno, static_cast<int>(tiLenOut), tiHex);
+  return 0;
+}
