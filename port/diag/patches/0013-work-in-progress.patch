+/* Stack "estaca": the lowest page of every created thread is set PROT_NONE
+ * and the first 16 bytes above it carry PS4STKCN.  A stack overflow now hits
+ * a named guard page (the handler runs on its own 64 KiB altstack) instead of
+ * silently corrupting the adjacent mapping, and the canary reports how close
+ * the thread came on exit. */
+constexpr uint64_t THREAD_STACK_CANARY = 0x4E434154534B3450ULL; /* PS4STKCN */
