+std::string NativeHttpGet(int32_t tpl, const char* url, const char* label, bool range)
+{
+  std::string host(url);
+  const size_t scheme = host.find("://");
+  if (scheme != std::string::npos)
+    host.erase(0, scheme + 3);
+  const size_t slash = host.find('/');
+  if (slash != std::string::npos)
+    host.erase(slash);
+
+  const int32_t conn = sceHttpCreateConnectionWithURL(tpl, url, 1);
+  if (conn < 0)
+  {
+    CLog::Log(LOGINFO, "PS4HTTPNATIVE {} host={} connection=0x{:08x}", label, host,
+              static_cast<uint32_t>(conn));
+    return {};
+  }
+
+  const int32_t req = sceHttpCreateRequestWithURL(conn, ORBIS_METHOD_GET, url, 0);
+  if (req < 0)
+  {
+    CLog::Log(LOGINFO, "PS4HTTPNATIVE {} host={} request=0x{:08x}", label, host,
+              static_cast<uint32_t>(req));
+    sceHttpDeleteConnection(conn);
+    return {};
+  }
+
+  if (range)
+    (void)sceHttpAddRequestHeader(req, "Range", "bytes=0-", 0);
+
+  const uint64_t t0 = kodi::ps4::NowMs();
+  const int32_t send = sceHttpSendRequest(req, nullptr, 0);
+  const uint64_t t1 = kodi::ps4::NowMs();
+
+  int32_t status = 0;
+  int32_t clenType = 0;
+  size_t clen = 0;
+  if (send >= 0)
+  {
+    (void)sceHttpGetStatusCode(req, &status);
+    (void)sceHttpGetResponseContentLength(req, &clenType, &clen);
+  }
+
+  std::string body;
+  uint64_t first = 0;
+  int32_t err = send;
+  if (send >= 0)
+  {
+    char buf[64 * 1024];
+    while (body.size() < (8U * 1024U * 1024U))
+    {
+      const int32_t n = sceHttpReadData(req, buf, static_cast<uint32_t>(sizeof(buf)));
+      if (n < 0)
+      {
+        err = n;
+        break;
+      }
+      if (n == 0)
+        break;
+      if (first == 0)
+        first = kodi::ps4::NowMs();
+      body.append(buf, static_cast<size_t>(n));
+    }
+  }
+  const uint64_t t2 = kodi::ps4::NowMs();
+
+  CLog::Log(LOGINFO,
+            "PS4HTTPNATIVE {} host={} send_ms={} first_read_ms={} total_ms={} status={} "
+            "clen={} bytes={} err=0x{:08x}",
+            label, host, t1 - t0, first ? first - t0 : 0, t2 - t0, status, clen,
+            body.size(), static_cast<uint32_t>(err));
+  NativeLog("PS4HTTPNATIVE %s host=%s send_ms=%llu first_read_ms=%llu total_ms=%llu "
+            "status=%d clen=%zu bytes=%zu err=0x%08x",
+            label, host.c_str(), static_cast<unsigned long long>(t1 - t0),
+            static_cast<unsigned long long>(first ? first - t0 : 0),
+            static_cast<unsigned long long>(t2 - t0), status, clen, body.size(),
+            static_cast<uint32_t>(err));
+
+  (void)sceHttpDeleteRequest(req);
+  (void)sceHttpDeleteConnection(conn);
+  return body;
+}
