+/* PS4 per-socket network policy/priority.
+ *
+ * libSceHttp implements sceHttpSetPolicyOption() and
+ * sceHttpSetPriorityOption() with
+ *   setsockopt(fd, 0xffff, 0x1201, &policy, 4)
+ *   setsockopt(fd, 0xffff, 0x1203, &priority, 4)
+ * (verified in libSceHttp.sprx: the two exports store the value in the
+ * request and call the socket layer with those option numbers).  The
+ * console uses them to share Wi-Fi/WAN bandwidth between the app, games
+ * and the system.  The defaults are readable with getsockopt(); the two
+ * optional files below override them without hardcoding a console.
+ *
+ * Files:
+ *   net-policy        policy class to request (negative = leave default)
+ *   net-priority      priority to request (negative = leave default)
+ *   net-policy-probe  log defaults and the accepted 0..32 range once
+ */
+constexpr int PS4_SOL_POLICY = 0xffff;
+constexpr int PS4_SO_POLICY = 0x1201;
+constexpr int PS4_SO_PRIORITY = 0x1203;
+
+bool PS4NetSetPolicyOption(int fd, int option, int value, const char* name, bool log)
+{
+  const int rc = setsockopt(fd, PS4_SOL_POLICY, option, &value, sizeof(value));
+  const int err = errno;
+  if (rc != 0)
+    CLog::Log(LOGINFO, "PS4NET policy {} fd={} value={} rc={} errno={}", name, fd, value, rc,
+              err);
+  else if (log)
+    CLog::Log(LOGINFO, "PS4NET policy {} fd={} value={} applied", name, fd, value);
+  return rc == 0;
+}
+
+void PS4NetReadPolicyOptions(int fd, int& policy, int& priority, int& policyRc,
+                             int& priorityRc, int& policyErr, int& priorityErr)
+{
+  policy = -1;
+  priority = -1;
+  socklen_t len = sizeof(policy);
+  policyRc = getsockopt(fd, PS4_SOL_POLICY, PS4_SO_POLICY, &policy, &len);
+  policyErr = errno;
+  len = sizeof(priority);
+  priorityRc = getsockopt(fd, PS4_SOL_POLICY, PS4_SO_PRIORITY, &priority, &len);
+  priorityErr = errno;
+}
+
+void PS4NetPolicyProbe(int fd, bool connected)
+{
+  /* libSceHttp applies the option when its connection state is >= 4
+   * (connected); probe at the same point. */
+  if (!connected)
+    return;
+
+  static std::once_flag once;
+  std::call_once(once, [fd]()
+  {
+    int policy = -1;
+    int priority = -1;
+    int policyRc = -1;
+    int priorityRc = -1;
+    int policyErr = 0;
+    int priorityErr = 0;
+    PS4NetReadPolicyOptions(fd, policy, priority, policyRc, priorityRc, policyErr,
+                            priorityErr);
+    CLog::Log(LOGINFO,
+              "PS4NET policy default fd={} policy={} rc={} errno={} priority={} rc={} "
+              "errno={}",
+              fd, policy, policyRc, policyErr, priority, priorityRc, priorityErr);
+
+    if (!PS4NetFlag("PS4_NET_POLICY_PROBE", "/data/kodi-ps4/net-policy-probe"))
+      return;
+
+    /* A fresh, unconnected socket is enough for the socket-level option on
+     * Orbis; if it is not, the connected pass in the prereq callback logs
+     * the same fields. */
+    const int probe = socket(AF_INET, SOCK_STREAM, 0);
+    if (probe < 0)
+    {
+      CLog::Log(LOGINFO, "PS4NET policy probe socket failed errno={}", errno);
+      return;
+    }
+    for (const int option : {PS4_SO_POLICY, PS4_SO_PRIORITY})
+    {
+      for (int value = 0; value <= 32; ++value)
+      {
+        const int rc = setsockopt(probe, PS4_SOL_POLICY, option, &value, sizeof(value));
+        const int err = errno;
+        int readBack = -1;
+        socklen_t len = sizeof(readBack);
+        const int getRc = getsockopt(probe, PS4_SOL_POLICY, option, &readBack, &len);
+        const int getErr = errno;
+        CLog::Log(LOGINFO,
+                  "PS4NET policy probe opt=0x{:x} value={} set_rc={} errno={} get_rc={} "
+                  "get_errno={} read={}",
+                  option, value, rc, err, getRc, getErr, readBack);
+      }
+    }
+    close(probe);
+  });
+}
+
+void PS4NetApplyPolicy(int fd, bool connected = false)
+{
+  PS4NetPolicyProbe(fd, connected);
+
+  static const int policy = PS4NetInt("PS4_NET_POLICY", "/data/kodi-ps4/net-policy", -1);
+  static const int priority =
+      PS4NetInt("PS4_NET_PRIORITY", "/data/kodi-ps4/net-priority", -1);
+  static std::atomic<int> applied{0};
+  const bool log = applied.fetch_add(1) < 8;
+
+  /* Same order as libSceHttp: priority (0x1203) first, policy (0x1201)
+   * second, so a policy change cannot reset the priority. */
+  if (priority >= 0)
+    PS4NetSetPolicyOption(fd, PS4_SO_PRIORITY, priority, "priority", log);
+  if (policy >= 0)
+    PS4NetSetPolicyOption(fd, PS4_SO_POLICY, policy, "policy", log);
+}
+
+int PS4NetStatTimeout()
+{
+  static const int timeout =
+      PS4NetInt("PS4_NET_STAT_TIMEOUT", "/data/kodi-ps4/net-stat-timeout", 0);
+  if (timeout <= 0)
+    return 0;
+  return std::min(timeout, 300);
+}
+
+int PS4NetConnectTimeout()
+{
+  static const int timeout =
+      PS4NetInt("PS4_NET_CONNECT_TIMEOUT", "/data/kodi-ps4/net-connect-timeout", 0);
+  if (timeout <= 0)
+    return 0;
+  return std::min(timeout, 300);
+}
+
+int PS4NetRetries()
+{
+  static const int retries =
+      PS4NetInt("PS4_NET_RETRIES", "/data/kodi-ps4/net-retries", -1);
+  return retries;
+}
