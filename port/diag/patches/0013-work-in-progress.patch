+/* Optional network throughput probe.  Each line in speedtest-url is
+ * downloaded for speedtest-seconds (default 10) or until EOF; gated by the
+ * file so release runs generate no traffic. */
+void PS4NetSpeedtestThread()
+{
+  FILE* f = std::fopen("/data/kodi-ps4/speedtest-url", "r");
+  if (!f)
+    return;
+
+  std::vector<std::string> urls;
+  char line[1024];
+  while (std::fgets(line, sizeof(line), f))
+  {
+    std::string url(line);
+    while (!url.empty() && (url.back() == '\n' || url.back() == '\r' || url.back() == ' ' ||
+                            url.back() == '\t'))
+      url.pop_back();
+    if (!url.empty())
+      urls.push_back(url);
+  }
+  std::fclose(f);
+  if (urls.empty())
+    return;
+
+  int seconds = 10;
+  if (FILE* sf = std::fopen("/data/kodi-ps4/speedtest-seconds", "r"))
+  {
+    if (std::fscanf(sf, "%d", &seconds) != 1)
+      seconds = 10;
+    std::fclose(sf);
+  }
+  seconds = std::max(3, std::min(seconds, 60));
+
+  std::this_thread::sleep_for(std::chrono::seconds(10));
+
+  for (const auto& url : urls)
+  {
+    XFILE::CCurlFile file;
+    const CURL curl(url);
+    if (!file.Open(curl))
+    {
+      CLog::Log(LOGERROR, "PS4SPEEDTEST open failed url={}", url);
+      continue;
+    }
+
+    std::vector<char> buffer(64 * 1024);
+    uint64_t total = 0;
+    const auto start = std::chrono::steady_clock::now();
+    double elapsed = 0.0;
+    while (true)
+    {
+      elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+      if (elapsed >= seconds)
+        break;
+      const auto n = file.Read(buffer.data(), buffer.size());
+      if (n <= 0)
+        break;
+      total += static_cast<uint64_t>(n);
+    }
+    elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+    file.Close();
+
+    const double bps = elapsed > 0.0 ? static_cast<double>(total) / elapsed : 0.0;
+    CLog::Log(LOGINFO, "PS4SPEEDTEST url={} bytes={} seconds={:.3f} Bps={:.0f} Mbps={:.2f}", url,
+              total, elapsed, bps, bps * 8.0 / 1000000.0);
+  }
+}
+} // namespace
