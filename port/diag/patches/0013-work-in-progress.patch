+bool PS4NetFlag(const char* envName, const char* fileName)
+{
+  const char* env = getenv(envName);
+  if (env && env[0] == '1')
+    return true;
+
+  FILE* f = fopen(fileName, "r");
+  if (!f)
+    return false;
+  char line[32] = {0};
+  bool enabled = true;
+  if (fgets(line, sizeof(line), f) && line[0] == '0')
+    enabled = false;
+  fclose(f);
+  return enabled;
+}
+
+int PS4NetInt(const char* envName, const char* fileName, int defaultValue)
+{
+  const char* env = getenv(envName);
+  if (env && env[0])
+  {
+    char* end = nullptr;
+    const long value = strtol(env, &end, 10);
+    if (end && *end == '\0')
+      return static_cast<int>(value);
+  }
+
+  FILE* f = fopen(fileName, "r");
+  if (!f)
+    return defaultValue;
+  char line[32] = {0};
+  int value = defaultValue;
+  if (fgets(line, sizeof(line), f))
+  {
+    char* end = nullptr;
+    const long parsed = strtol(line, &end, 10);
+    if (end && end != line)
+      value = static_cast<int>(parsed);
+  }
+  fclose(f);
+  return value;
+}
