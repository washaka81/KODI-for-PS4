+thread_local int g_tlsSocket = -1;
+
+void PS4TlsLogTcpInfo(const char* phase, int sock)
+{
+  if (sock < 0)
+    sock = g_tlsSocket;
+  if (sock < 0)
+  {
+    CLog::Log(LOGINFO, "PS4TLS tcp t={} phase={} socket=unavailable", PS4TlsNowUs(), phase);
+    return;
+  }
+
+  int mss = -1;
+  socklen_t mssLen = sizeof(mss);
+  (void)getsockopt(sock, IPPROTO_TCP, TCP_MAXSEG, &mss, &mssLen);
+
+  struct tcp_info ti{};
+  socklen_t len = sizeof(ti);
+  if (getsockopt(sock, IPPROTO_TCP, TCP_INFO, &ti, &len) == 0)
+  {
+    CLog::Log(LOGINFO,
+              "PS4TLS tcp t={} phase={} fd={} mss={} snd_mss={} rcv_mss={} pmtu={} rtt={} "
+              "rttvar={} retrans={} segs_out={} bytes_retrans={}",
+              PS4TlsNowUs(), phase, sock, mss, ti.tcpi_snd_mss, ti.tcpi_rcv_mss, ti.tcpi_pmtu,
+              ti.tcpi_rtt, ti.tcpi_rttvar, ti.tcpi_total_retrans, ti.tcpi_segs_out,
+              ti.tcpi_bytes_retrans);
+  }
+  else
+  {
+    CLog::Log(LOGINFO, "PS4TLS tcp t={} phase={} fd={} mss={} errno={}", PS4TlsNowUs(), phase,
+              sock, mss, errno);
+  }
+}
+
+void PS4TlsMsgCallback(int write_p,
+                       int /*version*/,
+                       int content_type,
+                       const void* buf,
+                       size_t len,
+                       SSL* ssl,
+                       void* /*arg*/)
+{
+  if (!PS4TlsTraceEnabled())
+    return;
+  /* Application data (23) is the video/segment payload: logging every
+   * record would flood kodi.log and slow playback.  Keep the handshake,
+   * alerts and change-cipher-spec messages only. */
+  if (content_type != 20 && content_type != 21 && content_type != 22)
+    return;
+  unsigned type = 0;
+  if (content_type == 22 && buf && len > 0)
+    type = static_cast<const unsigned char*>(buf)[0];
+  CLog::Log(LOGINFO, "PS4TLS msg t={} dir={} ct={} type={} len={}", PS4TlsNowUs(),
+            write_p ? "out" : "in", content_type, type, len);
+  if (content_type == 22 && !write_p && (type == 2 || type == 20))
+    PS4TlsLogTcpInfo(type == 2 ? "serverhello" : "finished", SSL_get_fd(ssl));
+}
+
+void PS4TlsInfoCallback(const SSL* ssl, int where, int ret)
+{
+  if (!PS4TlsTraceEnabled())
+    return;
+  if (where & SSL_CB_HANDSHAKE_START)
+  {
+    CLog::Log(LOGINFO, "PS4TLS phase=handshake-start t={}", PS4TlsNowUs());
+  }
+  else if (where & SSL_CB_HANDSHAKE_DONE)
+  {
+    const char* group = "?";
+#if OPENSSL_VERSION_NUMBER >= 0x30500000L
+    if (const char* negotiated = SSL_get0_group_name(const_cast<SSL*>(ssl)))
+      group = negotiated;
+#endif
+    CLog::Log(LOGINFO,
+              "PS4TLS phase=handshake-done t={} ver={} group={} cipher={} reused={} "
+              "verify={}",
+              PS4TlsNowUs(), SSL_get_version(ssl), group, SSL_get_cipher_name(ssl),
+              SSL_session_reused(ssl), SSL_get_verify_result(ssl));
+  }
+  else if (where & SSL_CB_ALERT)
+  {
+    CLog::Log(LOGINFO, "PS4TLS phase=alert t={} ret={}", PS4TlsNowUs(), ret);
+  }
+}
