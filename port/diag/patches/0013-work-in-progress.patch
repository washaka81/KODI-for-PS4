+void PS4CrashHandler(int sig, siginfo_t* info, void* context)
+{
+  /* The PS4 kernel has delivered a non-canonical siginfo pointer (observed
+   * as 1) on at least one SIGSEGV.  Do not turn the diagnostic handler into
+   * a second fault: only dereference a plausible, aligned user pointer. */
+  const uintptr_t infoAddress = reinterpret_cast<uintptr_t>(info);
+  const void* faultAddress = nullptr;
+  int faultCode = 0;
+  if (infoAddress > 0x10000 && (infoAddress & 0x7) == 0)
+  {
+    faultAddress = info->si_addr;
+    faultCode = info->si_code;
+  }
+
+  /* Write the saved registers before _Unwind_Backtrace(): on SIGBUS the
+   * stack may be unreadable mid-handshake, and the registers locate the
+   * faulting instruction even when the unwinder cannot produce frames. */
+  const uintptr_t contextAddress = reinterpret_cast<uintptr_t>(context);
+  if (contextAddress > 0x10000 && (contextAddress & 0x7) == 0)
+  {
+    auto* uc = static_cast<ucontext_t*>(context);
+    const CrashRegisterSnapshot regs = CrashReadRegisters(uc);
+    char tag[352];
+    const int length = snprintf(
+        tag, sizeof(tag),
+        "crash-regs signal=%d(%s) code=%d addr=0x%llx rip=0x%llx rsp=0x%llx "
+        "rbp=0x%llx rax=0x%llx cr2=0x%llx rsp_mod8=%u rbp_mod8=%u "
+        "stack=%s0x%llx..0x%llx",
+        sig, CrashSignalName(sig), faultCode,
+        static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(faultAddress)),
+        static_cast<unsigned long long>(regs.rip),
+        static_cast<unsigned long long>(regs.rsp),
+        static_cast<unsigned long long>(regs.rbp),
+        static_cast<unsigned long long>(regs.rax),
+        static_cast<unsigned long long>(regs.cr2),
+        static_cast<unsigned>(regs.rsp & 0x7U),
+        static_cast<unsigned>(regs.rbp & 0x7U), regs.stackKnown ? "" : "unknown ",
+        static_cast<unsigned long long>(regs.stackStart),
+        static_cast<unsigned long long>(regs.stackEnd));
+    if (length > 0)
+      PS4CrashWrite(tag, 0, nullptr, false);
+    PS4CrashWriteCallerFrames(regs);
+  }
+
+  char crashTag[64];
+  const int tagLength = snprintf(crashTag, sizeof(crashTag), "crash-%s", CrashSignalName(sig));
+  PS4CrashWrite(tagLength > 0 ? crashTag : "crash", sig, faultAddress);
+
+  /* Do not call _exit() from the handler: on PS4 that is syscall 1 (exit)
+   * and the kernel answers with SIGSYS (12), masking the original
+   * SIGBUS/SIGSEGV in the system crash report.  Restore the default action
+   * and return; the faulting instruction is retried and the system coredump
+   * keeps the original signal. */
+  struct sigaction defaultAction = {};
+  defaultAction.sa_handler = SIG_DFL;
+  sigemptyset(&defaultAction.sa_mask);
+  (void)sigaction(sig, &defaultAction, nullptr);
+}
