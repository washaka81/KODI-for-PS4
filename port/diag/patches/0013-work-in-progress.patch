+    NativeLog("PS4HTTPNATIVE template=0x%08x", static_cast<uint32_t>(tpl));
+    return;
+  }
+  const int32_t ssl = sceHttpsSetSslCallback(tpl, NativeSslCallback, nullptr);
+  CLog::Log(LOGINFO, "PS4HTTPNATIVE ssl_callback=0x{:08x}", static_cast<uint32_t>(ssl));
+  NativeLog("PS4HTTPNATIVE ssl_callback=0x%08x", static_cast<uint32_t>(ssl));
+
+  const std::string master = NativeHttpGet(tpl, url, "master", false);
+  const size_t pos = master.find("https://");
+  if (pos == std::string::npos)
+  {
+    CLog::Log(LOGINFO, "PS4HTTPNATIVE no media url in master ({} bytes)", master.size());
