 std::vector<uint8_t> cachedCaCertsBlob; // cached CA certs file
 
+#if defined(__ORBIS__)
+/* One X509_STORE for every easy handle.  Parsing the 200 KB bundle per
+ * connection (118 certs) is both slow and memory-hungry; the shared store is
+ * built once from the preloaded blob and installed by PS4TlsCtxCallback. */
+X509_STORE* PS4SharedCaStore()
+{
+  static std::once_flag once;
+  static X509_STORE* store = nullptr;
+  std::call_once(once, []()
+  {
+    if (cachedCaCertsBlob.empty())
+      return;
+    X509_STORE* created = X509_STORE_new();
+    if (!created)
+      return;
+    BIO* bio = BIO_new_mem_buf(cachedCaCertsBlob.data(),
+                               static_cast<int>(cachedCaCertsBlob.size()));
+    if (!bio)
+    {
+      X509_STORE_free(created);
+      return;
+    }
+    STACK_OF(X509_INFO)* infos = PEM_X509_INFO_read_bio(bio, nullptr, nullptr, nullptr);
+    BIO_free(bio);
+    if (!infos)
+    {
+      X509_STORE_free(created);
+      return;
+    }
+    for (int i = 0; i < sk_X509_INFO_num(infos); i++)
+    {
+      X509_INFO* info = sk_X509_INFO_value(infos, i);
+      if (info->x509)
+        X509_STORE_add_cert(created, info->x509);
+      if (info->crl)
+        X509_STORE_add_crl(created, info->crl);
+    }
+    sk_X509_INFO_pop_free(infos, X509_INFO_free);
+    store = created;
+  });
+  return store;
+}
+#endif
