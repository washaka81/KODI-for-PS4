+  const double dnsMs = dns * 1000.0;
+  const double connectMs = connect * 1000.0;
+  const double tlsMs = (appConnect > connect ? appConnect - connect : 0.0) * 1000.0;
+  const double ttfbMs =
+      (startTransfer > appConnect ? startTransfer - appConnect : 0.0) * 1000.0;
+  const double totalMs = total * 1000.0;
+  static const struct tcp_info kEmptyTcp{};
+  const bool preValid = canary && canary->tcpValid;
+  const auto& pre = preValid ? canary->tcp : kEmptyTcp;
