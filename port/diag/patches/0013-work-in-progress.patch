+std::string ReadFirstLine(const char* path)
+{
+  FILE* f = std::fopen(path, "r");
+  if (!f)
+    return {};
+  char line[2048] = {};
+  const char* got = std::fgets(line, sizeof(line), f);
+  std::fclose(f);
+  if (!got)
+    return {};
+  std::string value(line);
+  while (!value.empty() &&
+         (value.back() == '\n' || value.back() == '\r' || value.back() == ' '))
+    value.pop_back();
+  return value;
