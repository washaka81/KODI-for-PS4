+/* Stack bounds are published when a thread starts so the crash handler can
+ * report the faulting thread's stack without calling into libc or the kernel.
+ * Slots are recycled as a ring: a stale pthread_t is harmless because the
+ * thread is gone, and the handler only reads. */
+constexpr size_t kMaxThreadStacks = 192;
+struct ThreadStackRecord
+{
+  uintptr_t tid{0};
+  uintptr_t start{0};
+  uintptr_t end{0};
+};
+ThreadStackRecord g_threadStacks[kMaxThreadStacks];
+unsigned g_threadStackSeq = 0;
+
+void ThreadStackPublish(uintptr_t tid, uintptr_t start, uintptr_t end)
+{
+  const unsigned slot =
+      __atomic_fetch_add(&g_threadStackSeq, 1, __ATOMIC_RELAXED) % kMaxThreadStacks;
+  /* Invalidate the slot while start/end are updated so a recycled pthread_t
+   * can never be paired with the previous thread's bounds. */
+  __atomic_store_n(&g_threadStacks[slot].tid, uintptr_t{0}, __ATOMIC_RELEASE);
+  g_threadStacks[slot].start = start;
+  g_threadStacks[slot].end = end;
+  __atomic_store_n(&g_threadStacks[slot].tid, tid, __ATOMIC_RELEASE);
+}
+
+bool ThreadStackLookup(uintptr_t tid, uintptr_t* start, uintptr_t* end)
+{
+  for (size_t i = 0; i < kMaxThreadStacks; ++i)
+  {
+    if (__atomic_load_n(&g_threadStacks[i].tid, __ATOMIC_ACQUIRE) != tid)
+      continue;
+    *start = g_threadStacks[i].start;
+    *end = g_threadStacks[i].end;
+    return *start != 0 && *end > *start;
+  }
+  return false;
+}
+
+void ThreadStackGuardArm(ThreadStackGuard* guard, unsigned id)
+{
+  char marker = 0;
+  OrbisKernelVirtualQueryInfo info{};
+  if (sceKernelVirtualQuery(&marker, 0, &info, sizeof(info)) != 0)
+    return;
+  const uintptr_t start = reinterpret_cast<uintptr_t>(info.unk01);
+  const uintptr_t end = reinterpret_cast<uintptr_t>(info.unk02);
+  const size_t page = static_cast<size_t>(getpagesize());
+  if (!info.isStack || start == 0 || end <= start + page * 2 || page == 0)
+    return;
+
+  ThreadStackPublish(reinterpret_cast<uintptr_t>(pthread_self()), start, end);
+
+  if (mprotect(reinterpret_cast<void*>(start), page, PROT_NONE) != 0)
+  {
+    ThreadCanaryLog("THREAD guard-fail id=%u start=0x%llx page=%zu errno=%d\n", id,
+                    static_cast<unsigned long long>(start), page, errno);
+    return;
+  }
+
+  guard->start = start;
+  guard->page = page;
+  guard->canary = reinterpret_cast<uint64_t*>(start + page);
+  guard->canary[0] = THREAD_STACK_CANARY;
+  guard->canary[1] = THREAD_STACK_CANARY;
+  guard->id = id;
+  guard->armed = true;
+  ThreadCanaryLog("THREAD guard id=%u start=0x%llx end=0x%llx page=%zu\n", id,
+                  static_cast<unsigned long long>(start),
+                  static_cast<unsigned long long>(end), page);
+}
+
+void ThreadStackGuardCheck(ThreadStackGuard* guard)
+{
+  if (!guard->armed)
+    return;
+  const bool intact = guard->canary[0] == THREAD_STACK_CANARY &&
+                      guard->canary[1] == THREAD_STACK_CANARY;
+  ThreadCanaryLog("THREAD guard-exit id=%u status=%s\n", guard->id,
+                  intact ? "ok" : "corrupt");
+}
+
+void* ThreadCanaryTrampoline(void* data)
+{
+  ThreadCanaryContext context = *static_cast<ThreadCanaryContext*>(data);
+  free(data);
+  ThreadStackGuard guard;
+  ThreadStackGuardArm(&guard, context.id);
+  void* result = context.start(context.arg);
+  ThreadStackGuardCheck(&guard);
+  const unsigned count = __atomic_sub_fetch(&g_threadCount, 1, __ATOMIC_RELAXED);
+  ThreadCanaryLog("THREAD exit id=%u count=%u\n", context.id, count);
+  return result;
+}
