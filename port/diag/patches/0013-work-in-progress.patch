+int PS4NetBufferBytes()
+{
+  /* 256 KiB is the stability default: 0.1.1r with 256 KiB kept flex at
+   * ~83 MB and ran 24 min without a crash, while 1 MiB (actual 512 KiB)
+   * pushed flex to ~56 MB and the next GUI string allocation failed.  The
+   * buffers compete with the flexible pool; larger values remain an opt-in
+   * tradeoff through /data/kodi-ps4/net-buffer-kb (64..2048 KiB). */
+  static const int bytes = []()
+  {
+    int kb = PS4NetInt("PS4_NET_BUFFER_KB", "/data/kodi-ps4/net-buffer-kb", 256);
+    if (kb < 64)
+      kb = 64;
+    if (kb > 2048)
+      kb = 2048;
+    return kb * 1024;
+  }();
+  return bytes;
+}
