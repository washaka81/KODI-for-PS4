+
+struct CrashBacktrace
+{
+  void* frames[64];
+  int count{0};
+};
+
+_Unwind_Reason_Code CrashBacktraceCallback(_Unwind_Context* context, void* arg)
+{
+  auto* state = static_cast<CrashBacktrace*>(arg);
+  const uintptr_t ip = _Unwind_GetIP(context);
+  if (ip != 0 && state->count < static_cast<int>(std::size(state->frames)))
+    state->frames[state->count++] = reinterpret_cast<void*>(ip);
+  return state->count >= static_cast<int>(std::size(state->frames)) ? _URC_END_OF_STACK
+                                                                   : _URC_NO_REASON;
