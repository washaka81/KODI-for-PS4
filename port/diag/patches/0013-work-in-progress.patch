+  addFlag(postValid && !preValid && post.tcpi_total_retrans > 0, "RETRANS_POST");
+  addFlag(connects > 0, "NEW_CONN");
+  addFlag(connects == 0, "REUSED");
+  addFlag(result == CURLE_OPERATION_TIMEDOUT, "TIMEOUT");
+  addFlag(result == CURLE_SSL_CONNECT_ERROR, "TLS_ERR");
+  addFlag(httpVersion >= CURL_HTTP_VERSION_2_0, "HTTP2");
+  addFlag(redirects > 0, "REDIRECT");
+  addFlag(osErrno != 0, "OS_ERRNO");
+  addFlag(sslVerify != 0, "SSL_VERIFY");
+  if (flags.empty())
+    flags = "OK";
+
+  CLog::Log(LOGINFO,
+            "PS4NET canary phase=post fn={} url={} result={}({}) ip={} port={} total={:.0f} "
+            "dns={:.0f} connect={:.0f} tls={:.0f} ttfb={:.0f} redirect_ms={:.0f} "
+            "bytes={} speed={} conns={} http={} tlsver={} tlsgroup={} tlscipher={} "
+            "tlsreused={} tlsverify={} os_errno={} ssl_verify={} "
+            "response={} redirects={} mss={} snd_mss={} rcv_mss={} pmtu={} rtt={} rttvar={} "
+            "retrans={} segs_out={} bytes_retrans={} flags={}",
+            functionName, redactedUrl, g_curlInterface.easy_strerror(result),
+            static_cast<int>(result), primaryIp ? primaryIp : "?", primaryPort, totalMs,
+            dnsMs, connectMs, tlsMs, ttfbMs, redirectTime * 1000.0, bytes, speed,
+            connects, httpVersion, tlsVersion, tlsGroup, tlsCipher, tlsReused, tlsVerify,
+            osErrno, sslVerify, response, redirects,
+            canary ? canary->mss : -1, preValid ? pre.tcpi_snd_mss : 0,
+            preValid ? pre.tcpi_rcv_mss : 0, preValid ? pre.tcpi_pmtu : 0,
+            postValid ? post.tcpi_rtt : (preValid ? pre.tcpi_rtt : 0),
+            postValid ? post.tcpi_rttvar : (preValid ? pre.tcpi_rttvar : 0),
+            postValid ? post.tcpi_total_retrans
+                      : (preValid ? pre.tcpi_total_retrans : 0),
+            postValid ? post.tcpi_segs_out : (preValid ? pre.tcpi_segs_out : 0),
+            postValid ? post.tcpi_bytes_retrans
+                      : (preValid ? pre.tcpi_bytes_retrans : 0),
+            flags);
+}
