+
+void PS4CrashWrite(const char* tag, int sig = 0, const void* addr = nullptr,
+                   bool withBacktrace = true)
+{
+  int fd = g_crashFd;
+  const bool closeAfter = fd < 0;
+  if (closeAfter)
+  {
+    fd = open(kCrashLog, O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd < 0)
+      return;
+  }
+
+  char line[256];
+  const int n = snprintf(line, sizeof(line), "\n=== %s signal=%d addr=%p thread=%llu ===\n", tag, sig,
+                         addr, static_cast<unsigned long long>(
+                                   reinterpret_cast<uintptr_t>(pthread_self())));
+  if (n > 0)
+  {
+    const size_t total = static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n)
+                                                               : sizeof(line) - 1;
+    (void)write(fd, line, total);
+  }
+
+  if (!withBacktrace)
+  {
+    if (closeAfter)
+      close(fd);
+    return;
+  }
+
+  CrashBacktrace state;
+  _Unwind_Backtrace(CrashBacktraceCallback, &state);
+  for (int i = 0; i < state.count; ++i)
+  {
+    const int len = snprintf(line, sizeof(line), "  bt[%02d]=%p\n", i, state.frames[i]);
+    if (len > 0)
+    {
+      const size_t total = static_cast<size_t>(len) < sizeof(line)
+                               ? static_cast<size_t>(len)
+                               : sizeof(line) - 1;
+      (void)write(fd, line, total);
+    }
+  }
+  if (closeAfter)
+    close(fd);
+}
+
+const char* CrashSignalName(int sig)
+{
+  switch (sig)
+  {
+    case SIGSEGV:
+      return "SIGSEGV";
+    case SIGBUS:
+      return "SIGBUS";
+    case 10:
+      /* FreeBSD/Orbis kernel numbers the bus error as 10; the musl-derived
+       * Orbis headers define SIGBUS as 7.  Install both and label the raw
+       * kernel signal so crash.log shows which one arrived. */
+      return "SIGBUS-PS4";
+    case 12:
+      /* FreeBSD/Orbis SIGSYS.  The musl header defines SIGSYS as 31. */
+      return "SIGSYS-PS4";
+    case SIGABRT:
+      return "SIGABRT";
+    case SIGILL:
+      return "SIGILL";
+    case SIGFPE:
+      return "SIGFPE";
+    default:
+      return "SIG";
+  }
+}
+
+/* The OpenOrbis/musl ucontext_t layout matches the kernel's.  The 2-byte
+ * shift seen in uc-stack is the faulting RSP itself (2 mod 8), not a read
+ * offset: the handler must keep the corrupted value so the log shows the
+ * real stack pointer.  A shifted read can look aligned and hide it. */
+struct CrashRegisterSnapshot
+{
+  uintptr_t rip{0};
+  uintptr_t rsp{0};
+  uintptr_t rbp{0};
+  uintptr_t rax{0};
+  uintptr_t cr2{0};
+  uintptr_t stackStart{0};
+  uintptr_t stackEnd{0};
+  bool stackKnown{false};
+};
+
+CrashRegisterSnapshot CrashReadRegisters(const ucontext_t* uc)
+{
+  CrashRegisterSnapshot snapshot;
+  uintptr_t stackStart = 0;
+  uintptr_t stackEnd = 0;
+  snapshot.stackKnown = ThreadStackLookup(
+      reinterpret_cast<uintptr_t>(pthread_self()), &stackStart, &stackEnd);
+  snapshot.stackStart = stackStart;
+  snapshot.stackEnd = stackEnd;
+  snapshot.rip = uc->uc_mcontext.gregs[REG_RIP];
+  snapshot.rsp = uc->uc_mcontext.gregs[REG_RSP];
+  snapshot.rbp = uc->uc_mcontext.gregs[REG_RBP];
+  snapshot.rax = uc->uc_mcontext.gregs[REG_RAX];
+  snapshot.cr2 = uc->uc_mcontext.gregs[REG_CR2];
+  return snapshot;
+}
+
+/* _Unwind_Backtrace() starts inside this handler, so its first frames are
+ * the handler's own writers, never the faulting caller.  Walk the saved
+ * frame chain from the signal context instead. */
+void PS4CrashWriteCallerFrames(const CrashRegisterSnapshot& regs)
+{
+  int fd = g_crashFd;
+  const bool closeAfter = fd < 0;
+  if (closeAfter)
+  {
+    fd = open(kCrashLog, O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd < 0)
+      return;
+  }
+
+  /* The signal is blocked while this handler runs: a nested fault on a
+   * corrupted stack would terminate the process before the log is
+   * complete, so validate every frame before reading it.  The image base is
+   * derived from this function: the eboot is linked at 0x0 (code/data below
+   * 0x8000000) and the heap/direct windows start at 0x2…, so the 128 MiB
+   * range does not swallow them. */
+  const uintptr_t anchor = reinterpret_cast<uintptr_t>(&PS4CrashWrite);
+  const uintptr_t imageBase = anchor & ~uintptr_t(0xFFFFFFF);
+  const uintptr_t imageEnd = imageBase + 0x8000000;
+  const uintptr_t rsp = regs.rsp;
+  uintptr_t stackStart = 0;
+  uintptr_t stackEnd = 0;
+  const bool stackKnown = ThreadStackLookup(
+      reinterpret_cast<uintptr_t>(pthread_self()), &stackStart, &stackEnd);
+  char line[192];
+  int len = snprintf(
+      line, sizeof(line),
+      "  uc-image base=0x%llx end=0x%llx stack=0x%llx..0x%llx rsp=0x%llx "
+      "rsp_mod8=%u\n",
+      static_cast<unsigned long long>(imageBase),
+      static_cast<unsigned long long>(imageEnd),
+      static_cast<unsigned long long>(stackStart),
+      static_cast<unsigned long long>(stackEnd), static_cast<unsigned long long>(rsp),
+      static_cast<unsigned>(rsp & 0x7U));
+  if (len > 0)
+  {
+    const size_t total = static_cast<size_t>(len) < sizeof(line) ? static_cast<size_t>(len)
+                                                                 : sizeof(line) - 1;
+    (void)write(fd, line, total);
+  }
+
+  uintptr_t rbp = regs.rbp;
+  for (int i = 0; i < 16; ++i)
+  {
+    /* The frame chain is only usable when both rsp and every rbp stay inside
+     * the mapping published for this thread; a wild rbp inside the 8 MiB
+     * window could still point to an unmapped page and turn the diagnostic
+     * handler into a second fault. */
+    if (!stackKnown || stackEnd <= 2 * sizeof(uintptr_t) || (rbp & 0x7) != 0 ||
+        rbp < stackStart || rbp > stackEnd - 2 * sizeof(uintptr_t) || rbp < rsp ||
+        rbp - rsp > (8u << 20))
+      break;
+    const auto* frame = reinterpret_cast<const uintptr_t*>(rbp);
+    const uintptr_t next = frame[0];
+    const uintptr_t caller = frame[1];
+    if (caller < imageBase || caller >= imageEnd)
+      break;
+    len = snprintf(line, sizeof(line), "  uc-caller[%02d]=%p\n", i,
+                   reinterpret_cast<void*>(caller));
+    if (len > 0)
+    {
+      const size_t total = static_cast<size_t>(len) < sizeof(line)
+                               ? static_cast<size_t>(len)
+                               : sizeof(line) - 1;
+      (void)write(fd, line, total);
+    }
+    if (next <= rbp || next - rbp > (1u << 20) || next < stackStart ||
+        next > stackEnd - 2 * sizeof(uintptr_t))
+      break;
+    rbp = next;
+  }
+
+  /* When rbp is poisoned (0xfefefefe...) the frame chain is useless.  Dump
+   * the words at rsp and mark values that point back into the image; a
+   * return address overwritten by the allocator fill or by a neighbouring
+   * buffer is then visible in crash.log.  Only read inside the registered
+   * stack mapping, leaving one page of margin over the guard page. */
+  if (stackKnown && rsp >= stackStart + 0x10000 && rsp < stackEnd)
+  {
+    constexpr size_t kDumpWords = 24;
+    const size_t available = static_cast<size_t>(stackEnd - rsp) / sizeof(uintptr_t);
+    const size_t count = available < kDumpWords ? available : kDumpWords;
+    const auto* words = reinterpret_cast<const uintptr_t*>(rsp);
+    for (size_t i = 0; i < count; ++i)
+    {
+      const bool code = words[i] >= imageBase && words[i] < imageEnd;
+      len = snprintf(line, sizeof(line), "  uc-stack[%02zu]=0x%016llx%s\n", i,
+                     static_cast<unsigned long long>(words[i]), code ? " code" : "");
+      if (len > 0)
+      {
+        const size_t total = static_cast<size_t>(len) < sizeof(line)
+                                 ? static_cast<size_t>(len)
+                                 : sizeof(line) - 1;
+        (void)write(fd, line, total);
+      }
+    }
+  }
+  if (closeAfter)
+    close(fd);
+}
