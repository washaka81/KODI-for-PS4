diff --git a/xbmc/platform/ps4/PS4AudioSink.cpp b/xbmc/platform/ps4/PS4AudioSink.cpp
new file mode 100644
index 0000000000..ac08128915
--- /dev/null
+++ b/xbmc/platform/ps4/PS4AudioSink.cpp
@@ -0,0 +1,190 @@
+#include "PS4AudioSink.h"
+
+#include "utils/log.h"
+
+#if defined(__ORBIS__) || defined(PS4)
+extern "C" {
+#include <orbis/AudioOut.h>
+#include <orbis/libkernel.h>
+}
+#endif
+
+namespace kodi::ps4
+{
+namespace
+{
+constexpr int32_t VOLUME_FLAGS = 0x3; // left and right channel
+
+#if defined(__ORBIS__) || defined(PS4)
+bool g_audio_out_initialized = false;
+#endif
+} // namespace
+
+bool PS4AudioSink::Initialize(uint32_t sample_rate, uint32_t channels, bool float_format)
+{
+  if (sample_rate == 0 || channels == 0 || channels > 2)
+  {
+    CLog::Log(LOGERROR, "PS4 audio: invalid format ({} Hz, {} channels)", sample_rate, channels);
+    return false;
+  }
+
+  sample_rate_ = sample_rate;
+  channels_ = channels;
+  frame_size_ = channels_ * (float_format ? sizeof(float) : sizeof(int16_t));
+  chunk_frames_ = CHUNK_FRAMES;
+  chunk_bytes_ = chunk_frames_ * frame_size_;
+  pending_.clear();
+  pending_offset_ = 0;
+  first_submit_ = true;
+
+#if defined(__ORBIS__) || defined(PS4)
+  if (port_handle_ > 0)
+    return true;
+
+  if (!g_audio_out_initialized)
+  {
+    // libSceAudioOut is not resident; resolve it before the first import.
+    const int loadrc =
+        sceKernelLoadStartModule("libSceAudioOut.sprx", 0, nullptr, 0, nullptr, nullptr);
+    CLog::Log(LOGDEBUG, "PS4 audio: load libSceAudioOut rc=0x{:08x}",
+              static_cast<uint32_t>(loadrc));
+
+    const int initrc = sceAudioOutInit();
+    if (initrc != 0)
+    {
+      CLog::Log(LOGERROR, "PS4 audio: sceAudioOutInit rc=0x{:08x}",
+                static_cast<uint32_t>(initrc));
+      return false;
+    }
+    g_audio_out_initialized = true;
+  }
+
+  uint32_t format;
+  if (float_format)
+    format = channels == 1 ? ORBIS_AUDIO_OUT_PARAM_FORMAT_FLOAT_MONO
+                           : ORBIS_AUDIO_OUT_PARAM_FORMAT_FLOAT_STEREO;
+  else
+    format = channels == 1 ? ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_MONO
+                           : ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO;
+
+  port_handle_ = sceAudioOutOpen(ORBIS_USER_SERVICE_USER_ID_SYSTEM,
+                                 ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, chunk_frames_, sample_rate_,
+                                 format);
+  if (port_handle_ <= 0)
+  {
+    CLog::Log(LOGERROR, "PS4 audio: sceAudioOutOpen rc=0x{:08x}",
+                static_cast<uint32_t>(port_handle_));
+    port_handle_ = 0;
+    return false;
+  }
+
+  CLog::Log(LOGINFO,
+            "PS4 audio: AudioOut handle={} format={} rate={} channels={} chunk={} frames",
+            port_handle_, format, sample_rate_, channels_, chunk_frames_);
+
+  SetVolume(volume_);
+  initialized_ = true;
+  return true;
+#else
+  initialized_ = true;
+  return true;
+#endif
+}
+
+void PS4AudioSink::Submit(const void* pcm, std::size_t bytes)
+{
+  if (!initialized_ || !pcm || bytes == 0 || chunk_bytes_ == 0)
+    return;
+
+  const auto* src = static_cast<const uint8_t*>(pcm);
+  pending_.insert(pending_.end(), src, src + bytes);
+
+  while (pending_.size() - pending_offset_ >= chunk_bytes_)
+  {
+    const uint8_t* chunk = pending_.data() + pending_offset_;
+
+#if defined(__ORBIS__) || defined(PS4)
+    // Wait for the previous buffer before queueing the next one, matching
+    // the OpenOrbis AudioOut sample.
+    const int waitrc = sceAudioOutOutput(port_handle_, nullptr);
+    if (waitrc < 0)
+    {
+      CLog::Log(LOGERROR, "PS4 audio: sceAudioOutOutput(wait) rc=0x{:08x}",
+                static_cast<uint32_t>(waitrc));
+      pending_.clear();
+      pending_offset_ = 0;
+      return;
+    }
+
+    const int rc = sceAudioOutOutput(port_handle_, chunk);
+    if (rc < 0)
+    {
+      CLog::Log(LOGERROR, "PS4 audio: sceAudioOutOutput rc=0x{:08x}",
+                static_cast<uint32_t>(rc));
+      pending_.clear();
+      pending_offset_ = 0;
+      return;
+    }
+    if (first_submit_)
+    {
+      CLog::Log(LOGINFO, "PS4 audio: first output queued ({} bytes/chunk)", chunk_bytes_);
+      first_submit_ = false;
+    }
+#else
+    (void)chunk;
+#endif
+
+    pending_offset_ += chunk_bytes_;
+  }
+
+  if (pending_offset_ > 0)
+  {
+    if (pending_offset_ == pending_.size())
+    {
+      pending_.clear();
+      pending_offset_ = 0;
+    }
+    else if (pending_offset_ >= chunk_bytes_ * 8)
+    {
+      pending_.erase(pending_.begin(), pending_.begin() + pending_offset_);
+      pending_offset_ = 0;
+    }
+  }
+}
+
+void PS4AudioSink::SetVolume(float volume)
+{
+  volume_ = volume < 0.0f ? 0.0f : (volume > 1.0f ? 1.0f : volume);
+
+#if defined(__ORBIS__) || defined(PS4)
+  if (port_handle_ > 0)
+  {
+    int32_t levels[2] = {static_cast<int32_t>(volume_ * 32768.0f),
+                         static_cast<int32_t>(volume_ * 32768.0f)};
+    const int rc = sceAudioOutSetVolume(port_handle_, VOLUME_FLAGS, levels);
+    if (rc < 0)
+      CLog::Log(LOGERROR, "PS4 audio: sceAudioOutSetVolume rc=0x{:08x}",
+                  static_cast<uint32_t>(rc));
+  }
+#endif
+}
+
+void PS4AudioSink::Shutdown()
+{
+#if defined(__ORBIS__) || defined(PS4)
+  if (port_handle_ > 0)
+  {
+    const int rc = sceAudioOutClose(port_handle_);
+    if (rc < 0)
+      CLog::Log(LOGERROR, "PS4 audio: sceAudioOutClose rc=0x{:08x}",
+                static_cast<uint32_t>(rc));
+    port_handle_ = 0;
+  }
+#endif
+  pending_.clear();
+  pending_offset_ = 0;
+  first_submit_ = true;
+  initialized_ = false;
+}
+
+} // namespace kodi::ps4
diff --git a/xbmc/platform/ps4/PS4AudioSink.h b/xbmc/platform/ps4/PS4AudioSink.h
new file mode 100644
index 0000000000..0216c3ff1f
--- /dev/null
+++ b/xbmc/platform/ps4/PS4AudioSink.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace kodi::ps4
+{
+
+class PS4AudioSink
+{
+public:
+  bool Initialize(uint32_t sample_rate, uint32_t channels, bool float_format);
+  void Submit(const void* pcm, std::size_t bytes);
+  void SetVolume(float volume);
+  void Shutdown();
+
+  uint32_t GetChunkFrames() const { return chunk_frames_; }
+
+private:
+  static constexpr uint32_t CHUNK_FRAMES = 512;
+
+  uint32_t sample_rate_ = 48000;
+  uint32_t channels_ = 2;
+  uint32_t frame_size_ = 4;
+  uint32_t chunk_frames_ = CHUNK_FRAMES;
+  uint32_t chunk_bytes_ = 0;
+  float volume_ = 1.0f;
+  bool initialized_ = false;
+  bool first_submit_ = true;
+  int32_t port_handle_ = 0;
+  std::vector<uint8_t> pending_;
+  std::size_t pending_offset_ = 0;
+};
+
+} // namespace kodi::ps4
diff --git a/xbmc/platform/ps4/PS4Input.cpp b/xbmc/platform/ps4/PS4Input.cpp
new file mode 100644
index 0000000000..7f7410bf3d
--- /dev/null
+++ b/xbmc/platform/ps4/PS4Input.cpp
@@ -0,0 +1,218 @@
+#include "PS4Input.h"
+
+#include "utils/TimeUtils.h"
+#include "utils/log.h"
+
+#if defined(__ORBIS__) || defined(PS4)
+extern "C" {
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+#include <orbis/libkernel.h>
+}
+
+#ifndef ORBIS_PAD_PORT_TYPE_REMOTE_CONTROL
+#define ORBIS_PAD_PORT_TYPE_REMOTE_CONTROL 16
+#endif
+
+// The PS4 media remote reports its centre button with this bit.
+#ifndef ORBIS_PAD_BUTTON_REMOTE_ENTER
+#define ORBIS_PAD_BUTTON_REMOTE_ENTER 0x80000000u
+#endif
+#endif
+
+namespace kodi::ps4 {
+namespace {
+
+// steady_clock tracks CPU time on Orbis, not wall time; use the same
+// CLOCK_MONOTONIC_RAW source as the rest of the port.
+uint64_t NowMs() {
+  return static_cast<uint64_t>(CurrentHostCounter() / 1000000);
+}
+
+}  // namespace
+
+bool PS4Input::Initialize() {
+  if (initialized_)
+    return true;
+
+#if defined(__ORBIS__) || defined(PS4)
+  // The pad library is a system module.  Load it explicitly for the same
+  // reason as libSceVideoOut: the lazy resolution of the first import can
+  // block in the Kodi process.  Failure here is not fatal (the module may
+  // already be resident).
+  int loadrc = sceKernelLoadStartModule("libScePad.sprx", 0, nullptr, 0, nullptr, nullptr);
+  CLog::Log(LOGDEBUG, "PS4Input: load libScePad rc=0x{:08x}", loadrc);
+
+  int initrc = scePadInit();
+  CLog::Log(LOGINFO, "PS4Input: scePadInit rc=0x{:08x}", initrc);
+
+  // libSceUserService is not resident either; load it before the first
+  // import, otherwise the call can terminate the process.
+  int userloadrc =
+      sceKernelLoadStartModule("libSceUserService.sprx", 0, nullptr, 0, nullptr, nullptr);
+  CLog::Log(LOGDEBUG, "PS4Input: load libSceUserService rc=0x{:08x}", userloadrc);
+
+  // scePadOpen() needs the user that launched the application, not the
+  // literal user 0 (that fails with 0x809b0081 when no pad is attached to
+  // user 0).  Resolve it once, as the OpenOrbis input sample does.
+  OrbisUserServiceInitializeParams userparams{};
+  userparams.priority = ORBIS_KERNEL_PRIO_FIFO_LOWEST;
+  int userrc = sceUserServiceInitialize(&userparams);
+  int32_t user = -1;
+  int getrc = sceUserServiceGetInitialUser(&user);
+  if (getrc < 0 || user < 0) {
+    int fgrc = sceUserServiceGetForegroundUser(&user);
+    if (fgrc >= 0)
+      getrc = fgrc;
+  }
+  if (getrc >= 0 && user >= 0)
+    user_id_ = user;
+  else
+    user_id_ = 0;
+  CLog::Log(LOGINFO, "PS4Input: user service rc=0x{:08x} initial rc=0x{:08x}", userrc, getrc);
+
+  TryOpen();
+#endif
+
+  initialized_ = true;
+  return true;
+}
+
+void PS4Input::TryOpen() {
+#if defined(__ORBIS__) || defined(PS4)
+  const uint64_t now = NowMs();
+  if (now < next_open_ms_)
+    return;
+  next_open_ms_ = now + 1000;
+
+  if (handle_ < 0)
+  {
+    handle_ = scePadOpen(user_id_, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+    if (handle_ >= 0)
+      CLog::Log(LOGINFO, "PS4Input: pad opened handle={}", handle_);
+    else
+      CLog::Log(LOGDEBUG, "PS4Input: scePadOpen failed rc=0x{:08x}",
+                static_cast<uint32_t>(handle_));
+  }
+
+  if (remote_handle_ < 0)
+  {
+    remote_handle_ = scePadOpen(ORBIS_USER_SERVICE_USER_ID_SYSTEM,
+                                ORBIS_PAD_PORT_TYPE_REMOTE_CONTROL, 0, nullptr);
+    if (remote_handle_ >= 0)
+      CLog::Log(LOGINFO, "PS4Input: media remote opened handle={}", remote_handle_);
+    else
+      CLog::Log(LOGDEBUG, "PS4Input: media remote not present rc=0x{:08x}",
+                static_cast<uint32_t>(remote_handle_));
+  }
+#endif
+}
+
+void PS4Input::Close() {
+#if defined(__ORBIS__) || defined(PS4)
+  if (handle_ >= 0) {
+    scePadClose(handle_);
+    CLog::Log(LOGINFO, "PS4Input: pad closed handle={}", handle_);
+  }
+  if (remote_handle_ >= 0) {
+    scePadClose(remote_handle_);
+    CLog::Log(LOGINFO, "PS4Input: media remote closed handle={}", remote_handle_);
+  }
+#endif
+  handle_ = -1;
+  remote_handle_ = -1;
+  state_ = PS4InputState{};
+}
+
+void PS4Input::Poll() {
+  if (!initialized_)
+    return;
+
+#if defined(__ORBIS__) || defined(PS4)
+  if (handle_ < 0 || remote_handle_ < 0)
+    TryOpen();
+
+  OrbisPadData data{};
+  bool havePad = false;
+  if (handle_ >= 0)
+  {
+    const int rc = scePadReadState(handle_, &data);
+    if (rc < 0)
+    {
+      CLog::Log(LOGINFO, "PS4Input: pad disconnected rc=0x{:08x}",
+                static_cast<uint32_t>(rc));
+      Close();
+    }
+    else if (data.connected != 0)
+    {
+      havePad = true;
+    }
+  }
+
+  OrbisPadData remote{};
+  bool haveRemote = false;
+  if (remote_handle_ >= 0)
+  {
+    const int rc = scePadReadState(remote_handle_, &remote);
+    if (rc < 0)
+    {
+      scePadClose(remote_handle_);
+      remote_handle_ = -1;
+    }
+    else if (remote.connected != 0)
+    {
+      haveRemote = true;
+    }
+  }
+
+  if (!havePad && !haveRemote)
+  {
+    state_ = PS4InputState{};
+    return;
+  }
+
+  const OrbisPadData& src = havePad ? data : remote;
+  PS4InputState state{};
+  state.connected = true;
+
+  const uint32_t buttons = src.buttons;
+  state.up = (buttons & ORBIS_PAD_BUTTON_UP) != 0;
+  state.down = (buttons & ORBIS_PAD_BUTTON_DOWN) != 0;
+  state.left = (buttons & ORBIS_PAD_BUTTON_LEFT) != 0;
+  state.right = (buttons & ORBIS_PAD_BUTTON_RIGHT) != 0;
+  state.confirm = (buttons & ORBIS_PAD_BUTTON_CROSS) != 0;
+  state.back = (buttons & ORBIS_PAD_BUTTON_CIRCLE) != 0;
+  state.play_pause = (buttons & ORBIS_PAD_BUTTON_OPTIONS) != 0;
+  state.context_menu = (buttons & ORBIS_PAD_BUTTON_SQUARE) != 0;
+  state.page_up = (buttons & (ORBIS_PAD_BUTTON_L1 | ORBIS_PAD_BUTTON_L2)) != 0;
+  state.page_down = (buttons & (ORBIS_PAD_BUTTON_R1 | ORBIS_PAD_BUTTON_R2)) != 0;
+
+  // Merge the media remote regardless of which device provided the primary
+  // data (the remote may report the same navigation bits).
+  if (haveRemote)
+  {
+    const uint32_t remoteButtons = remote.buttons;
+    state.up |= (remoteButtons & ORBIS_PAD_BUTTON_UP) != 0;
+    state.down |= (remoteButtons & ORBIS_PAD_BUTTON_DOWN) != 0;
+    state.left |= (remoteButtons & ORBIS_PAD_BUTTON_LEFT) != 0;
+    state.right |= (remoteButtons & ORBIS_PAD_BUTTON_RIGHT) != 0;
+    state.confirm |= (remoteButtons & ORBIS_PAD_BUTTON_CROSS) != 0;
+    state.confirm |= (remoteButtons & ORBIS_PAD_BUTTON_REMOTE_ENTER) != 0;
+    state.back |= (remoteButtons & ORBIS_PAD_BUTTON_CIRCLE) != 0;
+    state.play_pause |= (remoteButtons & ORBIS_PAD_BUTTON_OPTIONS) != 0;
+  }
+
+  // PS4 sticks are 0..255 with (128,128) at rest.  Normalise to [-1, 1];
+  // Y is inverted because Kodi's screen coordinates grow downwards.
+  state.stick_x = (static_cast<float>(src.leftStick.x) - 128.0f) / 127.0f;
+  state.stick_y = (128.0f - static_cast<float>(src.leftStick.y)) / 127.0f;
+  state_ = state;
+#endif
+}
+
+void PS4Input::Shutdown() {
+  Close();
+  initialized_ = false;
+}
+
+}  // namespace kodi::ps4
diff --git a/xbmc/platform/ps4/PS4Input.h b/xbmc/platform/ps4/PS4Input.h
new file mode 100644
index 0000000000..ed53afae17
--- /dev/null
+++ b/xbmc/platform/ps4/PS4Input.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstdint>
+
+namespace kodi::ps4 {
+
+struct PS4InputState {
+  bool connected = false;
+  bool up = false;
+  bool down = false;
+  bool left = false;
+  bool right = false;
+  bool confirm = false;
+  bool back = false;
+  bool play_pause = false;
+  bool context_menu = false;
+  bool page_up = false;
+  bool page_down = false;
+  float stick_x = 0.0f;
+  float stick_y = 0.0f;
+};
+
+class PS4Input {
+ public:
+  bool Initialize();
+  void Poll();
+  PS4InputState State() const { return state_; }
+  void Shutdown();
+
+ private:
+  void TryOpen();
+  void Close();
+
+  PS4InputState state_{};
+  int32_t handle_ = -1;
+  int32_t remote_handle_ = -1;
+  int32_t user_id_ = -1;
+  uint64_t next_open_ms_ = 0;
+  bool initialized_ = false;
+};
+
+}  // namespace kodi::ps4
