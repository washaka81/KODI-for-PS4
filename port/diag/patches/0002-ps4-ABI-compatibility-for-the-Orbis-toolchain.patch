diff --git a/xbmc/FileItemList.cpp b/xbmc/FileItemList.cpp
index 6adcee2a97..f0d53ca15e 100644
--- a/xbmc/FileItemList.cpp
+++ b/xbmc/FileItemList.cpp
@@ -678,11 +678,10 @@ void ChangeFolderToFile(const std::shared_ptr<CFileItem>& item, const std::strin
 
 void ConvertDiscFoldersToFiles(std::vector<std::shared_ptr<CFileItem>> items)
 {
-  auto folderItems{items | std::views::filter(
-                               [](const std::shared_ptr<CFileItem>& item) {
-                                 return item->IsFolder() &&
-                                        !item->GetProperty(PROPERTY_UNCHANGED).asBoolean();
-                               })};
+  std::vector<std::shared_ptr<CFileItem>> folderItems;
+  for (const auto& item : items)
+    if (item->IsFolder() && !item->GetProperty(PROPERTY_UNCHANGED).asBoolean())
+      folderItems.push_back(item);
   for (const auto& item : folderItems)
   {
     if (auto playPath{VIDEO::UTILS::GetOpticalMediaPath(*item)}; !playPath.empty())
@@ -838,18 +837,15 @@ void CFileItemList::Stack()
 
   // Find stacks
   std::vector<int> deleteItems;
-  for (const auto& [candidate, count] :
-       countedCandidates | std::views::filter([](const auto& c) { return c.second > 1; }))
+  for (const auto& [candidate, count] : countedCandidates)
   {
+    if (!(count > 1)) continue;
+
     // Find all the parts of this stack (sorted by volume)
     std::vector<StackCandidate> parts;
-    std::ranges::copy(stackCandidates | std::views::filter(
-                                            [type = candidate.type, title = candidate.title,
-                                             remainder = candidate.remainder](const auto& item) {
-                                              return item.type == type && item.title == title &&
-                                                     item.remainder == remainder;
-                                            }),
-                      std::back_inserter(parts));
+    for (const auto& item : stackCandidates)
+      if (item.type == candidate.type && item.title == candidate.title && item.remainder == candidate.remainder)
+        parts.push_back(item);
 
     // Every part of a stack should be a different volume
     if (std::ranges::adjacent_find(parts, {}, &StackCandidate::volume) != parts.end())
@@ -914,7 +910,7 @@ void CFileItemList::Stack()
 
   // Delete unneeded items
   // Sort and delete from last to first (otherwise index is no longer correct)
-  std::ranges::sort(deleteItems, std::greater());
+  std::ranges::sort(deleteItems, std::greater<int>());
   for (int i : deleteItems)
     Remove(i);
 }
diff --git a/xbmc/FileItemList.h b/xbmc/FileItemList.h
index 4e74fe4dc9..7e9a0fbc58 100644
--- a/xbmc/FileItemList.h
+++ b/xbmc/FileItemList.h
@@ -62,7 +62,22 @@ public:
     std::string playPath; // for a folder candidate: the file inside the folder
     std::string pattern; // the stack expression that matched, for logging
 
-    auto operator<=>(const StackCandidate&) const = default;
+    bool operator==(const StackCandidate& o) const
+    {
+      return type == o.type && title == o.title && volume == o.volume && remainder == o.remainder &&
+             size == o.size && index == o.index && playPath == o.playPath && pattern == o.pattern;
+    }
+    bool operator<(const StackCandidate& o) const
+    {
+      if (type != o.type) return type < o.type;
+      if (title != o.title) return title < o.title;
+      if (volume != o.volume) return volume < o.volume;
+      if (remainder != o.remainder) return remainder < o.remainder;
+      if (size != o.size) return size < o.size;
+      if (index != o.index) return index < o.index;
+      if (playPath != o.playPath) return playPath < o.playPath;
+      return pattern < o.pattern;
+    }
   };
 
   struct CountedStackCandidate
@@ -71,7 +86,16 @@ public:
     std::string title;
     std::string remainder;
 
-    auto operator<=>(const CountedStackCandidate& other) const = default;
+    bool operator==(const CountedStackCandidate& o) const
+    {
+      return type == o.type && title == o.title && remainder == o.remainder;
+    }
+    bool operator<(const CountedStackCandidate& o) const
+    {
+      if (type != o.type) return type < o.type;
+      if (title != o.title) return title < o.title;
+      return remainder < o.remainder;
+    }
   };
 
   CFileItemList();
