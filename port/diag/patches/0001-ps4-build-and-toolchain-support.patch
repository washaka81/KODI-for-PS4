diff --git a/tools/depends/target/ffmpeg/009-ffmpeg-all-ps4-socket-cloexec-retry.patch b/tools/depends/target/ffmpeg/009-ffmpeg-all-ps4-socket-cloexec-retry.patch
new file mode 100644
index 0000000000..10a5a59a5b
--- /dev/null
+++ b/tools/depends/target/ffmpeg/009-ffmpeg-all-ps4-socket-cloexec-retry.patch
@@ -0,0 +1,22 @@
+From: Kodi PS4 port
+Subject: [PATCH] libavformat: retry socket() without SOCK_CLOEXEC on EPROTONOSUPPORT
+
+The Orbis socket layer rejects SOCK_CLOEXEC (and SOCK_NONBLOCK) in the
+socket type with EPROTONOSUPPORT instead of EINVAL.  ff_socket() only
+retried without the flag on EINVAL, so every FFmpeg network open failed
+with "Protocol not supported" (HLS/HTTP/TCP could not connect).
+
+Retry without SOCK_CLOEXEC on EPROTONOSUPPORT as well.  The fcntl
+FD_CLOEXEC fallback below still applies, so the flag is not lost.
+---
+--- a/libavformat/network.c
++++ b/libavformat/network.c
+@@ -186,7 +186,7 @@ int ff_socket(int af, int type, int proto, void *logctx)
+ 
+ #ifdef SOCK_CLOEXEC
+     fd = socket(af, type | SOCK_CLOEXEC, proto);
+-    if (fd == -1 && errno == EINVAL)
++    if (fd == -1 && (errno == EINVAL || errno == EPROTONOSUPPORT))
+ #endif
+     {
+         fd = socket(af, type, proto);
diff --git a/tools/depends/target/ffmpeg/010-ffmpeg-all-ps4-getaddrinfo-retry.patch b/tools/depends/target/ffmpeg/010-ffmpeg-all-ps4-getaddrinfo-retry.patch
new file mode 100644
index 0000000000..1b71ce1873
--- /dev/null
+++ b/tools/depends/target/ffmpeg/010-ffmpeg-all-ps4-getaddrinfo-retry.patch
@@ -0,0 +1,36 @@
+From: Kodi PS4 port
+Subject: [PATCH] libavformat/tcp: retry getaddrinfo on EAI_AGAIN
+
+The PS4 resolver intermittently returns EAI_AGAIN ("Try again") when
+several add-on/logo threads resolve at once.  tcp_open() aborted the
+whole HLS/channel switch on the first failure:
+
+  [tcp] Failed to resolve hostname <live-host>: Try again
+  OpenDemuxStream - Error creating demuxer
+
+Retry a few times with a short backoff before giving up.
+---
+--- a/libavformat/tcp.c
++++ b/libavformat/tcp.c
+@@ -183,9 +183,17 @@ static int tcp_open(URLContext *h, const char *uri, int flags)
+     if (s->listen)
+         hints.ai_flags |= AI_PASSIVE;
+-    if (!hostname[0])
+-        ret = getaddrinfo(NULL, portstr, &hints, &ai);
+-    else
+-        ret = getaddrinfo(hostname, portstr, &hints, &ai);
++    for (int attempt = 0; attempt < 3; attempt++) {
++        if (!hostname[0])
++            ret = getaddrinfo(NULL, portstr, &hints, &ai);
++        else
++            ret = getaddrinfo(hostname, portstr, &hints, &ai);
++        if (ret == 0 || ret != EAI_AGAIN)
++            break;
++        av_log(h, AV_LOG_WARNING,
++               "getaddrinfo(%s) returned EAI_AGAIN, retry %d/3\n",
++               hostname, attempt + 1);
++        av_usleep(100000 * (attempt + 1));
++    }
+     if (ret) {
+         av_log(h, AV_LOG_ERROR,
+                "Failed to resolve hostname %s: %s\n",
diff --git a/tools/depends/target/ffmpeg/011-ffmpeg-all-ps4-tcp-tuning.patch b/tools/depends/target/ffmpeg/011-ffmpeg-all-ps4-tcp-tuning.patch
new file mode 100644
index 0000000000..baa55cea86
--- /dev/null
+++ b/tools/depends/target/ffmpeg/011-ffmpeg-all-ps4-tcp-tuning.patch
@@ -0,0 +1,52 @@
+From: Kodi PS4 port
+Subject: [PATCH] libavformat/tcp: automatic PS4 socket tuning
+
+Set streaming-friendly defaults for the PS4 network hardware: 256 KiB
+kernel send/receive buffers, TCP_NODELAY, keepalive with short probes and
+a 30 s read timeout so a dead peer cannot leave the player blocked.
+
+These defaults are overridable with the existing tcp_* AVOptions.
+---
+--- a/libavformat/tcp.c
++++ b/libavformat/tcp.c
+@@ -58,12 +58,12 @@
+     { "listen",          "Listen for incoming connections",  OFFSET(listen),         AV_OPT_TYPE_INT, { .i64 = 0 },     0,       2,       .flags = D|E },
+     { "local_port",      "Local port",                                         OFFSET(local_port),     AV_OPT_TYPE_STRING, { .str = NULL },     0,       0, .flags = D|E },
+     { "local_addr",      "Local address",                                      OFFSET(local_addr),     AV_OPT_TYPE_STRING, { .str = NULL },     0,       0, .flags = D|E },
+-    { "timeout",     "set timeout (in microseconds) of socket I/O operations", OFFSET(rw_timeout),     AV_OPT_TYPE_INT, { .i64 = -1 },         -1, INT_MAX, .flags = D|E },
++    { "timeout",     "set timeout (in microseconds) of socket I/O operations", OFFSET(rw_timeout),     AV_OPT_TYPE_INT, { .i64 = 30000000 },    -1, INT_MAX, .flags = D|E },
+     { "listen_timeout",  "Connection awaiting timeout (in milliseconds)",      OFFSET(listen_timeout), AV_OPT_TYPE_INT, { .i64 = -1 },         -1, INT_MAX, .flags = D|E },
+-    { "send_buffer_size", "Socket send buffer size (in bytes)",                OFFSET(send_buffer_size), AV_OPT_TYPE_INT, { .i64 = -1 },         -1, INT_MAX, .flags = D|E },
+-    { "recv_buffer_size", "Socket receive buffer size (in bytes)",             OFFSET(recv_buffer_size), AV_OPT_TYPE_INT, { .i64 = -1 },         -1, INT_MAX, .flags = D|E },
