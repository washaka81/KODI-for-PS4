+From: Kodi PS4 port
+Subject: [PATCH] libavformat/tls_openssl: prefer classic TLS groups on PS4
+
+OpenSSL 3.5 sends X25519MLKEM768 by default.  The post-quantum key share
+makes the Client Hello ~1.5 KiB; the lossy 2.4 GHz link drops that packet
+and TCP retransmits after ~5 s on every new HTTPS connection.  Prefer
+X25519/P-256 so the hello fits in one segment.
+---
+--- a/libavformat/tls_openssl.c
++++ b/libavformat/tls_openssl.c
+@@ -802,6 +802,15 @@
+         ret = AVERROR(EIO);
+         goto fail;
+     }
++#if defined(SSL_CTX_set1_groups_list)
++    /* PS4: OpenSSL 3.5 offers X25519MLKEM768 by default; the ~1.2 KiB
++     * post-quantum key share makes the Client Hello ~1.5 KiB, which the
++     * lossy 2.4 GHz link drops.  TCP retransmits after ~5 s on every new
++     * HTTPS connection.  Prefer classic groups so the hello fits in one
++     * segment; both are supported by every current CDN. */
++    if (!s->is_dtls && !SSL_CTX_set1_groups_list(c->ctx, "X25519:P-256"))
++        av_log(h, AV_LOG_DEBUG, "Failed to set TLS groups: %s\n", openssl_get_error(c));
++#endif
+     if (!s->is_dtls) {
+         if (!SSL_CTX_set_min_proto_version(c->ctx, TLS1_VERSION)) {
+             av_log(h, AV_LOG_ERROR, "Failed to set minimum TLS version to TLSv1\n");
