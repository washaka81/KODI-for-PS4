+
+void CNetworkFreebsd::GetMacAddress(const std::string& interfaceName, char rawMac[6])
+{
+  memset(rawMac, 0, 6);
+
+#if defined(__ORBIS__)
+  // PS4's ioctl(SIOCGIFHWADDR) can block during startup; try the native API
+  // first and fall back to the ioctl only if it fails.
+  (void)interfaceName;
+  OrbisNetEtherAddr ether = {};
+  if (sceNetGetMacAddress(&ether, sizeof(ether)) == 0)
+  {
+    memcpy(rawMac, ether.data, 6);
+  }
+  else
+  {
+    const int sock = socket(AF_INET, SOCK_DGRAM, 0);
+    if (sock >= 0)
+    {
+      struct ifreq ifr = {};
+      strncpy(ifr.ifr_name, interfaceName.c_str(), IFNAMSIZ - 1);
+      if (ioctl(sock, SIOCGIFHWADDR, &ifr) == 0)
+        memcpy(rawMac, ifr.ifr_hwaddr.sa_data, 6);
+      close(sock);
+    }
+  }
+#else
+#if !defined(IFT_ETHER)
+#define IFT_ETHER 0x6 /* Ethernet CSMACD */
+#endif
+  const struct sockaddr_dl* dlAddr = NULL;
+  const uint8_t* base = NULL;
+  // Query the list of interfaces.
+  struct ifaddrs* list;
+  struct ifaddrs* interface;
+
+  if (getifaddrs(&list) < 0)
+  {
+    return;
+  }
+
+  for (interface = list; interface != NULL; interface = interface->ifa_next)
+  {
+    if (interfaceName == interface->ifa_name)
+    {
+      if ((interface->ifa_addr->sa_family == AF_LINK) &&
+          (((const struct sockaddr_dl*)interface->ifa_addr)->sdl_type == IFT_ETHER))
+      {
+        dlAddr = (const struct sockaddr_dl*)interface->ifa_addr;
+        base = (const uint8_t*)&dlAddr->sdl_data[dlAddr->sdl_nlen];
+
+        if (dlAddr->sdl_alen > 5)
+        {
+          memcpy(rawMac, base, 6);
+        }
+      }
+      break;
+    }
+  }
+
+  freeifaddrs(list);
+#endif
+}
+
+void CNetworkFreebsd::queryInterfaceList()
+{
+  char macAddrRaw[6];
+  m_interfaces.clear();
+
+  // Query the list of interfaces.
+  struct ifaddrs* list = nullptr;
+  if (getifaddrs(&list) < 0)
+  {
+    // getifaddrs() is empty on some PS4 firmware revisions.  NetCtl is
+    // initialised before the network service is created, so fall back to
+    // the address reported by the system.
+    const auto& profile = KODI::PLATFORM::PS4::GetHardwareProfile();
+    if (profile.netValid && !profile.netIp.empty())
+    {
+      char macAddrRawFallback[6] = {};
+      const std::string ifName = profile.netInterface.empty() ? "eth0" : profile.netInterface;
+      GetMacAddress(ifName, macAddrRawFallback);
+      auto* iface = new CNetworkInterfaceFreebsd(this, ifName, macAddrRawFallback);
+      iface->SetPS4Address(inet_addr(profile.netIp.c_str()));
+      iface->SetPS4Netmask(inet_addr(profile.netMask.c_str()));
+      m_interfaces.push_back(iface);
+      CLog::Log(LOGINFO, "PS4 network: netctl interface {}", ifName);
+    }
+    return;
+  }
+
+  struct ifaddrs* cur;
+  for (cur = list; cur != NULL; cur = cur->ifa_next)
+  {
+    if (!cur->ifa_addr || cur->ifa_addr->sa_family != AF_INET)
+      continue;
+
+    const auto* address = reinterpret_cast<const struct sockaddr_in*>(cur->ifa_addr);
+    if (address->sin_addr.s_addr == 0 || address->sin_addr.s_addr == htonl(INADDR_LOOPBACK))
+      continue;
+
+    GetMacAddress(cur->ifa_name, macAddrRaw);
+    auto* iface = new CNetworkInterfaceFreebsd(this, cur->ifa_name, macAddrRaw);
+    iface->SetPS4Address(address->sin_addr.s_addr);
+    if (cur->ifa_netmask && cur->ifa_netmask->sa_family == AF_INET)
+    {
+      const auto* netmask = reinterpret_cast<const struct sockaddr_in*>(cur->ifa_netmask);
+      iface->SetPS4Netmask(netmask->sin_addr.s_addr);
+    }
+    m_interfaces.push_back(iface);
+
+    CLog::Log(LOGINFO, "PS4 network: interface {}", cur->ifa_name);
+  }
+
+  freeifaddrs(list);
+
+  if (m_interfaces.empty())
+  {
+    const auto& profile = KODI::PLATFORM::PS4::GetHardwareProfile();
+    if (profile.netValid && !profile.netIp.empty())
+    {
+      char macAddrRawFallback[6] = {};
+      const std::string ifName = profile.netInterface.empty() ? "eth0" : profile.netInterface;
+      GetMacAddress(ifName, macAddrRawFallback);
+      auto* iface = new CNetworkInterfaceFreebsd(this, ifName, macAddrRawFallback);
+      iface->SetPS4Address(inet_addr(profile.netIp.c_str()));
+      iface->SetPS4Netmask(inet_addr(profile.netMask.c_str()));
+      m_interfaces.push_back(iface);
+      CLog::Log(LOGINFO, "PS4 network: netctl interface {}", ifName);
+    }
+  }
+}
+
+std::vector<std::string> CNetworkFreebsd::GetNameServers()
+{
+  std::vector<std::string> result;
+
+  res_init();
+
+  for (int i = 0; i < _res.nscount; i++)
+  {
+    std::string ns = inet_ntoa(_res.nsaddr_list[i].sin_addr);
+    result.push_back(ns);
+  }
+
+  if (result.empty())
+  {
+    const auto& profile = KODI::PLATFORM::PS4::GetHardwareProfile();
+    if (!profile.netDns1.empty())
+      result.push_back(profile.netDns1);
+    if (!profile.netDns2.empty())
+      result.push_back(profile.netDns2);
+  }
+
+  return result;
+}
+
+bool CNetworkFreebsd::PingHost(unsigned long remote_ip, unsigned int timeout_ms)
+{
+  char cmd_line[64];
+
+  struct in_addr host_ip;
+  host_ip.s_addr = remote_ip;
+
+  snprintf(cmd_line, sizeof(cmd_line), "ping -c 1 -t %d %s",
+           timeout_ms / 1000 + (timeout_ms % 1000) != 0, inet_ntoa(host_ip));
+
+  int status = -1;
+  status = system(cmd_line);
+  int result = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+
+  // http://linux.about.com/od/commands/l/blcmdl8_ping.htm ;
+  // 0 reply
+  // 1 no reply
+  // else some error
+
+  if (result < 0 || result > 1)
+    CLog::Log(LOGERROR, "Ping fail : status = {}, errno = {} : '{}'", status, errno, cmd_line);
+
+  return result == 0;
+}
