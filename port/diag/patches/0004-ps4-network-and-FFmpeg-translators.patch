+#if defined(__ORBIS__)
+curl_socket_t PS4OpenSocket(void* /*clientp*/, curlsocktype /*purpose*/,
+                            struct curl_sockaddr* address)
+{
+  // curl asks for SOCK_NONBLOCK in the socket type; the Orbis socket layer
+  // rejects the flag, so create a plain socket and set it with fcntl.
+  int type = address->socktype;
+#ifdef SOCK_NONBLOCK
+  type &= ~SOCK_NONBLOCK;
+#endif
+#ifdef SOCK_CLOEXEC
+  type &= ~SOCK_CLOEXEC;
+#endif
+
+  const curl_socket_t fd = socket(address->family, type, address->protocol);
+  if (fd == CURL_SOCKET_BAD)
+    return CURL_SOCKET_BAD;
+
+  const int flags = fcntl(fd, F_GETFL, 0);
+  if (flags >= 0)
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  fcntl(fd, F_SETFD, FD_CLOEXEC);
+
+  /* Tune every curl socket for the console network: enough kernel buffering
+   * for 1080p/HLS bursts, Nagle off for zapping, and keepalive so a dead
+   * peer is detected instead of leaving the player blocked forever.  These
+   * are generic values; the MTU/device are collected in the hardware
+   * profile for diagnostics. */
+  const int one = 1;
+  const int recvBuffer = 256 * 1024;
+  const int sendBuffer = 256 * 1024;
+  const int keepIdle = 30;
+  const int keepInterval = 10;
+  const int keepCount = 3;
+  (void)setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &recvBuffer, sizeof(recvBuffer));
+  (void)setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &sendBuffer, sizeof(sendBuffer));
+  (void)setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+  (void)setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, sizeof(one));
+#ifdef TCP_KEEPIDLE
+  (void)setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &keepIdle, sizeof(keepIdle));
+#endif
+#ifdef TCP_KEEPINTVL
+  (void)setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &keepInterval, sizeof(keepInterval));
+#endif
+#ifdef TCP_KEEPCNT
+  (void)setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &keepCount, sizeof(keepCount));
+#endif
+
+  /* Log the effective kernel buffer sizes once; the kernel may clamp the
+   * requested values. */
+  static std::once_flag tuneLogged;
+  std::call_once(tuneLogged,
+                 [fd, keepIdle, keepInterval, keepCount]()
+                 {
+                   int actualRecv = 0;
+                   int actualSend = 0;
+                   socklen_t length = sizeof(actualRecv);
+                   if (getsockopt(fd, SOL_SOCKET, SO_RCVBUF, &actualRecv, &length) != 0)
+                     actualRecv = -1;
+                   length = sizeof(actualSend);
+                   if (getsockopt(fd, SOL_SOCKET, SO_SNDBUF, &actualSend, &length) != 0)
+                     actualSend = -1;
+                   CLog::Log(LOGINFO,
+                             "PS4 net: socket tuning rcvbuf={} sndbuf={} nodelay=1 "
+                             "keepalive={}/{}/{}",
+                             actualRecv, actualSend, keepIdle, keepInterval, keepCount);
+                 });
+  return fd;
+}
+#endif
+
