   if (url.IsProtocol("http") || url.IsProtocol("https"))
   {
+#if defined(__ORBIS__)
+    /* The PS4 Wi-Fi link drops packets while the player is buffering.  Let
+     * FFmpeg reconnect HLS segment/playlist requests instead of returning a
+     * spurious EOF; protocol options below can still override these. */
+    av_dict_set_int(&options, "reconnect", 1, 0);
+    av_dict_set_int(&options, "reconnect_on_network_error", 1, 0);
+    av_dict_set_int(&options, "reconnect_streamed", 1, 0);
+    av_dict_set_int(&options, "reconnect_delay_max", 2, 0);
+    av_dict_set_int(&options, "reconnect_max_retries", 3, 0);
+    /* Each new TLS connection costs ~5 s on the console's Wi-Fi, so do not
+     * probe several HLS segments before starting: 2 MB/2 s is enough for
+     * H.264/AAC and starts closer to the live edge. */
+    av_dict_set_int(&options, "probesize", 2 * 1024 * 1024, 0);
+    av_dict_set_int(&options, "analyzeduration", 2 * 1000000, 0);
+    av_dict_set_int(&options, "live_start_index", -1, 0);
+#endif
+
     std::map<std::string, std::string> protocolOptions;
     url.GetProtocolOptions(protocolOptions);
     std::string headers;
