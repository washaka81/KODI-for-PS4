+      double nameLookup = 0.0;
+      double connect = 0.0;
+      double appConnect = 0.0;
+      curl_off_t size = 0;
+      g_curlInterface.easy_getinfo(easyHandle, CURLINFO_NAMELOOKUP_TIME, &nameLookup);
+      g_curlInterface.easy_getinfo(easyHandle, CURLINFO_CONNECT_TIME, &connect);
+      g_curlInterface.easy_getinfo(easyHandle, CURLINFO_APPCONNECT_TIME, &appConnect);
+      g_curlInterface.easy_getinfo(easyHandle, CURLINFO_SIZE_DOWNLOAD_T, &size);
+      CLog::Log(LOGINFO,
+                "CCurlFile::{} - slow transfer total={:.0f} ms dns={:.0f} ms connect={:.0f} "
+                "ms tls={:.0f} ms bytes={}",
+                functionName, total * 1000.0, nameLookup * 1000.0, connect * 1000.0,
+                appConnect * 1000.0, size);
+    }
+  }
+#endif
   return result;
 }
 
