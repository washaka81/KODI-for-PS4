+bool DllLibCurlGlobal::EnsureInit()
+{
+  if (m_initialized)
+    return true;
+
+  /* Do this lazily from the app thread instead of a static constructor:
+   * on PS4 the global constructor can run before the runtime is ready. */
+  const CURLcode rc = curl_global_init(CURL_GLOBAL_ALL);
+  CLog::Log(LOGINFO, "Curl: global_init rc={}", static_cast<int>(rc));
+  if (rc != CURLE_OK)
+  {
+    CLog::Log(LOGERROR, "Curl: global_init failed: {}", easy_strerror(rc));
+    return false;
+  }
+  m_initialized = true;
+  return true;
