+#if defined(__ORBIS__)
+  /* The PS4 Wi-Fi link is the bottleneck for the M3U, repository and HLS
+   * metadata.  Log the slow requests with a phase breakdown so the log shows
+   * whether the time is DNS, TCP connect, TLS or the transfer itself. */
