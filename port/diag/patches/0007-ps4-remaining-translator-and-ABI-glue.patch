diff --git a/xbmc/platform/posix/filesystem/PosixFile.cpp b/xbmc/platform/posix/filesystem/PosixFile.cpp
index a093f7e821..5370902bf3 100644
--- a/xbmc/platform/posix/filesystem/PosixFile.cpp
+++ b/xbmc/platform/posix/filesystem/PosixFile.cpp
@@ -58,6 +58,8 @@ bool CPosixFile::Open(const CURL& url)
 
   m_fd = open(filename.c_str(), O_RDONLY, S_IRUSR | S_IRGRP | S_IROTH);
   m_filePos = 0;
+  if (m_fd >= 0)
+    m_filename = filename;
 
   return m_fd != -1;
 }
@@ -76,6 +78,7 @@ bool CPosixFile::OpenForWrite(const CURL& url, bool bOverWrite /* = false*/ )
     return false;
 
   m_filePos = 0;
+  m_filename = filename;
   m_allowWrite = true;
 
   return true;
@@ -87,6 +90,7 @@ void CPosixFile::Close()
   {
     close(m_fd);
     m_fd = -1;
+    m_filename.clear();
     m_filePos = -1;
     m_lastDropPos = -1;
     m_allowWrite = false;
@@ -211,6 +215,20 @@ int64_t CPosixFile::GetLength()
   if (m_fd < 0)
     return -1;
 
+#if defined(TARGET_PS4)
+  // The PS4 kernel's stat layout does not match the SDK's struct stat:
+  // st_size can be a small unrelated value (e.g. 32128 for a 16 MB file),
+  // which breaks MP4s whose moov atom is at the end. lseek(SEEK_END) is
+  // reliable and keeps the current file position intact.
+  const off_t savedPos = lseek(m_fd, 0, SEEK_CUR);
+  if (savedPos >= 0)
+  {
+    const off_t endPos = lseek(m_fd, 0, SEEK_END);
+    if (lseek(m_fd, savedPos, SEEK_SET) >= 0 && endPos >= 0)
+      return endPos;
+  }
+#endif
+
   struct stat64 st;
   if (fstat64(m_fd, &st) != 0)
     return -1;
@@ -374,7 +392,22 @@ int CPosixFile::Stat(const CURL& url, struct __stat64* buffer)
   }
   return ret;
 #else
-  return stat64(filename.c_str(), buffer);
+  const int ret = stat64(filename.c_str(), buffer);
+#if defined(TARGET_PS4)
+  // st_size is not trustworthy on PS4; lseek(SEEK_END) gives the real size.
+  if (ret == 0 && S_ISREG(buffer->st_mode))
+  {
+    const int fd = open(filename.c_str(), O_RDONLY);
+    if (fd >= 0)
+    {
+      const off_t endPos = lseek(fd, 0, SEEK_END);
+      close(fd);
+      if (endPos >= 0)
+        buffer->st_size = endPos;
+    }
+  }
+#endif
+  return ret;
 #endif
 }
 
@@ -384,5 +417,15 @@ int CPosixFile::Stat(struct __stat64* buffer)
   if (m_fd < 0 || !buffer)
     return -1;
 
+#if defined(TARGET_PS4)
+  if (!m_filename.empty() && stat64(m_filename.c_str(), buffer) == 0)
+  {
+    const int64_t length = GetLength();
+    if (length >= 0)
+      buffer->st_size = length;
+    return 0;
+  }
+#endif
+
   return fstat64(m_fd, buffer);
 }
