+/* PS4: reconnects are expensive on a lossy link, so keep two
+ * process-wide caches: the parsed CA chain (a large PEM otherwise
+ * parsed on every open) and the last client session per host (a
+ * resumed handshake is one round trip instead of a full one).
+ *
+ * The CA chain is reference-counted because its ownership is shared
+ * between the cache slot and every open TLS context: retiring the
+ * cached entry (CA file change) or closing a context only frees the
+ * chain when the last reference is gone, so a handshake can never be
+ * handed a freed chain.  The session cache retains up to 16 hosts (LRU)
+ * so streams with separate playlist/segment CDN hostnames do not
+ * thrash each other out of the cache. */
+#define PS4_TLS_SESSION_CACHE_SIZE 16
+
+typedef struct PS4SessionEntry {
+    char *host;
+    mbedtls_ssl_session *session;
+    uint32_t last_used;
+} PS4SessionEntry;
+
+typedef struct PS4CaEntry {
+    mbedtls_x509_crt certs;        /* parsed CA chain, owned here */
+    int refs;                      /* cache slot + live TLS contexts */
+} PS4CaEntry;
+
+static pthread_mutex_t ps4_tls_cache_lock = PTHREAD_MUTEX_INITIALIZER;
+static PS4SessionEntry ps4_tls_sessions[PS4_TLS_SESSION_CACHE_SIZE];
+static uint32_t ps4_tls_session_clock;
+static PS4CaEntry *ps4_tls_cache_ca;
+static char *ps4_tls_cache_ca_file;
+
+static void ps4_tls_drop_session_cache(const char *host)
+{
+    pthread_mutex_lock(&ps4_tls_cache_lock);
+    for (int i = 0; i < PS4_TLS_SESSION_CACHE_SIZE; i++) {
+        if (ps4_tls_sessions[i].host && (!host || !strcmp(ps4_tls_sessions[i].host, host))) {
+            av_free(ps4_tls_sessions[i].host);
+            ps4_tls_sessions[i].host = NULL;
+            if (ps4_tls_sessions[i].session) {
+                mbedtls_ssl_session_free(ps4_tls_sessions[i].session);
+                av_free(ps4_tls_sessions[i].session);
+                ps4_tls_sessions[i].session = NULL;
+            }
+            ps4_tls_sessions[i].last_used = 0;
+            if (host)
+                break;
+        }
+    }
+    pthread_mutex_unlock(&ps4_tls_cache_lock);
+}
+
+/* Release this context's reference to the cached CA chain.  The
+ * cache slot holds its own reference, so a cached chain is only
+ * freed here once it has been retired from the cache. */
+static void ps4_tls_release_ca(TLSContext *tls_ctx)
+{
+    PS4CaEntry *doomed = NULL;
+
+    pthread_mutex_lock(&ps4_tls_cache_lock);
+    if (tls_ctx->ps4_ca_entry) {
+        if (--tls_ctx->ps4_ca_entry->refs == 0)
+            doomed = tls_ctx->ps4_ca_entry;
+        tls_ctx->ps4_ca_entry = NULL;
+    }
+    pthread_mutex_unlock(&ps4_tls_cache_lock);
+
+    if (doomed) {
+        mbedtls_x509_crt_free(&doomed->certs);
+        av_free(doomed);
+    }
+}
