// views (minimal): std::views::filter and std::views::keys
namespace views {
namespace detail {

// Forward iterator that skips the elements rejected by the predicate.
template<class BaseIter, class Pred>
class filter_iterator
{
public:
  using iterator_category = std::forward_iterator_tag;
  using value_type = typename std::iterator_traits<BaseIter>::value_type;
  using difference_type = typename std::iterator_traits<BaseIter>::difference_type;
  using pointer = typename std::iterator_traits<BaseIter>::pointer;
  using reference = typename std::iterator_traits<BaseIter>::reference;

  filter_iterator() = default;
  filter_iterator(BaseIter it, BaseIter end, Pred pred)
    : m_it(std::move(it)), m_end(std::move(end)), m_pred(std::move(pred))
  {
    SkipRejected();
  }

  reference operator*() const { return *m_it; }
  pointer operator->() const { return &(*m_it); }

  filter_iterator& operator++()
  {
    ++m_it;
    SkipRejected();
    return *this;
  }

  filter_iterator operator++(int)
  {
    filter_iterator tmp(*this);
    ++(*this);
    return tmp;
  }

  bool operator==(const filter_iterator& other) const { return m_it == other.m_it; }
  bool operator!=(const filter_iterator& other) const { return m_it != other.m_it; }

private:
  void SkipRejected()
  {
    while (m_it != m_end && !m_pred(*m_it))
      ++m_it;
  }

  BaseIter m_it{};
  BaseIter m_end{};
  Pred m_pred{};
};

template<class R, class Pred>
class filter_view
{
public:
  using BaseIter = decltype(std::begin(std::declval<const R&>()));

  filter_view() = default;
  constexpr filter_view(R base, Pred pred) : m_base(std::move(base)), m_pred(std::move(pred)) {}

  constexpr auto begin() const
  {
    return filter_iterator<BaseIter, Pred>(std::begin(m_base), std::end(m_base), m_pred);
  }
  constexpr auto end() const
  {
    return filter_iterator<BaseIter, Pred>(std::end(m_base), std::end(m_base), m_pred);
  }

private:
  R m_base{};
  Pred m_pred{};
};

template<class R>
class keys_view
{
public:
  using BaseIter = decltype(std::begin(std::declval<const R&>()));

  class iterator
  {
  public:
    using iterator_category = std::forward_iterator_tag;
    using value_type = typename std::iterator_traits<BaseIter>::value_type;
    using difference_type = typename std::iterator_traits<BaseIter>::difference_type;
    using pointer = typename std::iterator_traits<BaseIter>::pointer;
    using reference = decltype(std::declval<BaseIter>()->first);

    iterator() = default;
    explicit iterator(BaseIter it) : m_it(std::move(it)) {}

    reference operator*() const { return m_it->first; }
    pointer operator->() const { return &m_it->first; }

    iterator& operator++()
    {
      ++m_it;
      return *this;
    }
    iterator operator++(int)
    {
      iterator tmp(*this);
      ++(*this);
      return tmp;
    }

    bool operator==(const iterator& other) const { return m_it == other.m_it; }
    bool operator!=(const iterator& other) const { return m_it != other.m_it; }

  private:
    BaseIter m_it{};
  };

  keys_view() = default;
  constexpr explicit keys_view(R base) : m_base(std::move(base)) {}

  constexpr auto begin() const { return iterator(std::begin(m_base)); }
  constexpr auto end() const { return iterator(std::end(m_base)); }

private:
  R m_base{};
};

template<class Pred>
struct filter_closure
{
  Pred pred;

  template<class R>
  constexpr auto operator()(R&& r) const
  {
    return filter_view<std::decay_t<R>, Pred>(std::forward<R>(r), pred);
  }
};

struct keys_closure
{
  template<class R2>
  constexpr auto operator()(R2&& r) const
  {
    return keys_view<std::decay_t<R2>>(std::forward<R2>(r));
  }
};

template<class R, class Pred>
constexpr auto operator|(R&& r, const filter_closure<Pred>& closure)
{
  return closure(std::forward<R>(r));
}

} // namespace detail

struct filter_fn
{
  template<class Pred>
  constexpr auto operator()(Pred pred) const
  {
    return detail::filter_closure<Pred>{std::move(pred)};
  }
};

struct keys_fn
{
  template<class R>
  constexpr auto operator()(R&& r) const
  {
    return detail::keys_closure{}(std::forward<R>(r));
  }
};

inline constexpr filter_fn filter{};
inline constexpr keys_fn keys{};

template<class R>
constexpr auto operator|(R&& r, const keys_fn& adaptor)
{
  return adaptor(std::forward<R>(r));
}

