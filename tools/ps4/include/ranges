// reverse
template<class R>
constexpr void reverse(R&& r) { std::reverse(std::begin(r), std::end(r)); }

// rotate
template<class R, class I>
constexpr auto rotate(R&& r, I middle) {
  return std::rotate(std::begin(r), middle, std::end(r));
}

// fill
template<class R, class T>
constexpr void fill(R&& r, const T& value) { std::fill(std::begin(r), std::end(r), value); }

// replace
template<class R, class T>
constexpr void replace(R&& r, const T& oldv, const T& newv) { std::replace(std::begin(r), std::end(r), oldv, newv); }

// set_difference
template<class R1, class R2, class O, class Comp = less, class Proj1 = identity, class Proj2 = identity>
